<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MockTeacher</RootNamespace>
    <!-- [LibraryImport] source-gen (InputTest P/Invokes libNtyCapture) emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared.Wire for the protocol; the Sandbox project for WireClient, so the
         selftest mode can drive the REAL client transport against this mock server
         in-process (deterministic, no Windows box needed). -->
    <ProjectReference Include="..\..\src\ClassroomCtrl.Shared.Wire\ClassroomCtrl.Shared.Wire.csproj" />
    <ProjectReference Include="..\..\src\ClassroomCtrl.Avalonia.Sandbox\ClassroomCtrl.Avalonia.Sandbox.csproj" />
  </ItemGroup>
</Project>
