<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HeadlessCapture</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- References the Sandbox so its App resources + views/VMs are available.
         "Project-agnostic" has a hard limit: the tool must reference the assembly
         that holds the views (no dynamic assembly loading). -->
    <ProjectReference Include="..\..\src\ClassroomCtrl.Avalonia.Sandbox\ClassroomCtrl.Avalonia.Sandbox.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
  </ItemGroup>
</Project>
