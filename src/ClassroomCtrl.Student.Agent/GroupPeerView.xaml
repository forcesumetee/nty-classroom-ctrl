<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Student.Agent.GroupPeerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Presenter"
        Width="1024" Height="640"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               RenderOptions.BitmapScalingMode="HighQuality"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"/>

        <Border VerticalAlignment="Top" Background="#CC10B981" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="HeaderText"
                           Text="📺  Group Presenter"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="StatsText"
                           Foreground="#D1FAE5" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="WaitingText"
                   Text="Waiting for first frame..."
                   Foreground="#9CA3AF"
                   FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
