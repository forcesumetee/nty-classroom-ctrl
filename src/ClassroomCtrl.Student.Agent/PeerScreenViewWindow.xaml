<Window x:Class="ClassroomCtrl.Student.Agent.PeerScreenViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peer Demonstration"
        WindowStyle="None"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               RenderOptions.BitmapScalingMode="HighQuality"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"/>

        <Border VerticalAlignment="Top" Background="#CC7C3AED" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="HeaderText"
                           Text="🎤  Peer Demonstration"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="StatsText"
                           Foreground="#E9D5FF" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="WaitingText"
                   Text="Waiting for first frame..."
                   FontFamily="Segoe UI"
                   Foreground="{DynamicResource Text.Secondary}"
                   FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
