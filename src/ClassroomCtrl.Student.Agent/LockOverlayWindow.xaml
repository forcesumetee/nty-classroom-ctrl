<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Student.Agent.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black">
    <Grid>
        <!-- Layer 1: Branded wallpaper or solid brand color -->
        <Rectangle Fill="{DynamicResource BrandWallpaperBrush}"/>

        <!-- Layer 2: Radial dark gradient for legibility -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                     RadiusX="0.7" RadiusY="0.9">
                    <GradientStop Color="#80000000" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 3: Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Lock icon with pulse rings -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,40,0,0">
                <Ellipse x:Name="PulseRing1" Width="220" Height="220"
                         Stroke="White" StrokeThickness="2" Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale1" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="PulseRing2" Width="180" Height="180"
                         Stroke="White" StrokeThickness="2" Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale2" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Border Width="140" Height="140" CornerRadius="70"
                        Background="{DynamicResource BrandPrimaryBrush}"
                        BorderBrush="White" BorderThickness="4">
                    <TextBlock Text="🔒" FontSize="68"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </Border>
            </Grid>

            <!-- Time + Date + Message -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,40,0,0">
                <TextBlock x:Name="TimeText" FontSize="64" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DateText" FontSize="20" Foreground="#E5E7EB"
                           HorizontalAlignment="Center" Margin="0,8,0,40"/>

                <TextBlock Text="{DynamicResource Lbl_LockedByTeacher}"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="CustomMessageText"
                           Text="{DynamicResource Lbl_PleaseWait}"
                           FontSize="18" Foreground="#D1D5DB"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center"/>
                <TextBlock Text="(Dev: Ctrl+Shift+Alt+U)"
                           FontSize="11" Foreground="#6B7280" Margin="0,40,0,0"
                           HorizontalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>

            <!-- Branding bottom-center — collapsed for Phase 5B.
                 Bindings kept so a future phase can re-enable (logo-only or subtitle). -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center"
                        Orientation="Horizontal" Margin="0,0,0,20"
                        Visibility="Collapsed">
                <Image Source="{DynamicResource BrandLogoSource}"
                       Width="32" Height="32" Margin="0,0,12,0"/>
                <TextBlock Text="{DynamicResource BrandOrgName}"
                           FontFamily="Segoe UI" FontSize="16"
                           Foreground="{DynamicResource Text.Secondary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Copyright -->
            <TextBlock Grid.Row="4" Text="© NTY MULTIMEDIA CO.,LTD"
                       Style="{DynamicResource Text.Footer}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,12"/>
        </Grid>
    </Grid>
</Window>
