<!-- Phase 10.13 — window chrome icon switched from logo.png (1.4 MB) to the
     multi-resolution classroom_icon.ico added in commit 2e321bb. -->
<Window Icon="/Assets/classroom_icon.ico" x:Class="ClassroomCtrl.Student.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_AgentTitle}"
        Height="540" Width="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="False"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        Background="{DynamicResource Surface.Background}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <!-- Phase 8 Section A — restructured to match Teacher's Phase 4-7 dialog
         pattern: pinned header (icon bubble + title + status + Language) /
         body (action grid + Surface.Card chat list) / pinned footer (chat
         input + Send).  The Settings button was cut at customer request —
         Section D in Phase 8 also removes the matching Teacher Admin Password
         Settings dialog so neither half has a path to wipe the configured IP. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🎓" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Phase 9 Section B — header right cluster: Bell (with unread
                     badge) + Language.  DockPanel.Dock="Right" stacks them
                     right-to-left in source order, so Language ends up at the
                     far right and Bell sits to its left. -->
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Btn_Language}"
                        Click="Language_Click"
                        Style="{DynamicResource Button.Secondary}"
                        VerticalAlignment="Center"/>
                <!-- Phase 9.1 Section B — Bell with Popup of system notifications.
                     Click the button → toggles NotificationsPopup, which lists
                     every system event from this session (teacher viewing,
                     mic mute, hand raised, etc.) routed via AddSystemNotification.
                     The body ChatList no longer carries system messages — only
                     real chat from teacher / DM / room peers. -->
                <Grid DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="BellButton"
                            Click="Bell_Click"
                            Style="{DynamicResource Button.Icon}"
                            ToolTip="{DynamicResource Tooltip_Notifications}"
                            Width="36" Height="36"
                            Padding="0">
                        <TextBlock Text="🔔" FontSize="16"/>
                    </Button>
                    <Border x:Name="BellBadge"
                            Visibility="Collapsed"
                            Background="{DynamicResource Accent.Danger}"
                            CornerRadius="999"
                            MinWidth="16" Height="16"
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,2,2,0"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="BellBadgeText"
                                   Foreground="White"
                                   FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Popup x:Name="NotificationsPopup"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=BellButton}"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8"
                                Margin="0,4,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270"
                                                  ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <Grid Width="320" MaxHeight="400">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="14,10"
                                        BorderBrush="{DynamicResource Border.Soft}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="{DynamicResource Hdr_Notifications}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Border>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <TextBlock x:Name="NoNotificationsText"
                                                   Text="—"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   FontSize="12"
                                                   Padding="14,16"
                                                   HorizontalAlignment="Center"/>
                                        <ItemsControl x:Name="NotificationsItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="14,10"
                                                            BorderBrush="{DynamicResource Border.Soft}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Icon}"
                                                                       FontSize="14"
                                                                       Margin="0,1,10,0"
                                                                       VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Message}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding TimeAgoText}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource Text.Muted}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_ClassroomConnected}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock x:Name="StatusText"
                               Text="{DynamicResource Lbl_MonitoringActive}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Action buttons — Phase 9.1 Section D: Voice button removed.
             Customer feedback: Zoom-style is just a single mic toggle; the
             distinction between "broadcast mic to teacher" (was MicButton)
             and "join breakout room voice channel" (was VoiceButton) was
             confusing.  Mic always-on-when-unmuted suffices for both
             scenarios — peers in the same breakout room hear the mic stream
             through the same broadcaster pipeline. -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Btn_RaiseHand}"
                    Style="{DynamicResource Button.Primary}"
                    Margin="0,0,4,0" Click="RaiseHand_Click"/>
            <Button x:Name="MicButton" Grid.Column="1"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="4,0,0,0" Click="ToggleMic_Click"/>
        </Grid>

        <!-- Phase 18 (v1.1) — Rejoin Conference banner.  Sits between the
             action-button row and the chat list; visibility-managed
             procedurally by UpdateRejoinBannerVisibility() so MainWindow
             stays DataContext-free (mirrors the BellBadge x:Name pattern).
             Initial Visibility=Collapsed; ConferenceStart cache + _confWindow
             nullification by Closed handler flips it visible.  Banner is
             nested inside the chat-list Border row using a vertical-stack
             host so it doesn't displace any other Grid.Row mappings — keeps
             every existing dispatch handler's coordinate assumptions intact. -->
        <Grid Grid.Row="2" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="RejoinBanner" Grid.Row="0"
                    Margin="16,4,16,8" Padding="12,10"
                    CornerRadius="8"
                    Background="{DynamicResource Accent.PrimarySubtle}"
                    BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="💼" FontSize="16" Margin="0,0,6,0"
                                   FontFamily="Segoe UI Emoji"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="RejoinBannerTitle"
                                   Text="{DynamicResource Rejoin_BannerTitle}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource Text.Primary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="RejoinHostText"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,0,0,8"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="RejoinButton"
                            Content="{DynamicResource Rejoin_ButtonText}"
                            Click="RejoinConference_Click"
                            Style="{DynamicResource Button.Primary}"
                            HorizontalAlignment="Stretch"
                            Padding="12,6"/>
                </StackPanel>
            </Border>

        <!-- Chat / system messages — wrapped in Surface.Card per Phase 4-7 design -->
        <Border Grid.Row="1" Margin="16,4"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="8">
            <ListBox x:Name="ChatList"
                     Style="{DynamicResource ListBox.Default}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="10,6"
                                Background="{DynamicResource Surface.Elevated}"
                                CornerRadius="6">
                            <TextBlock Text="{Binding}"
                                       Style="{DynamicResource Text.Body}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        </Grid>

        <!-- Footer — chat input + Send -->
        <Border Grid.Row="3" Padding="16,10"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput"
                         Style="{DynamicResource TextBox.Default}"
                         KeyDown="ChatInput_KeyDown"/>
                <Button Grid.Column="1" Content="{DynamicResource Btn_Send}"
                        Style="{DynamicResource Button.Primary}"
                        Click="SendChat_Click" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Copyright corner -->
        <TextBlock Grid.Row="4" Text="© NTY MULTIMEDIA CO.,LTD"
                   FontSize="10"
                   Foreground="{DynamicResource Text.Muted}"
                   HorizontalAlignment="Center" Margin="0,4,0,8"/>
    </Grid>
</Window>
