<Application x:Class="ClassroomCtrl.Student.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                                             BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Phase 4 — Premium Dark Design System (shared with Teacher).
                     Phase 8 — Dark is the only shipping theme; Colors.Light.xaml retained as
                               back-compat baseline for legacy branding.json. ApplyTheme at
                               startup swaps to Colors.Dark.xaml based on BrandingConfig.ThemeMode.
                     Order matters: Colors first (others reference its brushes). -->
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/Spacing.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/Effects.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/Buttons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/Inputs.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared;component/Themes/DataDisplay.xaml"/>
                <!-- Phase 22 — Conference Mode dark-theme design tokens.
                     Brushes / radii / typography consumed by every Conference
                     surface (Tile, Toolbar, Sidebar, ShareView, the Phase 21
                     sharing pill, the ConferenceGalleryWindow chrome).
                     Conf*-prefixed keys so they never collide with the
                     Classroom theme entries above. -->
                <ResourceDictionary Source="pack://application:,,,/ClassroomCtrl.Shared.Wpf;component/Themes/ConferenceDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
