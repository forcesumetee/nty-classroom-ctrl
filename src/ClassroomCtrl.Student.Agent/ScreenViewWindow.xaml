<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Student.Agent.ScreenViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teacher Screen"
        WindowStyle="None"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Main image. HighQuality scaling + LayoutRounding so 1920x1080 capture
             renders pixel-perfect on a matching monitor (no blurry sub-pixel sampling).
             Sits at the root of the Grid so it fills the entire window — header + close
             button below are overlays that don't displace it. -->
        <Image x:Name="ScreenImage" Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               RenderOptions.BitmapScalingMode="HighQuality"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"/>

        <!-- Phase 9.2: Screen Pen overlay (read-only, displays teacher's strokes) -->
        <InkCanvas x:Name="DrawingOverlay"
                   Background="Transparent"
                   IsHitTestVisible="False"
                   EditingMode="None"/>

        <!-- Header banner (overlay; doesn't displace the image) -->
        <Border VerticalAlignment="Top" Background="#CC1E3A8A" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="📡  Teacher is sharing screen"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="StatsText"
                           Foreground="#BFDBFE" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Close button (X) overlay top-right corner.
             Sits ABOVE the header banner because Grid renders later children on top. -->
        <Button x:Name="CloseButton" Click="CloseButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="42" Height="36" Margin="0,0,0,0"
                Style="{DynamicResource Button.Danger}"
                FontSize="18" FontWeight="Bold"
                Content="✕"
                ToolTip="Close (ESC)"/>

        <!-- "Waiting" placeholder when no frames yet -->
        <TextBlock x:Name="WaitingText"
                   Text="Waiting for first frame..."
                   FontFamily="Segoe UI"
                   Foreground="{DynamicResource Text.Secondary}"
                   FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Phase 9 Section A — bottom overlay control bar.
             ScreenViewWindow is fullscreen+Topmost (so the teacher's broadcast
             actually fills the student screen), which means the MainWindow chat
             input and mic button sit BEHIND it and are unreachable.  This bar
             gives the student the two essentials — mic toggle + chat — without
             closing the broadcast view.  Semi-transparent so it overlays the
             video without blocking the bottom strip too aggressively. -->
        <Border VerticalAlignment="Bottom"
                Background="#D91E3A8A"
                Padding="16,10">
            <DockPanel>
                <Button x:Name="OverlayMicButton" DockPanel.Dock="Left"
                        Content="🎤"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="#80FFFFFF"
                        BorderThickness="1"
                        FontSize="16"
                        Padding="10,6"
                        MinWidth="48"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        ToolTip="Toggle microphone"
                        Click="OverlayMic_Click"/>
                <Button x:Name="OverlaySendButton" DockPanel.Dock="Right"
                        Content="📤"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14" FontWeight="Bold"
                        Padding="14,6"
                        MinWidth="48"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        Click="OverlaySend_Click"/>
                <TextBox x:Name="OverlayChatInput"
                         Background="#22000000"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#80FFFFFF"
                         BorderThickness="1"
                         FontSize="13"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         KeyDown="OverlayChatInput_KeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>