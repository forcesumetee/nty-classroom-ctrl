<Window x:Class="ClassroomCtrl.Student.Agent.Setup.AdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Lbl_AdminPasswordRequired}"
        Height="240" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Run.Text does NOT honour DynamicResource (Run is a Freezable that doesn't
             join the resource lookup chain) so the markup leaked through as literal text.
             Split into two TextBlocks: emoji literal + bind on the localised title. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="🔒  " Style="{DynamicResource Text.H2}"/>
            <TextBlock Text="{DynamicResource Lbl_AdminPasswordRequired}"
                       Style="{DynamicResource Text.H2}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource Lbl_AdminPasswordHint}"
                   Style="{DynamicResource Text.Caption}"
                   Margin="0,0,0,12"/>

        <PasswordBox Grid.Row="2" x:Name="PasswordBox"
                     Style="{DynamicResource PasswordBox.Default}"
                     FontSize="16"/>

        <TextBlock Grid.Row="3" x:Name="ErrorText"
                   Style="{DynamicResource Text.Body}"
                   Foreground="{DynamicResource Accent.Danger}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource Btn_UnlockAdvanced}"
                    Style="{DynamicResource Button.Primary}"
                    Click="Unlock_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
