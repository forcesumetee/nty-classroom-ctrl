<Window x:Class="ClassroomCtrl.Student.Agent.Setup.TeacherIPDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dlg_ClassroomSetup}"
        Height="380" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 8 Section C — restructured to match Teacher's Phase 4-7 dialog
         pattern: pinned header (icon bubble + title + hint) / body (IP input
         + inline validation message) / pinned footer (Cancel + Save).  No
         MaterialDesign chrome — uses the shared Light theme tokens directly. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🔌" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Dlg_ClassroomSetup}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Dlg_EnterTeacherIP}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <TextBlock Text="{DynamicResource Lbl_TeacherIP}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="IPTextBox"
                     Style="{DynamicResource TextBox.Default}"
                     FontSize="14"
                     Padding="10,8"/>
            <TextBlock x:Name="HintText"
                       Text="{DynamicResource Hint_IPExample}"
                       FontSize="11"
                       Foreground="{DynamicResource Text.Muted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Accent.Danger}"
                       FontSize="12"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Save}"
                        Click="Save_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
