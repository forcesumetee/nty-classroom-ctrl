<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Student.Agent.HostFloatingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Host Toolbar"
        Width="280" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDragHandle">
    <Border CornerRadius="{DynamicResource CornerRadius.LG}"
            Padding="12"
            Background="{DynamicResource Surface.Elevated}"
            BorderBrush="{DynamicResource Accent.Warning}" BorderThickness="2"
            Effect="{DynamicResource DropShadow.Floating}">
        <StackPanel>
            <TextBlock Text="👑 HOST"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource Accent.Warning}"
                       FontWeight="Bold" FontSize="12"
                       Margin="0,0,0,4" HorizontalAlignment="Center"/>
            <TextBlock x:Name="RoomNameText"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource Text.Primary}"
                       FontSize="11" Margin="0,0,0,8"
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>

            <Button Content="{DynamicResource Btn_HostMute}"
                    Click="Mute_Click"
                    Style="{DynamicResource Button.Danger}"
                    Margin="0,2"
                    HorizontalContentAlignment="Left"/>
            <Button Content="{DynamicResource Btn_HostShareScreen}"
                    Click="Share_Click"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="0,2"
                    HorizontalContentAlignment="Left"/>
            <Button Content="{DynamicResource Btn_HostSendToMain}"
                    Click="SendToMain_Click"
                    Style="{DynamicResource Button.Primary}"
                    Margin="0,2"
                    HorizontalContentAlignment="Left"/>
        </StackPanel>
    </Border>
</Window>
