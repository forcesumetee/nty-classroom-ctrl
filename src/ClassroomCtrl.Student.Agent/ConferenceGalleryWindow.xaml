<Window Icon="/Assets/classroom_icon.ico" x:Class="ClassroomCtrl.Student.Agent.ConferenceGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Conf_LiveTitle}"
        Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 15-C — student-side gallery.  Tier 1 only broadcasts the
         teacher's cam, so the student gallery is a single tile (the
         teacher).  Renders directly as a 16:9 Image instead of pulling in
         the teacher's full gallery infrastructure (which Student.Agent has
         no project reference to).  Phase 15-F or a dedicated Shared.Wpf
         library can lift this to the multi-tile gallery later. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header bar with host line.  Replaces the centered placeholder
             that lived here in 15-B. -->
        <Border Grid.Row="0" Padding="20,10"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="📹" FontSize="20" Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="HostLineText"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <!-- Single tile: teacher cam frame.  Image.Source is updated by
             UpdateFrame on every CameraFrame dispatch.  When no frame yet,
             shows a placeholder with the host name + cam-off emoji. -->
        <Grid Grid.Row="1" Margin="24">
            <Border CornerRadius="8" Background="#111827"
                    BorderThickness="2" BorderBrush="Transparent">
                <Grid>
                    <Image x:Name="TeacherFrameImage" Stretch="Uniform"
                           Visibility="Collapsed"/>
                    <!-- Phase 15-E step 4 — incoming reaction emoji overlay.
                         Surfaced by ShowReaction(); auto-clears after 3 s
                         via a DispatcherTimer.  Hit-test disabled so the
                         underlying image (and a future click-through path)
                         still receives input. -->
                    <TextBlock x:Name="ReactionOverlay"
                               FontSize="120"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Text=""/>
                    <StackPanel x:Name="WaitingPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎥" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock x:Name="WaitingLineText"
                                   FontSize="16"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="520"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Bottom bar with single Leave action.  15-D replaces with full
             Meet-style ConferenceToolbar (mic / cam / share / chat / hand /
             more / leave). -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource Button.Danger}"
                        Click="Leave_Click"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" FontSize="13" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conf_Leave}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
