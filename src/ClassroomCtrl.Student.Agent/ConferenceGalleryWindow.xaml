<Window Icon="/Assets/classroom_icon.ico" x:Class="ClassroomCtrl.Student.Agent.ConferenceGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters;assembly=ClassroomCtrl.Shared.Wpf"
        xmlns:confctrls="clr-namespace:ClassroomCtrl.Shared.Wpf.Conference;assembly=ClassroomCtrl.Shared.Wpf"
        Title="{DynamicResource Conf_LiveTitle}"
        Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 16-B step 7 — student-side conference shell rewrite.  Hosts the
         same Shared.Wpf ConferenceGalleryView + ConferenceToolbar +
         ConferenceSidebar as the teacher (Conference parity).
         DataContext = StudentConferenceShellViewModel.  Tier 1: the gallery
         starts with one teacher tile that gets cam frames via UpdateFrame;
         Phase 16-C peer cam adds more tiles as students join. -->
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar with host line.  Mirrors the teacher's ConferenceView
             header chip pattern (Phase 15-B step 7). -->
        <Border Grid.Row="0" Padding="20,10"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="📹" FontSize="20" Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="HostLineText"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Gallery surface + sidebar overlay.  Mirrors the teacher's
             ConferenceView Row 0 inner Grid layout exactly (gallery
             beneath, sidebar floats right). -->
        <Grid Grid.Row="1">
            <confctrls:ConferenceGalleryView DataContext="{Binding ConferenceGallery}"/>
            <confctrls:ConferenceSidebar HorizontalAlignment="Right"
                                         Width="340"
                                         Visibility="{Binding IsConferenceSidebarVisible,
                                                      Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Bottom Meet-style toolbar.  Same control as teacher; for the
             student it's wired with stubs in StudentConferenceShellViewModel
             (Phase 16-D adds the full IConferenceShellViewModel + role
             gating that hides admin actions on student).  End/Leave button
             closes the window via RequestClose event. -->
        <confctrls:ConferenceToolbar Grid.Row="2"/>
    </Grid>
</Window>
