<Window Icon="/Assets/classroom_icon.ico" x:Class="ClassroomCtrl.Student.Agent.ConferenceGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Conf_LiveTitle}"
        Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 15-B (MVP) — student-side conference shell.  Skeleton only:
         shows session host + "Leave" button.  Phase 15-C lights up the
         gallery; Phase 15-D adds the Meet-style bottom toolbar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="520">
            <TextBlock Text="📹" FontSize="56"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource Conf_LiveTitle}"
                       Style="{DynamicResource Text.H1}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="HostLineText"
                       Style="{DynamicResource Text.Body}"
                       Foreground="{DynamicResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock Text="{DynamicResource Conf_LiveHint}"
                       Style="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Text.Muted}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,16,0,0"/>
        </StackPanel>
        <!-- Bottom bar with single Leave action.  15-D replaces with full
             Meet-style ConferenceToolbar (mic / cam / share / chat / hand /
             more / leave). -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource Button.Danger}"
                        Click="Leave_Click"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" FontSize="13" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conf_Leave}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
