<Window Icon="/Assets/classroom_icon.ico" x:Class="ClassroomCtrl.Student.Agent.ConferenceGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters;assembly=ClassroomCtrl.Shared.Wpf"
        xmlns:confctrls="clr-namespace:ClassroomCtrl.Shared.Wpf.Conference;assembly=ClassroomCtrl.Shared.Wpf"
        Title="{DynamicResource Conf_LiveTitle}"
        Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource ConfWindowBgBrush}"
        TextElement.Foreground="{StaticResource ConfTextPrimaryBrush}"
        FontFamily="{StaticResource ConfFontFamily}">
    <!-- Phase 22 (v1.1) — dark Zoom-style chrome.
         Window background flipped to ConfWindowBgBrush so the gallery
         surface reads as a single dark canvas instead of the
         Surface.Background classroom token (which the Phase 8 light theme
         maps to near-white).  In-window title bar (Row 0) uses
         ConfTitleBarBgBrush; the Phase 21 "You are sharing" pill on the
         right becomes a subtle pulse-dot instead of the bright green
         CTA so it doesn't compete with the active-tile yellow ring on
         the gallery surface beneath.  OS chrome (window border + min /
         max / close) is preserved so a student who needs to escape the
         window doesn't lose the affordance — the dark in-window title
         bar layers underneath it. -->
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar — dark Zoom-style.  Host name on the left,
             optional sharing pulse-dot indicator on the right.
             ConfTitleBarBgBrush is slightly darker than the window
             background so the gallery tiles below have a clean visual
             separator without needing a hairline border. -->
        <Border Grid.Row="0" Padding="20,10"
                Background="{StaticResource ConfTitleBarBgBrush}">
            <DockPanel>
                <TextBlock Text="📹" FontSize="20" Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ConfTextPrimaryBrush}"/>

                <!-- Sharing indicator + quick Stop affordance.
                     Phase 22 step 9 — added an inline Stop button next
                     to the pulse-dot so the student can halt their share
                     without hunting the toolbar.  The button reuses the
                     existing ShareScreenCommand (which the shell VM's
                     state machine handles via ToggleShareRequestAsync —
                     Sharing → Approved + Broadcaster.Stop()).  Same
                     locale key (Share_StopShareButton) the toolbar
                     button uses so EN+TH stay in sync.
                     Pulse storyboard: Opacity 1 → 0.4 every 0.75 s
                     autoreverse — calm, not aggressive. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSharingActive, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource ConfAccentRedBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.4"
                                                         Duration="0:0:0.75" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{DynamicResource Share_YouAreSharing}"
                               VerticalAlignment="Center"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                    <Button Content="{DynamicResource Share_StopShareButton}"
                            Command="{Binding ShareScreenCommand}"
                            Margin="12,0,0,0"
                            Padding="10,3"
                            Background="{StaticResource ConfAccentRedBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="11" FontWeight="Medium"
                            Cursor="Hand"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Host line.  Foreground swapped to ConfTextPrimaryBrush
                     so light text reads on the dark title bar without
                     relying on the Phase 8 Light theme's Text.Primary
                     (which is near-black). -->
                <TextBlock x:Name="HostLineText"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ConfTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Gallery surface + sidebar overlay.  Background is set on the
             container so the gallery cell reads as the dark canvas (the
             ConferenceGalleryView itself is mostly transparent panels). -->
        <Grid Grid.Row="1" Background="{StaticResource ConfWindowBgBrush}">
            <confctrls:ConferenceGalleryView DataContext="{Binding ConferenceGallery}"/>
            <confctrls:ConferenceSidebar HorizontalAlignment="Right"
                                         Width="340"
                                         Visibility="{Binding IsConferenceSidebarVisible,
                                                      Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Bottom Meet-style toolbar.  The toolbar's own Border carries
             the ConfToolbarBgBrush pill; this row stays transparent so
             the pill floats over the gallery edge with a clean margin. -->
        <confctrls:ConferenceToolbar Grid.Row="2"/>
    </Grid>
</Window>
