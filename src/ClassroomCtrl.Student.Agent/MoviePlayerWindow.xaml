<Window x:Class="ClassroomCtrl.Student.Agent.MoviePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Net Movie"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black">
    <Grid>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Stretch="Uniform" ScrubbingEnabled="True"/>
        <TextBlock x:Name="StatusText" Foreground="#94A3B8" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
