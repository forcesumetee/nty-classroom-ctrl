<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Student.Agent.Dialogs.LanguageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_Language}"
        Height="420" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Btn_Language}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" x:Name="LanguageList"
                 SelectionMode="Single"
                 BorderThickness="1" BorderBrush="#DDD"
                 FontSize="14"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Btn_Cancel}" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="90" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>