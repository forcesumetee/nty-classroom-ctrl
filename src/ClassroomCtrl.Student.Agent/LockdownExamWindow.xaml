<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Student.Agent.LockdownExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam"
        WindowState="Maximized" WindowStyle="None" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid>
    <!-- Phase 13f: Pre-test student-info form. Visible by default, hides when Start clicked.
         Sits in its own Grid layer so the existing exam DockPanel underneath can stay
         structurally identical (we just toggle Visibility on the two layers). -->
    <DockPanel x:Name="ExamShell" Margin="0" Visibility="Collapsed">
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝 " FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="QuizTitleText" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏱️ " FontSize="20" Foreground="#F59E0B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerText" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer bar -->
        <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="PrevBtn" Click="Prev_Click" Padding="20,8"
                        Content="{DynamicResource Btn_Previous}" Background="#475569" Foreground="White" BorderThickness="0"/>
                <TextBlock Grid.Column="1" x:Name="ProgressText" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="NextBtn" Click="Next_Click" Padding="20,8" Margin="0,0,8,0"
                            Content="{DynamicResource Btn_Next}" Background="#475569" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="SubmitBtn" Click="Submit_Click" Padding="20,8"
                            Content="{DynamicResource Btn_Submit}" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Margin="40,20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="QuestionPanel">
                <TextBlock x:Name="QuestionNumberText" Foreground="#94A3B8" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock x:Name="QuestionText" Foreground="White" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <ItemsControl x:Name="ChoicesList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,4" CornerRadius="6"
                                    Background="#1E293B" BorderBrush="#475569" BorderThickness="1">
                                <RadioButton GroupName="QuestionChoices" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Foreground="White" FontSize="16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="ShortAnswerBox" Visibility="Collapsed"
                         Background="#1E293B" Foreground="White" BorderBrush="#475569" BorderThickness="1"
                         Padding="12" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Pre-test student info page (Phase 13f) -->
    <Grid x:Name="StudentInfoPage" Background="#0F172A">
        <Border Background="#1E293B" CornerRadius="12" Padding="40,30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="460" MaxWidth="560">
            <StackPanel>
                <TextBlock Text="📝" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Lbl_StudentInfo}"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock x:Name="InfoQuizSubtitle" Foreground="#F59E0B" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="SemiBold"/>

                <TextBlock Text="{DynamicResource Lbl_FillBeforeExam}"
                           Foreground="#94A3B8" Margin="0,0,0,18"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                <TextBlock Text="{DynamicResource Lbl_FullName}" Foreground="White" Margin="0,4,0,4"/>
                <TextBox x:Name="FullNameInput"
                         Padding="10,8" FontSize="14"
                         Background="White" Foreground="Black"
                         BorderBrush="#94A3B8" BorderThickness="1"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Lbl_ClassName}" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClassInput"
                                 Padding="10,8" FontSize="14"
                                 Background="White" Foreground="Black"
                                 BorderBrush="#94A3B8" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Lbl_StudentNumber}" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="StudentNumberInput"
                                 Padding="10,8" FontSize="14"
                                 Background="White" Foreground="Black"
                                 BorderBrush="#94A3B8" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="InfoErrorText"
                           Foreground="#F87171" Margin="0,12,0,0"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>

                <Button x:Name="StartExamButton"
                        Content="{DynamicResource Btn_StartExam}"
                        Click="StartExamButton_Click"
                        Style="{DynamicResource Button.Success}"
                        Foreground="{DynamicResource Text.OnAccent}"
                        FontSize="16" FontWeight="Bold"
                        Margin="0,24,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
