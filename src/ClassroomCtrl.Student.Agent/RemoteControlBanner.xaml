<Window x:Class="ClassroomCtrl.Student.Agent.RemoteControlBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Control"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600" Height="50"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource Accent.Danger}" CornerRadius="0,0,8,8">
        <TextBlock Text="{DynamicResource Banner_RemoteActive}"
                   FontFamily="Segoe UI"
                   Foreground="{DynamicResource Text.OnAccent}"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
