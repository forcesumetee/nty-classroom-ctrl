<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClassroomCtrl.Student.Agent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness: Windows Forms requires the project property, not manifest tags (WFO0003). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Phase 10.13 — switched primary .ico to multi-resolution classroom_icon.ico
         (added in commit 2e321bb). The old logo.ico is kept on disk in case other code
         references it, but new shortcuts/window chrome use the new icon. -->
    <ApplicationIcon>Assets\classroom_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- Phase 10.13 — embed classroom_icon.ico as a WPF Resource so TrayIconManager
         can load it via pack:// URI (fixing the empty-box tray icon TODO). -->
    <Resource Include="Assets\classroom_icon.ico" />
    <None Include="Assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\classroom_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClassroomCtrl.Shared\ClassroomCtrl.Shared.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Networking\ClassroomCtrl.Networking.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Licensing\ClassroomCtrl.Licensing.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Exam.Shared\ClassroomCtrl.Exam.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.131" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
