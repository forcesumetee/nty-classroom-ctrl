<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ─────────── Spacing scale ─────────── -->
    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.SM">8</sys:Double>
    <sys:Double x:Key="Spacing.MD">16</sys:Double>
    <sys:Double x:Key="Spacing.LG">24</sys:Double>
    <sys:Double x:Key="Spacing.XL">32</sys:Double>

    <!-- ─────────── Corner radius scale ─────────── -->
    <CornerRadius x:Key="CornerRadius.SM">6</CornerRadius>
    <CornerRadius x:Key="CornerRadius.MD">8</CornerRadius>
    <CornerRadius x:Key="CornerRadius.LG">12</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Pill">999</CornerRadius>

    <!-- ─────────── Layout tokens (mockup) ─────────── -->
    <sys:Double x:Key="Layout.SidebarWidth">240</sys:Double>
    <sys:Double x:Key="Layout.RightRailWidth">320</sys:Double>
    <sys:Double x:Key="Layout.HeaderHeight">56</sys:Double>

</ResourceDictionary>
