<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="DropShadow.Card"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.3"
                      Color="#000000"/>

    <DropShadowEffect x:Key="DropShadow.Floating"
                      BlurRadius="30"
                      ShadowDepth="8"
                      Direction="270"
                      Opacity="0.4"
                      Color="#000000"/>

</ResourceDictionary>
