<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Phase UI-Rewrite (Phase 1) — dark theme refreshed to match Image-2 mockup.
         Legacy keys (Surface.Overlay, Surface.Border, Text.Tertiary) kept as aliases
         pointing at the new values so dialogs from Phases 6-13 continue to render. -->

    <!-- ─────────── Surface tier — Color tokens (for gradients) ─────────── -->
    <Color x:Key="Surface.Background.Color">#050B1B</Color>
    <Color x:Key="Surface.Elevated.Color">#0B1530</Color>
    <Color x:Key="Surface.Card.Color">#0E1733</Color>
    <Color x:Key="Surface.Hover.Color">#11193A</Color>

    <!-- ─────────── Surface tier — Brushes ─────────── -->
    <SolidColorBrush x:Key="Surface.Background" Color="{StaticResource Surface.Background.Color}"/>
    <SolidColorBrush x:Key="Surface.Elevated"   Color="{StaticResource Surface.Elevated.Color}"/>
    <SolidColorBrush x:Key="Surface.Card"       Color="{StaticResource Surface.Card.Color}"/>
    <SolidColorBrush x:Key="Surface.Hover"      Color="{StaticResource Surface.Hover.Color}"/>
    <!-- Legacy alias (Phase 6-13 dialogs / Inputs.xaml) — was a darker overlay; remap to Elevated. -->
    <SolidColorBrush x:Key="Surface.Overlay"    Color="{StaticResource Surface.Elevated.Color}"/>

    <!-- ─────────── Border tier ─────────── -->
    <Color x:Key="Border.Default.Color">#1E2A4F</Color>
    <Color x:Key="Border.Soft.Color">#131D3D</Color>
    <SolidColorBrush x:Key="Border.Default" Color="{StaticResource Border.Default.Color}"/>
    <SolidColorBrush x:Key="Border.Soft"    Color="{StaticResource Border.Soft.Color}"/>
    <!-- Legacy alias — Surface.Border was the original border key. -->
    <SolidColorBrush x:Key="Surface.Border"      Color="{StaticResource Border.Default.Color}"/>
    <SolidColorBrush x:Key="Surface.BorderFocus" Color="#3B82F6"/>

    <!-- ─────────── Accent tier (Primary/PrimaryHover/PrimarySubtle are runtime-overridden by BrandingService) ─────────── -->
    <SolidColorBrush x:Key="Accent.Primary"        Color="#3B82F6"/>
    <SolidColorBrush x:Key="Accent.PrimaryHover"   Color="#2563EB"/>
    <SolidColorBrush x:Key="Accent.PrimaryPressed" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Accent.PrimarySubtle"  Color="#1E3A8A"/>

    <!-- ─────────── Semantic tier ─────────── -->
    <SolidColorBrush x:Key="Accent.Success"      Color="#10B981"/>
    <SolidColorBrush x:Key="Accent.SuccessHover" Color="#059669"/>
    <SolidColorBrush x:Key="Accent.Warning"      Color="#F59E0B"/>
    <SolidColorBrush x:Key="Accent.WarningHover" Color="#D97706"/>
    <SolidColorBrush x:Key="Accent.Danger"       Color="#EF4444"/>
    <SolidColorBrush x:Key="Accent.DangerHover"  Color="#DC2626"/>
    <SolidColorBrush x:Key="Accent.Info"         Color="#3B82F6"/>

    <!-- ─────────── Text tier ─────────── -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#64748B"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#64748B"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.Disabled"  Color="#475569"/>

    <!-- ─────────── Status tier ─────────── -->
    <SolidColorBrush x:Key="Status.Online"    Color="#10B981"/>
    <SolidColorBrush x:Key="Status.Locked"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="Status.Offline"   Color="#64748B"/>
    <SolidColorBrush x:Key="Status.Recording" Color="#EF4444"/>

</ResourceDictionary>
