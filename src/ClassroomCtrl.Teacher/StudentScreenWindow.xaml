<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.StudentScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Panel"
        WindowStyle="SingleBorderWindow"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="True"
        Width="1024" Height="768"
        MinWidth="640" MinHeight="480"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <DockPanel LastChildFill="True">
        <!-- Header bar: stats + fullscreen toggle -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Elevated}" Padding="12,8">
            <DockPanel>
                <Button x:Name="FullscreenButton"
                        DockPanel.Dock="Right"
                        Click="ToggleFullscreen_Click"
                        Style="{DynamicResource Button.Secondary}"
                        ToolTip="F11 / ESC">
                    <TextBlock x:Name="FullscreenText" Text="🖥️ Fullscreen" FontSize="13"/>
                </Button>
                <TextBlock x:Name="StatsText"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Action buttons row (4 large buttons, equal width).
             Inline Background colors are flipped in code-behind to communicate state
             (e.g. red while recording / locked) so we keep them inline; Button.Primary
             gives the rounded chrome + proper text rendering. -->
        <Grid DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Elevated}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Phase 6.5 — Remote Control toggle -->
            <Button x:Name="RemoteButton" Grid.Column="0"
                    Click="Remote_Click"
                    Style="{DynamicResource Button.Primary}"
                    Background="#3B82F6"
                    Foreground="{DynamicResource Text.OnAccent}"
                    Padding="8,12" Margin="8,8,4,8"
                    MinHeight="44">
                <TextBlock x:Name="RemoteText" Text="🖱️ Remote Control"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.OnAccent}"
                           FontWeight="Bold" FontSize="14"/>
            </Button>

            <!-- Lock toggle -->
            <Button x:Name="LockButton" Grid.Column="1"
                    Click="Lock_Click"
                    Style="{DynamicResource Button.Primary}"
                    Background="#F59E0B"
                    Foreground="{DynamicResource Text.OnAccent}"
                    Padding="8,12" Margin="4,8"
                    MinHeight="44">
                <TextBlock x:Name="LockText" Text="🔒 Lock This PC"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.OnAccent}"
                           FontWeight="Bold" FontSize="14"/>
            </Button>

            <!-- Phase 6.6 — Screenshot -->
            <Button x:Name="ScreenshotButton" Grid.Column="2"
                    Click="Screenshot_Click"
                    Style="{DynamicResource Button.Primary}"
                    Background="#06B6D4"
                    Foreground="{DynamicResource Text.OnAccent}"
                    Padding="8,12" Margin="4,8"
                    MinHeight="44">
                <TextBlock x:Name="ScreenshotText" Text="📸 Take Screenshot"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.OnAccent}"
                           FontWeight="Bold" FontSize="14"/>
            </Button>

            <!-- Phase 5b — Record toggle -->
            <Button x:Name="RecordButton" Grid.Column="3"
                    Click="Record_Click"
                    Style="{DynamicResource Button.Primary}"
                    Background="#10B981"
                    Foreground="{DynamicResource Text.OnAccent}"
                    Padding="8,12" Margin="4,8,8,8"
                    MinHeight="44">
                <TextBlock x:Name="RecordText" Text="🔴 Record Video"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.OnAccent}"
                           FontWeight="Bold" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Center: live screen image with waiting overlay -->
        <Grid Background="Black">
            <Image x:Name="ScreenImage" Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"
                   SnapsToDevicePixels="True"/>

            <TextBlock x:Name="WaitingText"
                       Text="Waiting for student to start streaming..."
                       Foreground="{DynamicResource Text.Secondary}"
                       FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Close button only visible when fullscreen (no title bar) -->
            <Button x:Name="CloseButton" Click="CloseButton_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="42" Height="36"
                    Style="{DynamicResource Button.Danger}"
                    FontSize="18" FontWeight="Bold"
                    Content="✕"
                    ToolTip="Close (ESC)"
                    Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
