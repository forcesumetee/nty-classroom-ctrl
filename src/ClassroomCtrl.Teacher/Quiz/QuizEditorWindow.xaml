<Window x:Class="ClassroomCtrl.Teacher.Quiz.QuizEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_QuizEditor}"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: header fields -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Lbl_QuizTitle}"
                           Style="{DynamicResource Text.Body}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TitleBox"
                         Style="{DynamicResource TextBox.Default}" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource Lbl_Duration}"
                           Style="{DynamicResource Text.Body}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" x:Name="DurationBox"
                         Style="{DynamicResource TextBox.Default}" Margin="8,0,0,0"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Lbl_Description}"
                           Style="{DynamicResource Text.Body}"
                           VerticalAlignment="Top" Margin="0,8,0,0"/>
                <TextBox Grid.Column="1" x:Name="DescriptionBox"
                         Style="{DynamicResource TextBox.Default}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="56" Margin="8,0,0,0"/>
            </Grid>
            <CheckBox x:Name="ShowScoreBox"
                      Style="{DynamicResource CheckBox.Default}"
                      Margin="0,12,0,0"
                      Content="{DynamicResource Lbl_ShowScore}"/>
        </StackPanel>

        <!-- Row 1: Question list (fills available space) -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Surface.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.MD}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Questions"
                           Style="{DynamicResource Text.H3}"
                           Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="QuestionListBox"
                         Style="{DynamicResource ListBox.Default}"
                         MouseDoubleClick="QuestionListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Text}"
                                           Style="{DynamicResource Text.H3}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           Margin="0,2,0,0">
                                    <Run Text="["/>
                                    <Run Text="{Binding Type}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Points}"/>
                                    <Run Text="pts]"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Row 2: button bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_AddQuestion}" Click="AddQuestion_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_EditQuestion}" Click="EditQuestion_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_RemoveQuestion}" Click="RemoveQuestion_Click"
                    Style="{DynamicResource Button.Danger}" Margin="0,0,16,0"/>
            <Button Content="{DynamicResource Btn_Save}" Click="Save_Click"
                    Style="{DynamicResource Button.Success}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_Cancel}" Click="Cancel_Click"
                    Style="{DynamicResource Button.Secondary}"/>
        </StackPanel>
    </Grid>
</Window>
