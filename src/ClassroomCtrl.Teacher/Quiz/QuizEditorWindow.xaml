<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.Quiz.QuizEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_QuizEditor}"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 5 Section B — restructured to match the Phase 4 dialog design language:
         pinned header / body (form fields + question list) / pinned footer.
         List controls (Add/Edit/Remove) live above the question list as a toolbar so
         the footer can stay focused on Cancel / Save. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="📝" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_QuizEditor}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_QuizEditor}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Form fields -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,8">
                    <TextBlock Text="{DynamicResource Lbl_QuizTitle}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleBox" Style="{DynamicResource TextBox.Default}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Lbl_Duration}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="DurationBox" Style="{DynamicResource TextBox.Default}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Lbl_Description}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionBox"
                             Style="{DynamicResource TextBox.Default}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="56"/>
                </StackPanel>

                <CheckBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                          x:Name="ShowScoreBox"
                          Style="{DynamicResource CheckBox.Default}"
                          Content="{DynamicResource Lbl_ShowScore}" Margin="0,4,0,0"/>
            </Grid>

            <!-- Questions section header + per-row toolbar -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="{DynamicResource Btn_AddQuestion}"
                            Click="AddQuestion_Click" Margin="0,0,8,0"/>
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="{DynamicResource Btn_EditQuestion}"
                            Click="EditQuestion_Click" Margin="0,0,8,0"/>
                    <Button Style="{DynamicResource Button.Danger}"
                            Content="{DynamicResource Btn_RemoveQuestion}"
                            Click="RemoveQuestion_Click"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Lbl_Questions}"
                           Style="{DynamicResource Text.H3}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Questions list -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="8">
                <ListBox x:Name="QuestionListBox"
                         Style="{DynamicResource ListBox.Default}"
                         Background="Transparent"
                         BorderThickness="0"
                         MouseDoubleClick="QuestionListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding Text}"
                                           Style="{DynamicResource Text.H3}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           Margin="0,2,0,0">
                                    <Run Text="["/>
                                    <Run Text="{Binding Type}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Points}"/>
                                    <Run Text="pts]"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Save}"
                        Click="Save_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
