<UserControl x:Class="ClassroomCtrl.Teacher.Quiz.ExamStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Surface.Background}"
             TextElement.Foreground="{DynamicResource Text.Primary}"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock x:Name="SummaryText"
                       Style="{DynamicResource Text.Body}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Histogram -->
            <Border Background="{DynamicResource Surface.Elevated}"
                    BorderBrush="{DynamicResource Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadius.MD}"
                    Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lbl_ScoreHistogram}"
                               Style="{DynamicResource Text.H3}"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart x:Name="HistogramChart" Height="240" MaxHeight="300"/>
                </StackPanel>
            </Border>

            <!-- Avg / Min / Max + Per-question side-by-side on wide windows -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource Surface.Elevated}"
                        BorderBrush="{DynamicResource Surface.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.MD}"
                        Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Lbl_AvgMinMax}"
                                   Style="{DynamicResource Text.H3}"
                                   Margin="0,0,0,8"/>
                        <lvc:CartesianChart x:Name="StatsSummaryChart" Height="220" MaxHeight="300"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource Surface.Elevated}"
                        BorderBrush="{DynamicResource Surface.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.MD}"
                        Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Lbl_PerQuestionStats}"
                                   Style="{DynamicResource Text.H3}"
                                   Margin="0,0,0,8"/>
                        <lvc:CartesianChart x:Name="PerQuestionChart" Height="220" MaxHeight="300"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
