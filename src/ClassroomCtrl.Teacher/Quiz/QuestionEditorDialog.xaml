<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.Quiz.QuestionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_QuestionEditor}"
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 5 Section B - restructured: header / body (form fields + dynamic
         choices/short-answer pane) / pinned footer.  Choices grid row uses
         Height="*" so the inline ItemsControl scrolls within a Surface.Card.
         Phase 10.18 - replaced corrupted em-dash mojibake with ASCII so a
         future double-encode pass can't garble this comment again. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="&#x2753;" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_QuestionEditor}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_QuestionEditor}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Type + Points row -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Lbl_QuestionType}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeBox"
                              Style="{DynamicResource ComboBox.Default}"
                              SelectionChanged="TypeBox_SelectionChanged">
                        <ComboBoxItem Tag="McqSingle" Content="{DynamicResource Type_MultipleChoice}"/>
                        <ComboBoxItem Tag="TrueFalse" Content="{DynamicResource Type_TrueFalse}"/>
                        <ComboBoxItem Tag="ShortAnswer" Content="{DynamicResource Type_ShortAnswer}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Lbl_Points}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="PointsBox" Style="{DynamicResource TextBox.Default}"/>
                </StackPanel>
            </Grid>

            <!-- Question text -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Lbl_QuestionText}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="QuestionTextBox"
                         Style="{DynamicResource TextBox.Default}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
            </StackPanel>

            <!-- Choices grid (MCQ + T/F) -->
            <Grid x:Name="ChoicesGrid" Grid.Row="2" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Lbl_Choices}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                <Border Grid.Row="1"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8">
                        <!-- ItemsControl + per-row delete button (Phase 13 fix preserved):
                             ListBox swallowed clicks before TextBox could focus, so each
                             row is directly hit-testable and the * column truly stretches. -->
                        <ItemsControl x:Name="ChoicesItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     GroupName="CorrectChoice"
                                                     IsChecked="{Binding IsCorrect, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{DynamicResource Lbl_CorrectAnswer}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Accent.Primary}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Default}"/>
                                        <!-- Belt-and-suspenders: pin Background + BorderThickness inline so
                                             a branded Accent.Primary can never bleed into the X icon. -->
                                        <Button Grid.Column="3"
                                                Style="{DynamicResource Button.Icon}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="RemoveChoiceRow_Click"
                                                Tag="{Binding}"
                                                Width="32" Height="32"
                                                Margin="4,0,0,0"
                                                ToolTip="{DynamicResource Btn_RemoveChoice}">
                                            <TextBlock Text="&#x2715;" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource Accent.Danger}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="{DynamicResource Btn_AddChoice}"
                            Click="AddChoice_Click"/>
                </StackPanel>
            </Grid>

            <!-- Short-answer pane -->
            <StackPanel x:Name="ShortAnswerPanel" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Lbl_CorrectAnswer}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ShortAnswerBox"
                         Style="{DynamicResource TextBox.Default}"
                         TextWrapping="Wrap"/>
                <TextBlock Foreground="{DynamicResource Text.Muted}" FontSize="11"
                           Margin="0,4,0,0"
                           Text="{DynamicResource Hint_ShortAnswerCompare}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Save}"
                        Click="Save_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
