<Window x:Class="ClassroomCtrl.Teacher.Quiz.QuestionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_QuestionEditor}"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Lbl_QuestionType}"
                           Style="{DynamicResource Text.Body}"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="TypeBox"
                          Style="{DynamicResource ComboBox.Default}"
                          Margin="4,0" SelectionChanged="TypeBox_SelectionChanged">
                    <ComboBoxItem Tag="McqSingle" Content="{DynamicResource Type_MultipleChoice}"/>
                    <ComboBoxItem Tag="TrueFalse" Content="{DynamicResource Type_TrueFalse}"/>
                    <ComboBoxItem Tag="ShortAnswer" Content="{DynamicResource Type_ShortAnswer}"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="{DynamicResource Lbl_Points}"
                           Style="{DynamicResource Text.Body}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <TextBox Grid.Column="3" x:Name="PointsBox"
                         Style="{DynamicResource TextBox.Default}"
                         Margin="4,0"/>
            </Grid>
            <TextBlock Text="{DynamicResource Lbl_QuestionText}"
                       Style="{DynamicResource Text.Body}"
                       Margin="0,4,0,2"/>
            <TextBox x:Name="QuestionTextBox"
                     Style="{DynamicResource TextBox.Default}"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Btn_Save}" Click="Save_Click"
                    Style="{DynamicResource Button.Success}"
                    Margin="0,0,4,0"/>
            <Button Content="{DynamicResource Btn_Cancel}" Click="Cancel_Click"
                    Style="{DynamicResource Button.Secondary}"/>
        </StackPanel>

        <Grid x:Name="ChoicesGrid" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource Lbl_Choices}" FontWeight="Bold" Margin="0,4"/>
            <!-- Bug fix: ListBox swallowed clicks before TextBox could focus, and the default
                 ListBoxItem container did not stretch the inner Grid so the * column collapsed.
                 Switched to ItemsControl + per-row delete button so each TextBox is directly
                 hit-testable and the * column truly stretches. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChoicesItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             GroupName="CorrectChoice"
                                             IsChecked="{Binding IsCorrect, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             ToolTip="{DynamicResource Lbl_CorrectAnswer}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#1E3A8A"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         FontSize="14"
                                         Foreground="Black"
                                         Background="White"
                                         BorderBrush="#94A3B8"
                                         BorderThickness="1"
                                         MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"/>
                                <!-- Belt-and-suspenders: Button.Icon style sets Background=Transparent
                                     and inherits BorderThickness=0 from Button.Base, but Branding
                                     overrides Accent.Primary at runtime; pinning these inline guarantees
                                     the X icon never renders against a coloured panel. -->
                                <Button Grid.Column="3"
                                        Style="{DynamicResource Button.Icon}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveChoiceRow_Click"
                                        Tag="{Binding}"
                                        Width="32" Height="32"
                                        Margin="4,0,0,0"
                                        ToolTip="{DynamicResource Btn_RemoveChoice}">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent.Danger}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{DynamicResource Btn_AddChoice}" Click="AddChoice_Click" Padding="10,2"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ShortAnswerPanel" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Lbl_CorrectAnswer}" FontWeight="Bold" Margin="0,4,0,2"/>
            <TextBox x:Name="ShortAnswerBox" TextWrapping="Wrap"/>
            <TextBlock Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                       Text="{DynamicResource Hint_ShortAnswerCompare}"/>
        </StackPanel>
    </DockPanel>
</Window>
