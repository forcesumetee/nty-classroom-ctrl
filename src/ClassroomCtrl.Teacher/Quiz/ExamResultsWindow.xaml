<Window x:Class="ClassroomCtrl.Teacher.Quiz.ExamResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:quiz="clr-namespace:ClassroomCtrl.Teacher.Quiz"
        Title="{DynamicResource Lbl_Results}"
        Height="640" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="QuizTitleText" Style="{DynamicResource Text.H1}"/>
            <TextBlock x:Name="StatsText" Style="{DynamicResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_ExportExcel}" Click="Export_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_ExportHtml}" Click="ExportHtml_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_Close}" Click="Close_Click"
                    Style="{DynamicResource Button.Secondary}"/>
        </StackPanel>

        <TabControl Style="{DynamicResource TabControl.Underline}">
            <TabItem Header="📋 Results">
                <DataGrid x:Name="ResultsGrid" Style="{DynamicResource DataGrid.Default}"
                          IsReadOnly="True"
                          CanUserDeleteRows="False"
                          Margin="0,12,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Lbl_FullName}" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_ClassName}" Binding="{Binding ClassName}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_StudentNumber}" Binding="{Binding StudentNumber}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_Score}" Binding="{Binding ScoreText}" Width="80"/>
                        <DataGridTextColumn Header="%" Binding="{Binding Percentage}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_SubmittedAt}" Binding="{Binding SubmittedText}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_AutoSubmitted}" Binding="{Binding AutoSubmittedText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource Lbl_QuizStats}">
                <quiz:ExamStatisticsView x:Name="StatsView"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
