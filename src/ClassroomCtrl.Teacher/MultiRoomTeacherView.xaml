<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.MultiRoomTeacherView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_MultiRoom}"
        Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Btn_MultiRoom}"
                   Style="{DynamicResource Text.H1}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top"
                   Style="{DynamicResource Text.Caption}"
                   Margin="0,0,0,12"
                   Text="Multi-room teaching v1: pick a room then send a chat broadcast scoped to that room only. v2 will add per-room screen-share + file routing."/>

        <ItemsControl x:Name="RoomsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Surface.Elevated}"
                            Padding="14" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource Surface.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadius.MD}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="SendToRoom_Click" Tag="{Binding}"
                                    Content="📨 Send"
                                    Style="{DynamicResource Button.Primary}"/>
                            <TextBlock Text="{Binding RoomName}"
                                       Style="{DynamicResource Text.H3}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
