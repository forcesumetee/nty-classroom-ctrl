<Window x:Class="ClassroomCtrl.Teacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ClassroomCtrl.Teacher.ViewModels"
        xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
        Title="{DynamicResource Lbl_AppTitle}"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        Background="{DynamicResource Surface.Background}"
        FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:VideoCodecLabelConverter x:Key="VideoCodecLabel"/>
    </Window.Resources>

    <!-- Phase UI-Rewrite Phase 1: 3-column shell.
         Row 0 = header (56),  Row 1 = optional demo banner,  Row 2 = sidebar / main / rail.
         Sidebar (240) keeps every command from Phase-13 except codec/bitrate UI (moved to a future
         Settings dialog) and the secondary breakout commands (live in the breakout window). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════════════ HEADER ═════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand block: logo + title + organization subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource BrandLogoSource}" Height="32"
                           Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BrandTitleBar}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <!-- TODO Phase 2: bind to a BrandingService-driven OrganizationName property
                             once the schema gains one. For Phase 1 the literal mirrors the footer. -->
                        <TextBlock Text="NTY MULTIMEDIA"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection pill (centered) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="999" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent.Success}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Lbl_ConnectTo}"
                                   FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalIPDisplay}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right side actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Accent.PrimarySubtle}"
                            CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectedCountText}"
                                   Foreground="{DynamicResource Accent.Primary}"
                                   FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button Style="{DynamicResource Button.Icon}" Click="CopyIP_Click"
                            ToolTip="{DynamicResource Btn_CopyIP}">
                        <TextBlock Text="📋" FontSize="14"/>
                    </Button>
                    <Button Style="{DynamicResource Button.Icon}"
                            Command="{Binding OpenBrandingSettingsCommand}"
                            ToolTip="{DynamicResource Btn_BrandingSettings}">
                        <TextBlock Text="⚙" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════════ DEMO BANNER (Phase 9.1) ═════════════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Background="#7C3AED" Padding="12,6"
                Visibility="{Binding DemoBannerVisibility}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding StopDemoCommand}"
                        Content="{DynamicResource Btn_StopDemo}"
                        Background="#1F2937" Foreground="White"
                        BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                <TextBlock Text="{Binding DemoBannerText}"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═════════════════════ SIDEBAR (Grid.Row=2 / Col=0) ═════════════════════ -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Bottom CTA area pinned so it stays visible regardless of scroll -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                        Padding="12">
                    <StackPanel>
                        <Button Style="{DynamicResource Button.Primary}"
                                Command="{Binding ShareScreenCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ShareScreenButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource Button.Danger}"
                                Command="{Binding LogoffAllCommand}"
                                Content="{DynamicResource Btn_LogoffAll}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,16,0,16">

                        <!-- Group 1: Class Tools ───────────────────── -->
                        <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                   Text="{DynamicResource Hdr_ClassTools}"
                                   Margin="22,0,12,6"/>
                        <StackPanel Margin="12,0">
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding LockAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LockButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ApplyPolicyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_ApplyPolicy}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleCameraCommand}">
                                <TextBlock Text="{Binding CameraButtonText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenScreenPenCommand}">
                                <TextBlock Text="{DynamicResource Btn_ScreenPen}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenNetMovieCommand}">
                                <TextBlock Text="{DynamicResource Btn_NetMovie}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding SendFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_SendFile}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Group 2: Audio ───────────────────── -->
                        <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                   Text="{DynamicResource Hdr_Audio}"
                                   Margin="22,16,12,6"/>
                        <StackPanel Margin="12,0">
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleSoundsCommand}">
                                <TextBlock Text="{Binding SoundsButtonText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleMicCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MicButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleSystemAudioCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔉" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SystemAudioButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding MuteAllStudentsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔇" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_MuteAllStudents}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenMicMonitorCommand}">
                                <TextBlock Text="{DynamicResource Btn_MicMonitor}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <TextBlock Style="{DynamicResource Text.Caption}"
                                       Text="{DynamicResource Lbl_MasterVolume}"
                                       Margin="12,8,12,2"/>
                            <Slider Minimum="0" Maximum="2" Value="{Binding MasterVolume, Mode=TwoWay}"
                                    TickFrequency="0.25" IsSnapToTickEnabled="False"
                                    Margin="14,0,14,4"
                                    ToolTip="{DynamicResource Lbl_MasterVolume}"/>
                        </StackPanel>

                        <!-- Group 3: Recording & Breakout ───────────────────── -->
                        <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                   Text="{DynamicResource Hdr_RecordingBreakout}"
                                   Margin="22,16,12,6"/>
                        <StackPanel Margin="12,0">
                            <!-- Sub-section: การบันทึก -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding StartRecordingCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏺" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RecordingButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenRecordingsFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_OpenRecordingsFolder}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Sub-section spacer (12px) -->
                            <Border Height="12"/>

                            <!-- Sub-section: Breakout -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenBreakoutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_BreakoutRooms}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenMultiRoomCommand}">
                                <TextBlock Text="{DynamicResource Btn_MultiRoom}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                        </StackPanel>

                        <!-- Group 4: Teach & Assess ───────────────────── -->
                        <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                   Text="{DynamicResource Hdr_TeachAssess}"
                                   Margin="22,16,12,6"/>
                        <StackPanel Margin="12,0">
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenQuizManagerCommand}">
                                <TextBlock Text="{DynamicResource Btn_QuizManager}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenClassRosterCommand}">
                                <TextBlock Text="{DynamicResource Btn_ClassRosters}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding MarkAttendanceCommand}">
                                <TextBlock Text="{DynamicResource Btn_MarkAttendance}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <TextBlock Style="{DynamicResource Text.Caption}"
                                       Text="{Binding ActiveClassName}"
                                       Visibility="{Binding ActiveClassVisibility}"
                                       Margin="12,4,12,2"/>
                        </StackPanel>

                        <!-- Group 5: System ───────────────────── -->
                        <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                   Text="{DynamicResource Hdr_System}"
                                   Margin="22,16,12,6"/>
                        <StackPanel Margin="12,0">
                            <!-- Sub-section: Power -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding RestartAllCommand}">
                                <TextBlock Text="{DynamicResource Btn_RestartAll}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ShutdownAllCommand}">
                                <TextBlock Text="{DynamicResource Btn_ShutdownAll}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>

                            <Border Height="12"/>

                            <!-- Sub-section: ตั้งค่า -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenBrandingSettingsCommand}">
                                <TextBlock Text="{DynamicResource Btn_BrandingSettings}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenLanguageCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_Language}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenAdminPasswordSettingsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔑" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_AdminPasswordSettings}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═════════════════════ MAIN CONTENT (student grid) ═════════════════════ -->
        <Grid Grid.Row="2" Grid.Column="1" Background="{DynamicResource Surface.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar with search (visual only — wire-up in Phase 2) -->
            <Border Grid.Row="0" Padding="24,16"
                    Background="{DynamicResource Surface.Background}"
                    BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Border Width="320" DockPanel.Dock="Left"
                            Background="{DynamicResource Surface.Card}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" Padding="12,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="13"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <!-- TODO Phase 2: bind to a SearchTerm property + filter Students. -->
                            <TextBox Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}"
                                     IsEnabled="False"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Student grid. Phase 1 keeps the legacy DataTemplate intact (with badges, REC button,
                 ContextMenu) so per-student commands keep working; Phase 2 will swap it for a
                 dedicated StudentCard UserControl. -->
            <ItemsControl x:Name="StudentList" Grid.Row="1" ItemsSource="{Binding Students}"
                          Margin="20,16,20,16">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="220" ItemHeight="220"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,14,14" Padding="0" Width="206" Height="206">
                            <Border Background="Transparent"
                                    PreviewMouseRightButtonDown="StudentTile_RightClick">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Menu_ViewStudentScreen}"
                                                  Command="{Binding DataContext.ViewStudentScreenCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_LockScreen}"
                                                  Command="{Binding DataContext.LockOneCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource Menu_UnlockScreen}"
                                                  Command="{Binding DataContext.UnlockOneCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_ApplyPolicyToStudent}"
                                                  Command="{Binding DataContext.ApplyPolicyToStudentCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource Menu_RevertPolicyForStudent}"
                                                  Command="{Binding DataContext.RevertPolicyForStudentCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_SendDM}"
                                                  Command="{Binding DataContext.SendDirectMessageCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_SetAsHost}"
                                                  Command="{Binding DataContext.SetAsHostCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource Menu_RemoveHost}"
                                                  Command="{Binding DataContext.RemoveHostCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_StartDemo}"
                                                  Command="{Binding DataContext.StartDemoCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource Menu_StopDemo}"
                                                  Command="{Binding DataContext.StopDemoCommand, Source={x:Reference StudentList}}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_AssignToRoom}"
                                                  ItemsSource="{Binding DataContext.Rooms, Source={x:Reference StudentList}}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding RoomName}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.AssignToRoomCommand, Source={x:Reference StudentList}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu_RemoveFromRoom}"
                                                  Command="{Binding DataContext.RemoveFromRoomCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Menu_Logoff}"
                                                  Command="{Binding DataContext.LogoffOneCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource Menu_Restart}"
                                                  Command="{Binding DataContext.RestartOneCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource Menu_Shutdown}"
                                                  Command="{Binding DataContext.ShutdownOneCommand, Source={x:Reference StudentList}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <DockPanel>
                                    <Border DockPanel.Dock="Top"
                                            Visibility="{Binding HandRaisedVisibility}"
                                            Background="#F59E0B" Padding="4">
                                        <TextBlock Text="{DynamicResource Lbl_HandRaised}" Foreground="White"
                                                   FontWeight="Bold" FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border DockPanel.Dock="Top"
                                            Visibility="{Binding PerStudentPolicyBadgeVisibility}"
                                            Background="#7C3AED" Padding="4">
                                        <TextBlock Text="{DynamicResource Lbl_PolicySet}" Foreground="White"
                                                   FontWeight="Bold" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border DockPanel.Dock="Top"
                                            Visibility="{Binding RoomBadgeVisibility}"
                                            Background="{Binding RoomBadgeColorHex, Converter={StaticResource HexToBrush}}"
                                            Padding="4">
                                        <TextBlock Text="{Binding RoomName}" Foreground="White"
                                                   FontWeight="Bold" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MachineName}" FontSize="10" Foreground="Gray"/>
                                        <Border Margin="0,4,0,0" Background="{DynamicResource Surface.Hover}" Height="100">
                                            <Grid>
                                                <Image Stretch="Uniform" Source="{Binding ThumbnailImage}"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="4" Padding="4,2" CornerRadius="3"
                                                        Background="#10B981"
                                                        Visibility="{Binding TalkingBadgeVisibility}"
                                                        ToolTip="{DynamicResource Lbl_Talking}">
                                                    <TextBlock Text="🎤" Foreground="White" FontSize="11"/>
                                                </Border>
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                                                        Margin="4" Padding="6,2" CornerRadius="3"
                                                        Background="#F59E0B"
                                                        Visibility="{Binding HostBadgeVisibility}"
                                                        ToolTip="{DynamicResource Lbl_Host}">
                                                    <TextBlock Text="👑 HOST" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="4" Width="48" Height="22"
                                                        Background="{Binding RecButtonColorHex, Converter={StaticResource HexToBrush}}"
                                                        Foreground="White" BorderBrush="White" BorderThickness="1"
                                                        FontSize="9" FontWeight="Bold"
                                                        Content="{Binding RecButtonText}"
                                                        Opacity="{Binding RecOpacity}"
                                                        IsEnabled="{Binding CanRecord}"
                                                        Cursor="Hand" Padding="0"
                                                        ToolTip="{DynamicResource Tooltip_RecButton}"
                                                        Command="{Binding DataContext.ToggleStudentRecordingCommand, Source={x:Reference StudentList}}"
                                                        CommandParameter="{Binding}"
                                                        Panel.ZIndex="100"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="4" Width="10" Height="10" CornerRadius="5"
                                                        Background="{Binding QualityDotColorHex, Converter={StaticResource HexToBrush}}"
                                                        ToolTip="{DynamicResource Lbl_QualityScore}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recording indicator (top-right, scoped to main column so it doesn't overlap rail) -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,28,28,0"
                    Background="{DynamicResource Accent.Danger}"
                    Padding="12,6" CornerRadius="6"
                    Visibility="{Binding RecordingIndicatorVisibility}"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding RecordingElapsedText}" Foreground="White"
                           FontWeight="Bold" FontSize="13"/>
            </Border>

            <!-- Copyright (bottom-center of main column) -->
            <TextBlock Grid.Row="2"
                       Text="© NTY MULTIMEDIA CO.,LTD"
                       Style="{DynamicResource Text.Footer}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,8"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- ═════════════════════ RIGHT RAIL (chat) ═════════════════════ -->
        <Border Grid.Row="2" Grid.Column="2"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- Tabs (Phase 1: only Chat is functional. Activity is a TODO Phase 2 placeholder). -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                        Padding="12,12,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource Surface.Background}"
                                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="14,8" Margin="0,0,4,-1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Hdr_ClassChat}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="14,8" Opacity="0.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Activity" FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Chat input -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{DynamicResource TextBox.Default}"
                                 Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{DynamicResource Button.Primary}"
                                Command="{Binding SendChatCommand}"
                                Margin="8,0,0,0" Width="40" Height="40" Padding="0"
                                ToolTip="{DynamicResource Btn_Send}">
                            <TextBlock Text="➤" FontSize="14" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Messages list. ChatMessages is ObservableCollection<string>; bubble each line in a card. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ChatMessages}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding}"
                                               Style="{DynamicResource Text.Body}"
                                               Foreground="{DynamicResource Text.Primary}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
