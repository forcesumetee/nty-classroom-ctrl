<Window x:Class="ClassroomCtrl.Teacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ClassroomCtrl.Teacher.ViewModels"
        xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
        xmlns:controls="clr-namespace:ClassroomCtrl.Teacher.Controls"
        xmlns:views="clr-namespace:ClassroomCtrl.Teacher.Views"
        xmlns:models="clr-namespace:ClassroomCtrl.Shared.Models;assembly=ClassroomCtrl.Shared"
        Title="{DynamicResource Lbl_AppTitle}"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        Background="{DynamicResource Surface.Background}"
        FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:VideoCodecLabelConverter x:Key="VideoCodecLabel"/>
        <!-- Phase 2: Section C uses this converter (parameter "Inverted" flips the mapping). -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Phase 3 Section E: highlights the active tab in the conversation strip and
             hides the close-✕ on the Everyone tab. -->
        <conv:AreEqualConverter x:Key="AreEqual"/>
        <conv:ConversationKindToCloseVisibilityConverter x:Key="KindToCloseVisibility"/>
        <!-- Phase 3 Section G: routes main content area between StudentGrid and QuizManager. -->
        <conv:ViewKindToVisibilityConverter x:Key="ViewKindToVisibility"/>
    </Window.Resources>

    <!-- Phase UI-Rewrite Phase 1: 3-column shell.
         Row 0 = header (56),  Row 1 = optional demo banner,  Row 2 = sidebar / main / rail.
         Sidebar (240) keeps every command from Phase-13 except codec/bitrate UI (moved to a future
         Settings dialog) and the secondary breakout commands (live in the breakout window). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════════════ HEADER ═════════════════════ -->
        <!-- Phase 4.2 Issue 3 — header banner now uses BrandPrimaryBrush so the user's
             Primary color drives a visible "skin" of the app (matches Live Preview's
             PreviewBanner = Primary mental model from BrandingSettingsWindow).
             Inline white-on-primary text colors override the theme tokens for elements
             living inside this banner only; everything below the header still resolves
             to the regular Light theme tokens. -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource BrandPrimaryBrush}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand block: logo + title + organization subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource BrandLogoSource}" Height="32"
                           Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BrandTitleBar}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.OnAccent}"/>
                        <TextBlock Text="{Binding OrganizationSubtitle}"
                                   FontSize="11"
                                   Foreground="#CCFFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection pill (centered) — stays a white card on primary banner.
                     Phase 7 Section A — capsule (CornerRadius=999) felt out-of-place
                     against the rest of the rounded-rect Phase 4-6 surface language;
                     dropped to CornerRadius=10 to read as a "connection card" instead
                     of a status pill.  Padding/font sizing from Phase 6 A retained. -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="10" Padding="14,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent.Success}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Lbl_ConnectTo}"
                                   FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalIPDisplay}"
                                   FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right side actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Phase 4.2 Issue 3 — connected count flipped from primary-subtle pill
                         to a white card so it stays readable on the primary-tinted banner. -->
                    <Border Background="{DynamicResource Surface.Card}"
                            CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectedCountText}"
                                   Foreground="{DynamicResource Accent.Primary}"
                                   FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Phase 4.2 Issue 3 — explicit Foreground=white so the emoji glyph
                         and the (rare) outline icon both read against the primary banner. -->
                    <Button Style="{DynamicResource Button.Icon}" Click="CopyIP_Click"
                            Foreground="{DynamicResource Text.OnAccent}"
                            ToolTip="{DynamicResource Btn_CopyIP}">
                        <TextBlock Text="📋" FontSize="14"/>
                    </Button>
                    <!-- Phase 3 Section D — Notifications bell.  Badge shows the unread
                         notification count; click marks all read and toggles the popup. -->
                    <Button x:Name="NotificationsBellBtn"
                            Style="{DynamicResource Button.Icon}"
                            Foreground="{DynamicResource Text.OnAccent}"
                            Click="NotificationsBell_Click"
                            ToolTip="{DynamicResource Tooltip_Notifications}">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="14"/>
                            <Border Background="{DynamicResource Accent.Danger}"
                                    CornerRadius="999" MinWidth="16" Height="16"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-2,-4,0" Padding="4,0"
                                    Visibility="{Binding HasUnreadNotifications,
                                        Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding UnreadNotificationsCount}"
                                           Foreground="White" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Popup x:Name="NotificationsPopup"
                           PlacementTarget="{Binding ElementName=NotificationsBellBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource Surface.Elevated}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="12" Padding="12" MinWidth="320" MaxWidth="380"
                                Margin="0,4,8,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                                                  Color="Black" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Hdr_Notifications}"
                                           Style="{DynamicResource Text.H3}"
                                           Margin="0,0,0,8"/>
                                <ScrollViewer MaxHeight="320"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Notification}">
                                                <Border Padding="10" CornerRadius="6"
                                                        BorderBrush="{DynamicResource Border.Soft}"
                                                        BorderThickness="1"
                                                        Margin="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Surface.Card}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource Accent.PrimarySubtle}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding Icon}"
                                                                   FontSize="14"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding TimeAgoDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Muted}"
                                                                   VerticalAlignment="Top"
                                                                   Margin="6,0,0,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource Text.Primary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Body}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Text.Secondary}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="{DynamicResource Lbl_NoNotifications}"
                                           Foreground="{DynamicResource Text.Muted}"
                                           FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,8,0,8"
                                           Visibility="{Binding HasAnyNotifications,
                                               Converter={StaticResource BoolToVisibility},
                                               ConverterParameter=Inverted}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Style="{DynamicResource Button.Icon}"
                            Foreground="{DynamicResource Text.OnAccent}"
                            Command="{Binding OpenBrandingSettingsCommand}"
                            ToolTip="{DynamicResource Btn_BrandingSettings}">
                        <TextBlock Text="⚙" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════════ DEMO BANNER (Phase 9.1) ═════════════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Background="#7C3AED" Padding="12,6"
                Visibility="{Binding DemoBannerVisibility}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding StopDemoCommand}"
                        Content="{DynamicResource Btn_StopDemo}"
                        Background="#1F2937" Foreground="White"
                        BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                <TextBlock Text="{Binding DemoBannerText}"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═════════════════════ SIDEBAR (Grid.Row=2 / Col=0) ═════════════════════ -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Bottom CTA area pinned so it stays visible regardless of scroll -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                        Padding="12">
                    <StackPanel>
                        <Button Style="{DynamicResource Button.Primary}"
                                Command="{Binding ShareScreenCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ShareScreenButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource Button.Danger}"
                                Command="{Binding LogoffAllCommand}"
                                Content="{DynamicResource Btn_LogoffAll}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,16,0,16">

                        <!-- Group 1: Class Tools ───────────────────── -->
                        <DockPanel Margin="22,0,12,6">
                            <controls:HelpIcon DockPanel.Dock="Right"
                                               TitleKey="Hdr_ClassTools"
                                               BodyKey="Help_ClassTools"
                                               VerticalAlignment="Center"/>
                            <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                       Text="{DynamicResource Hdr_ClassTools}"
                                       Margin="0"/>
                        </DockPanel>
                        <StackPanel Margin="12,0">
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding LockAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LockButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ApplyPolicyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_ApplyPolicy}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleCameraCommand}">
                                <TextBlock Text="{Binding CameraButtonText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenScreenPenCommand}">
                                <TextBlock Text="{DynamicResource Btn_ScreenPen}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenNetMovieCommand}">
                                <TextBlock Text="{DynamicResource Btn_NetMovie}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding SendFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_SendFile}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Group 2: Audio ───────────────────── -->
                        <DockPanel Margin="22,16,12,6">
                            <controls:HelpIcon DockPanel.Dock="Right"
                                               TitleKey="Hdr_Audio"
                                               BodyKey="Help_Audio"
                                               VerticalAlignment="Center"/>
                            <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                       Text="{DynamicResource Hdr_Audio}"
                                       Margin="0"/>
                        </DockPanel>
                        <StackPanel Margin="12,0">
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleSoundsCommand}">
                                <TextBlock Text="{Binding SoundsButtonText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleMicCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MicButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ToggleSystemAudioCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔉" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SystemAudioButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding MuteAllStudentsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔇" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_MuteAllStudents}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenMicMonitorCommand}">
                                <TextBlock Text="{DynamicResource Btn_MicMonitor}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <TextBlock Style="{DynamicResource Text.Caption}"
                                       Text="{DynamicResource Lbl_MasterVolume}"
                                       Margin="12,8,12,2"/>
                            <Slider Minimum="0" Maximum="2" Value="{Binding MasterVolume, Mode=TwoWay}"
                                    TickFrequency="0.25" IsSnapToTickEnabled="False"
                                    Margin="14,0,14,4"
                                    ToolTip="{DynamicResource Lbl_MasterVolume}"/>
                        </StackPanel>

                        <!-- Group 3: Recording & Breakout ───────────────────── -->
                        <DockPanel Margin="22,16,12,6">
                            <controls:HelpIcon DockPanel.Dock="Right"
                                               TitleKey="Hdr_RecordingBreakout"
                                               BodyKey="Help_RecordingBreakout"
                                               VerticalAlignment="Center"/>
                            <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                       Text="{DynamicResource Hdr_RecordingBreakout}"
                                       Margin="0"/>
                        </DockPanel>
                        <StackPanel Margin="12,0">
                            <!-- Sub-section: การบันทึก -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding StartRecordingCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏺" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RecordingButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenRecordingsFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_OpenRecordingsFolder}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Sub-section spacer (12px) -->
                            <Border Height="12"/>

                            <!-- Sub-section: Breakout -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenBreakoutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_BreakoutRooms}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenMultiRoomCommand}">
                                <TextBlock Text="{DynamicResource Btn_MultiRoom}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                        </StackPanel>

                        <!-- Group 4: Teach & Assess ───────────────────── -->
                        <DockPanel Margin="22,16,12,6">
                            <controls:HelpIcon DockPanel.Dock="Right"
                                               TitleKey="Hdr_TeachAssess"
                                               BodyKey="Help_TeachAssess"
                                               VerticalAlignment="Center"/>
                            <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                       Text="{DynamicResource Hdr_TeachAssess}"
                                       Margin="0"/>
                        </DockPanel>
                        <StackPanel Margin="12,0">
                            <!-- Phase 3 Section H — Quiz Manager is the first embedded
                                 view, so its sidebar entry gets active-state highlighting
                                 via a DataTrigger on CurrentMainView. -->
                            <Button Command="{Binding OpenQuizManagerCommand}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource Button.SidebarItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentMainView}" Value="QuizManager">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Accent.PrimarySubtle}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Accent.Primary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{DynamicResource Btn_QuizManager}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenClassRosterCommand}">
                                <TextBlock Text="{DynamicResource Btn_ClassRosters}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <!-- Phase 7 Section D — Mark Attendance: opens the new
                                 AttendanceWindow.  Disabled (with a tooltip) when no
                                 roster is active so the teacher knows to activate
                                 one first instead of getting a chat-line error. -->
                            <Button Style="{DynamicResource Button.SidebarItem}"
                                    Command="{Binding MarkAttendanceCommand}"
                                    IsEnabled="{Binding HasActiveRoster}"
                                    ToolTip="{DynamicResource Tooltip_NoActiveRoster}"
                                    ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="{DynamicResource Btn_MarkAttendance}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <!-- Active class chip + Deactivate (✕) — only visible when
                                 a roster is active.  Click ✕ → DeactivateRosterCommand. -->
                            <DockPanel Visibility="{Binding ActiveClassVisibility}"
                                       Margin="12,4,12,2">
                                <Button DockPanel.Dock="Right"
                                        Style="{DynamicResource Button.Icon}"
                                        Command="{Binding DeactivateRosterCommand}"
                                        Padding="2" Width="20" Height="20"
                                        Margin="4,0,0,0"
                                        ToolTip="{DynamicResource Btn_DeactivateRoster}">
                                    <TextBlock Text="✕" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}"/>
                                </Button>
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           Text="{Binding ActiveClassName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Group 5: System ───────────────────── -->
                        <DockPanel Margin="22,16,12,6">
                            <controls:HelpIcon DockPanel.Dock="Right"
                                               TitleKey="Hdr_System"
                                               BodyKey="Help_System"
                                               VerticalAlignment="Center"/>
                            <TextBlock Style="{DynamicResource Text.SectionHeader}"
                                       Text="{DynamicResource Hdr_System}"
                                       Margin="0"/>
                        </DockPanel>
                        <StackPanel Margin="12,0">
                            <!-- Sub-section: Power -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding RestartAllCommand}">
                                <TextBlock Text="{DynamicResource Btn_RestartAll}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding ShutdownAllCommand}">
                                <TextBlock Text="{DynamicResource Btn_ShutdownAll}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>

                            <Border Height="12"/>

                            <!-- Sub-section: ตั้งค่า -->
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenBrandingSettingsCommand}">
                                <TextBlock Text="{DynamicResource Btn_BrandingSettings}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Button>
                            <Button Style="{DynamicResource Button.SidebarItem}" Command="{Binding OpenLanguageCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="14" Width="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Btn_Language}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Phase 8 Section D — Admin Password Settings entry point removed
                                 along with the matching dialog file.  Phase 8 also cuts the
                                 Student.Agent Settings button that the password gated, so the
                                 entire mechanism is dead. -->
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═════════════════════ MAIN CONTENT (student grid) ═════════════════════ -->
        <!-- Phase 3 Section G — wrapped with a visibility binding so the embedded Quiz
             Manager view (sibling below) can take over this cell when the user navigates. -->
        <Grid Grid.Row="2" Grid.Column="1" Background="{DynamicResource Surface.Background}"
              Visibility="{Binding CurrentMainView, Converter={StaticResource ViewKindToVisibility},
                                   ConverterParameter=StudentGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar with search — Phase 2 Section B: filters Students via StudentsView CollectionView. -->
            <Border Grid.Row="0" Padding="24,16"
                    Background="{DynamicResource Surface.Background}"
                    BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Border Width="320" DockPanel.Dock="Left"
                            Background="{DynamicResource Surface.Card}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" Padding="12,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="13"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     VerticalAlignment="Center"
                                     ToolTip="{DynamicResource Hint_SearchStudents}"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Phase 4.3 — App Background backplane.  Sits behind the student grid only
                 (search toolbar at Row 0 and copyright at Row 2 stay on solid Surface.Background).
                 BrandWallpaperBrush is removed from App.Resources by ApplyBrandingToResources
                 when the user has no wallpaper file, so this Border falls to the default
                 Transparent and the parent's Surface.Background shows through unchanged. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrandWallpaperBrush}"
                    IsHitTestVisible="False"/>

            <!-- Student grid. Phase 1 keeps the legacy DataTemplate intact (with badges, REC button,
                 ContextMenu) so per-student commands keep working; Phase 2 will swap it for a
                 dedicated StudentCard UserControl. -->
            <ItemsControl x:Name="StudentList" Grid.Row="1" ItemsSource="{Binding StudentsView}"
                          Margin="20,16,20,16">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- ItemWidth/Height = Card Width (220) + 14px margin spacing in DataTemplate -->
                        <WrapPanel ItemWidth="234" ItemHeight="220"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:StudentCard Margin="0,0,14,14"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recording indicator (top-right, scoped to main column so it doesn't overlap rail) -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,28,28,0"
                    Background="{DynamicResource Accent.Danger}"
                    Padding="12,6" CornerRadius="6"
                    Visibility="{Binding RecordingIndicatorVisibility}"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding RecordingElapsedText}" Foreground="White"
                           FontWeight="Bold" FontSize="13"/>
            </Border>

            <!-- Copyright (bottom-center of main column) -->
            <TextBlock Grid.Row="2"
                       Text="© NTY MULTIMEDIA CO.,LTD"
                       Style="{DynamicResource Text.Footer}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,8"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- Phase 3 Section G — embedded Quiz Manager.  Lives in the same Grid cell as the
             student grid above; visibility is mutually exclusive via CurrentMainView. -->
        <views:QuizManagerView Grid.Row="2" Grid.Column="1"
                               Visibility="{Binding CurrentMainView,
                                            Converter={StaticResource ViewKindToVisibility},
                                            ConverterParameter=QuizManager}"/>

        <!-- ═════════════════════ RIGHT RAIL (chat) ═════════════════════ -->
        <Border Grid.Row="2" Grid.Column="2"
                Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- Phase 2 Section F — right-rail tabs.  Clicking sets RightRailTabIndex
                     which toggles the Chat vs Activity panels' Visibility below. -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                        Padding="12,12,12,0">
                    <UniformGrid Columns="2">
                        <RadioButton GroupName="RailTabs"
                                     IsChecked="{Binding IsChatTabSelected, Mode=OneWay}"
                                     Command="{Binding SelectChatTabCommand}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd" Padding="12,8" CornerRadius="6,6,0,0"
                                            Background="Transparent" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Surface.Background}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Surface.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Hdr_ClassChat}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="RailTabs"
                                     IsChecked="{Binding IsActivityTabSelected, Mode=OneWay}"
                                     Command="{Binding SelectActivityTabCommand}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd" Padding="12,8" CornerRadius="6,6,0,0"
                                            Background="Transparent" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Surface.Background}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Surface.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Activity" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- Phase 3 Section E — conversation tab strip.  Always present at the top
                     of the chat panel; horizontally scrollable when many DM tabs accumulate.
                     The active tab gets the accent fill via AreEqual MultiBinding.
                     Phase 5.1 Section C — outer Padding bottom bumped 0→4 so the tab Border
                     no longer sits flush on the strip's 1px divider; that flush stacking is
                     what was clipping the bottom of the avatar circle on the Everyone tab. -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                        Padding="6,6,6,4"
                        Visibility="{Binding IsChatTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Conversation}">
                                    <!-- Phase 5.1 Section C — MinHeight=40 guarantees enough room for
                                         the 20px avatar circle + new 10/10 button padding so the
                                         circle never gets clipped at the bottom edge of the tab. -->
                                    <Border CornerRadius="8,8,0,0"
                                            Margin="0,0,2,0"
                                            MinHeight="40"
                                            BorderThickness="1,1,1,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Surface.Card}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Border.Soft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource AreEqual}">
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Window}"
                                                                         Path="DataContext.ActiveConversation"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource Accent.PrimarySubtle}"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Accent.Primary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Width="16" Height="16"
                                                    Margin="2,0,4,0" Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Visibility="{Binding Kind,
                                                        Converter={StaticResource KindToCloseVisibility}}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                              Path=DataContext.CloseConversationCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Close">
                                                <TextBlock Text="✕" FontSize="10"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                            </Button>
                                            <Border DockPanel.Dock="Right"
                                                    Background="{DynamicResource Accent.Danger}"
                                                    CornerRadius="999" MinWidth="16" Height="16"
                                                    Padding="4,0" Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasUnread,
                                                        Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding UnreadCount}"
                                                           Foreground="White" FontSize="9"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="10,10"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                              Path=DataContext.SwitchConversationCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="20" Height="20" CornerRadius="999"
                                                            Background="{DynamicResource Accent.Primary}"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Foreground="White"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="120"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Chat input — bound to active conversation's draft so per-tab text persists
                     across switches.  Only visible on the Chat tab; Activity tab is read-only. -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                        Padding="12"
                        Visibility="{Binding IsChatTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{DynamicResource TextBox.Default}"
                                 Text="{Binding ActiveConversation.DraftInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{DynamicResource Button.Primary}"
                                Command="{Binding SendChatCommand}"
                                Margin="8,0,0,0" Width="40" Height="40" Padding="0"
                                ToolTip="{DynamicResource Btn_Send}">
                            <TextBlock Text="➤" FontSize="14" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Phase 3 Section D — Activity feed sources from Notifications (newest-first).
                     Per-row icon comes from NotificationKind; full log includes already-read
                     notifications so this is the persistent history view. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsActivityTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding ActivityFeed}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Notification}">
                                <Border Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="28" Height="28"
                                                Background="{DynamicResource Accent.PrimarySubtle}"
                                                CornerRadius="6" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding TimeAgoDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   VerticalAlignment="Top" Margin="6,0,0,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Text="{Binding Body}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Phase 3 Section E — chat bubbles render the active conversation's
                     messages.  Switching tabs re-targets the binding to the new conversation's
                     ObservableCollection without copying data. -->
                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsChatTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding ActiveConversation.Messages}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Soft}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTeacher}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Accent.PrimarySubtle}"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Accent.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Surface.Hover}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Border DockPanel.Dock="Left"
                                                    Width="22" Height="22" CornerRadius="999"
                                                    Background="{DynamicResource Accent.Primary}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SenderInitial}"
                                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding TimeAgoDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding MessageText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
