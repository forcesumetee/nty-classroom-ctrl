<UserControl x:Class="ClassroomCtrl.Teacher.Controls.StudentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="220"
             Width="220">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>

    <!-- Phase 2 Section D — extracted from MainWindow.xaml DataTemplate.
         Phase 2.2 hotfix — ContextMenu lives in its own visual tree (via Popup), so
         {RelativeSource AncestorType=Window} from inside doesn't reach the parent Window.
         Pattern: stash the Window's DataContext (=MainViewModel) on the Border's Tag, then
         each MenuItem walks ContextMenu→PlacementTarget(=Border)→Tag to reach the commands.
         CommandParameter walks PlacementTarget.DataContext (=StudentViewModel of this card). -->
    <Border x:Name="CardRoot"
            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="{DynamicResource Surface.Card}"
            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
            CornerRadius="12" SnapsToDevicePixels="True"
            ClipToBounds="True"
            Cursor="Hand"
            MouseLeftButtonDown="Card_LeftClick"
            PreviewMouseRightButtonDown="Card_RightClick">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{DynamicResource Menu_ViewStudentScreen}"
                          Command="{Binding PlacementTarget.Tag.ViewStudentScreenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_LockScreen}"
                          Command="{Binding PlacementTarget.Tag.LockOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="{DynamicResource Menu_UnlockScreen}"
                          Command="{Binding PlacementTarget.Tag.UnlockOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_ApplyPolicyToStudent}"
                          Command="{Binding PlacementTarget.Tag.ApplyPolicyToStudentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="{DynamicResource Menu_RevertPolicyForStudent}"
                          Command="{Binding PlacementTarget.Tag.RevertPolicyForStudentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <!-- Phase 3 Section F: opening a Chat (DM tab in the right rail) replaces
                     the old Send-DM modal flow.  Modal still wired in MainViewModel for
                     backward compatibility but UI no longer surfaces it. -->
                <MenuItem Header="{DynamicResource Menu_Chat}"
                          Command="{Binding PlacementTarget.Tag.OpenDMConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_SetAsHost}"
                          Command="{Binding PlacementTarget.Tag.SetAsHostCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="{DynamicResource Menu_RemoveHost}"
                          Command="{Binding PlacementTarget.Tag.RemoveHostCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_StartDemo}"
                          Command="{Binding PlacementTarget.Tag.StartDemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <!-- StopDemoCommand is parameterless so no CommandParameter on this entry. -->
                <MenuItem Header="{DynamicResource Menu_StopDemo}"
                          Command="{Binding PlacementTarget.Tag.StopDemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <!-- AssignToRoom: outer MenuItem ports Tag onto itself so inner generated
                     MenuItems can read it via AncestorType=MenuItem.  Inner MenuItems' own
                     DataContext is the RoomViewModel (from ItemsSource); their Header binds
                     to RoomName and CommandParameter is the RoomViewModel itself. -->
                <MenuItem Header="{DynamicResource Menu_AssignToRoom}"
                          Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          ItemsSource="{Binding PlacementTarget.Tag.Rooms, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding RoomName}"/>
                            <Setter Property="Command"
                                    Value="{Binding Tag.AssignToRoomCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_RemoveFromRoom}"
                          Command="{Binding PlacementTarget.Tag.RemoveFromRoomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Logoff}"
                          Command="{Binding PlacementTarget.Tag.LogoffOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="{DynamicResource Menu_Restart}"
                          Command="{Binding PlacementTarget.Tag.RestartOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="{DynamicResource Menu_Shutdown}"
                          Command="{Binding PlacementTarget.Tag.ShutdownOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Screen preview, 16:10 area -->
                <RowDefinition Height="Auto"/>  <!-- Info bar -->
            </Grid.RowDefinitions>

            <!-- Screen preview area -->
            <Border Grid.Row="0" Background="#0D1224"
                    CornerRadius="11,11,0,0" ClipToBounds="True"
                    MinHeight="124">
                <Grid>
                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>

                    <!-- Top-left badge stack: room + per-student policy -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="6" Orientation="Vertical">
                        <Border Visibility="{Binding RoomBadgeVisibility}"
                                Background="{Binding RoomBadgeColorHex, Converter={StaticResource HexToBrush}}"
                                CornerRadius="3" Padding="6,2" Margin="0,0,0,2">
                            <TextBlock Text="{Binding RoomName}" Foreground="White"
                                       FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <Border Visibility="{Binding PerStudentPolicyBadgeVisibility}"
                                Background="#7C3AED" CornerRadius="3" Padding="6,2" Margin="0,0,0,2">
                            <TextBlock Text="{DynamicResource Lbl_PolicySet}" Foreground="White"
                                       FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <!-- Quality dot — small green/amber/red beside badges -->
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,2,0,0"
                                Background="{Binding QualityDotColorHex, Converter={StaticResource HexToBrush}}"
                                ToolTip="{DynamicResource Lbl_QualityScore}"/>
                    </StackPanel>

                    <!-- Top-center: Hand-raised banner (only visible when raised) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,6,0,0" Padding="8,2"
                            Background="#F59E0B" CornerRadius="3"
                            Visibility="{Binding HandRaisedVisibility}">
                        <TextBlock Text="{DynamicResource Lbl_HandRaised}"
                                   Foreground="White" FontWeight="Bold" FontSize="10"/>
                    </Border>

                    <!-- Top-right: Talking + Host badges -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="6" Orientation="Horizontal">
                        <Border Background="#F59E0B" CornerRadius="3" Padding="6,2" Margin="2,0,0,0"
                                Visibility="{Binding HostBadgeVisibility}"
                                ToolTip="{DynamicResource Lbl_Host}">
                            <TextBlock Text="👑 HOST" Foreground="White"
                                       FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <Border Background="#10B981" CornerRadius="3" Padding="4,2" Margin="2,0,0,0"
                                Visibility="{Binding TalkingBadgeVisibility}"
                                ToolTip="{DynamicResource Lbl_Talking}">
                            <TextBlock Text="🎤" Foreground="White" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- Bottom-right: REC button (only enabled when CanRecord) -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="6" Width="48" Height="22"
                            Background="{Binding RecButtonColorHex, Converter={StaticResource HexToBrush}}"
                            Foreground="White" BorderBrush="White" BorderThickness="1"
                            FontSize="9" FontWeight="Bold"
                            Content="{Binding RecButtonText}"
                            Opacity="{Binding RecOpacity}"
                            IsEnabled="{Binding CanRecord}"
                            Cursor="Hand" Padding="0"
                            ToolTip="{DynamicResource Tooltip_RecButton}"
                            Command="{Binding DataContext.ToggleStudentRecordingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Panel.ZIndex="100"/>
                </Grid>
            </Border>

            <!-- Info bar -->
            <Border Grid.Row="1" Background="{DynamicResource Surface.Card}" Padding="10,8">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MachineName}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Muted}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{DynamicResource Menu_ViewStudentScreen}"
                        Command="{Binding DataContext.ViewStudentScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <TextBlock Text="👁" FontSize="14"
                               Foreground="{DynamicResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
