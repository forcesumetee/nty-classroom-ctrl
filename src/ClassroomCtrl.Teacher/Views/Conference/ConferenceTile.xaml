<UserControl x:Class="ClassroomCtrl.Teacher.Views.Conference.ConferenceTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI"
             d:DesignWidth="340" d:DesignHeight="190">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>
    <!-- Phase 15-C — single conference tile.
         Outer Border carries the accent ring (active speaker / pinned).
         Inner Border is the 16:9 surface; webcam frame OR placeholder fills it.
         Bottom overlay: name + mic/cam state.
         Top-right slot: hand-raise badge placeholder (Phase 15-E wires).
         Click anywhere → PinCommand (forwarded by parent gallery DataTemplate). -->
    <Border x:Name="OuterBorder"
            CornerRadius="8" BorderThickness="2"
            BorderBrush="Transparent"
            Background="{DynamicResource Surface.Card}"
            Padding="0" Margin="8">
        <!-- Three style triggers in priority order:
             1. IsPinned=true        → purple accent (visual lock indicator)
             2. IsSpeaking=true      → green accent (active speaker)
             3. otherwise            → transparent (no accent) -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                        <Setter Property="BorderBrush" Value="#10B981"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Webcam frame area.  Cam-off placeholder is an Initial circle
                 with the first character of the display name. -->
            <Border Grid.Row="0" Background="#1F2937" CornerRadius="6,6,0,0">
                <Grid>
                    <!-- Frame, visible whenever we have a BitmapSource. -->
                    <Image Source="{Binding JpegFrame}" Stretch="Uniform"
                           Visibility="{Binding JpegFrame, Converter={StaticResource NullToVisibility}}"/>
                    <!-- Cam-off placeholder: large emoji centered.  Visible when
                         JpegFrame == null. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding JpegFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}">
                        <TextBlock Text="🚫" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13" Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"/>
                    </StackPanel>
                    <!-- Top-right: hand-raise badge slot.  15-E binds IsHandRaised. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6" Padding="6,2"
                            Background="#FBBF24" CornerRadius="999"
                            Visibility="{Binding IsHandRaised, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✋" FontSize="12"/>
                    </Border>

                    <!-- Phase 15-E step 4 — floating reaction emoji.  Shown for
                         ~3 s by MainViewModel.ShowReactionOnTile via a
                         DispatcherTimer.  Center-vertical so it draws over
                         the cam frame rather than the bottom name strip;
                         FontSize is large so it reads at a glance even on
                         a 4-up grid (~330 px wide tile).  When the source
                         CurrentReactionEmoji is empty, the empty-string
                         binding-target naturally renders blank. -->
                    <TextBlock Text="{Binding CurrentReactionEmoji}"
                               FontSize="56"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Name + indicators strip. -->
            <Border Grid.Row="1" Background="{DynamicResource Surface.Elevated}"
                    Padding="10,5" CornerRadius="0,0,6,6">
                <DockPanel>
                    <!-- Right cluster: mic + cam indicators. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Mic icon: green if live, grey otherwise. -->
                        <TextBlock Text="🎙" FontSize="13" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicLive}" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Cam icon: full opacity if cam live, dim otherwise. -->
                        <TextBlock Text="📷" FontSize="13" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCamLive}" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Name (with "(You)" suffix for self-tile). -->
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelfSuffix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
