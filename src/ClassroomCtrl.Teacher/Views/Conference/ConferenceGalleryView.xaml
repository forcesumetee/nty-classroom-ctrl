<UserControl x:Class="ClassroomCtrl.Teacher.Views.Conference.ConferenceGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
             xmlns:local="clr-namespace:ClassroomCtrl.Teacher.Views.Conference"
             xmlns:vm="clr-namespace:ClassroomCtrl.Teacher.ViewModels"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Background}"
             FontFamily="Segoe UI"
             d:DesignWidth="1280" d:DesignHeight="640">
    <!-- Phase 15-C — shared gallery surface used by:
           - Teacher's ConferenceView (data = MainViewModel.ConferenceGallery)
           - Student's ConferenceGalleryWindow (data = own thin gallery VM)
         Step 2 ships auto-layout only (UniformGrid with column count from
         ParticipantCountToColumnsConverter).  Pin (step 5) and pagination
         (step 7) extend this view; nothing else needs to change in the host
         containers. -->
    <UserControl.Resources>
        <conv:ParticipantCountToColumnsConverter x:Key="CountToColumns"/>
        <DataTemplate x:Key="ConferenceTileTemplate"
                      DataType="{x:Type vm:ConferenceTileViewModel}">
            <!-- Click anywhere on the tile to pin/unpin.  Forwarded via
                 PinCommand on the gallery VM; CommandParameter is the tile VM
                 itself.  Cursor=Hand so the affordance is discoverable. -->
            <Button Background="Transparent" BorderThickness="0"
                    Padding="0" Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Focusable="False" FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.PinCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <local:ConferenceTile/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Two mutually-exclusive layouts swapped by IsPinnedView:
           (a) Gallery: UniformGrid auto-layout (step 2 default).
           (b) Filmstrip: large primary tile (left ~75%) + scrolling column
               of small tiles on the right (~25%).
         Filmstrip uses CollectionViewSource sorting via a converter that
         filters by IsPinned isn't reliable in pure XAML, so we keep it
         simple: bind both layouts to the same Tiles collection; the small
         filmstrip ItemTemplate is the same ConferenceTile UserControl. -->
    <Grid Margin="12">
        <!-- (a) Gallery (auto-layout) — visible iff IsPinnedView == false. -->
        <ItemsControl ItemsSource="{Binding Tiles}"
                      ItemTemplate="{StaticResource ConferenceTileTemplate}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinnedView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="{Binding Tiles.Count,
                                          Converter={StaticResource CountToColumns}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- (b) Filmstrip — visible iff IsPinnedView == true. -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinnedView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Primary (pinned) tile.  ItemsControl bound to the same Tiles
                 list but filtered by IsPinned through a Style trigger
                 hiding non-pinned items. -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConferenceTileViewModel}">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Focusable="False" FocusVisualStyle="{x:Null}"
                                Cursor="Hand"
                                Command="{Binding DataContext.PinCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <local:ConferenceTile/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Filmstrip column.  All non-pinned tiles, scrollable. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConferenceTileViewModel}">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    Cursor="Hand"
                                    Height="120"
                                    Command="{Binding DataContext.PinCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <local:ConferenceTile/>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
