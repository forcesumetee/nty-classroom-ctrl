<UserControl x:Class="ClassroomCtrl.Teacher.Views.Conference.ConferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Background}"
             TextElement.Foreground="{DynamicResource Text.Primary}"
             FontFamily="Segoe UI"
             d:DesignWidth="1280" d:DesignHeight="640">
    <!-- Phase 15-B (MVP) — Conference shell skeleton.  Two visual states driven
         by MainViewModel.ConferenceSessionId == Guid.Empty:
           (a) "No active session" empty state with a single Start CTA.
           (b) "Conference in progress" placeholder with End button.
         Gallery + Meet toolbar + sidebar are 15-C / 15-D; this skeleton only
         proves the swap mechanism + the Start/End wire path. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <!-- (a) No active session — large centred Start CTA. -->
        <Grid Visibility="{Binding IsConferenceSessionActive,
                          Converter={StaticResource BoolToVisibility},
                          ConverterParameter=Inverted}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="📹"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Conf_EmptyTitle}"
                           Style="{DynamicResource Text.H1}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Conf_EmptyHint}"
                           Style="{DynamicResource Text.Body}"
                           Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,28"/>
                <Button Style="{DynamicResource Button.Primary}"
                        Command="{Binding StartConferenceCommand}"
                        Padding="32,12"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="14" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conf_StartConference}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource Conf_EmptyFooter}"
                           Style="{DynamicResource Text.Caption}"
                           Foreground="{DynamicResource Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- (b) Conference in progress — placeholder until 15-C lands the gallery. -->
        <Grid Visibility="{Binding IsConferenceSessionActive,
                          Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="🎥"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Conf_LiveTitle}"
                           Style="{DynamicResource Text.H1}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Conf_LiveHint}"
                           Style="{DynamicResource Text.Body}"
                           Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
            <!-- Bottom action bar (placeholder).  15-D replaces this with the
                 Meet-style ConferenceToolbar (mic / cam / share / chat / hand /
                 more / end).  Today: just End Conference. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Surface.Elevated}"
                    BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource Button.Danger}"
                            Command="{Binding EndConferenceCommand}"
                            Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📞" FontSize="13" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Conf_EndConference}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
