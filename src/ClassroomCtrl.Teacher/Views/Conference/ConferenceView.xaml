<UserControl x:Class="ClassroomCtrl.Teacher.Views.Conference.ConferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
             xmlns:confctrls="clr-namespace:ClassroomCtrl.Shared.Wpf.Conference;assembly=ClassroomCtrl.Shared.Wpf"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Background}"
             TextElement.Foreground="{DynamicResource Text.Primary}"
             FontFamily="Segoe UI"
             d:DesignWidth="1280" d:DesignHeight="640">
    <!-- Phase 15-B (MVP) — Conference shell skeleton.  Two visual states driven
         by MainViewModel.ConferenceSessionId == Guid.Empty:
           (a) "No active session" empty state with a single Start CTA.
           (b) "Conference in progress" placeholder with End button.
         Gallery + Meet toolbar + sidebar are 15-C / 15-D; this skeleton only
         proves the swap mechanism + the Start/End wire path. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <!-- (a) No active session — large centred Start CTA. -->
        <Grid Visibility="{Binding IsConferenceSessionActive,
                          Converter={StaticResource BoolToVisibility},
                          ConverterParameter=Inverted}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="📹"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Conf_EmptyTitle}"
                           Style="{DynamicResource Text.H1}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Conf_EmptyHint}"
                           Style="{DynamicResource Text.Body}"
                           Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,28"/>
                <Button Style="{DynamicResource Button.Primary}"
                        Command="{Binding StartConferenceCommand}"
                        Padding="32,12"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="14" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conf_StartConference}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource Conf_EmptyFooter}"
                           Style="{DynamicResource Text.Caption}"
                           Foreground="{DynamicResource Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- (b) Conference in progress — Phase 15-C gallery hosted here. -->
        <Grid Visibility="{Binding IsConferenceSessionActive,
                          Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Phase 15-D step 2 — gallery + sidebar overlay share Row 0.
                 The sidebar is positioned HorizontalAlignment=Right with a
                 fixed Width so the gallery tiles continue to render under
                 the left portion of the cell when the sidebar is open
                 (overlay, not push — gallery layout doesn't reflow on
                 sidebar toggle). -->
            <Grid Grid.Row="0">
                <confctrls:ConferenceGalleryView DataContext="{Binding ConferenceGallery}"/>

                <!-- Phase 15-D step 4 — in-Conference screen share visual.
                     The toolbar's 🖥 button (step 1) already invokes the
                     existing 11-B ShareScreenCommand; frames continue to
                     flow through TcpControlServer's _outbox (DropOldest 16)
                     unchanged.  We only add a top-banner indicator so the
                     teacher can see their share is live without having to
                     check the toolbar pill state.  The full "Shared Screen
                     tile + filmstrip reflow" is deferred until a customer
                     site needs the in-gallery preview (today the teacher
                     already monitors their share from the broadcaster's
                     own preview surface). -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,12,0,0" Padding="14,8"
                        CornerRadius="999"
                        Background="#10B981"
                        Visibility="{Binding IsScreenSharing,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conf_ScreenShareBanner}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <confctrls:ConferenceSidebar HorizontalAlignment="Right"
                                         Width="340"
                                         Visibility="{Binding IsConferenceSidebarVisible,
                                                      Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
            <!-- Phase 15-D step 1 — Meet-style toolbar replaces the 15-B
                 placeholder End-only bar.  The toolbar's commands route
                 through MainViewModel (this control's DataContext), so no
                 DataContext override needed on the slot. -->
            <confctrls:ConferenceToolbar Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
