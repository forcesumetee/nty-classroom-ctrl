<Window x:Class="ClassroomCtrl.Teacher.MicMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_MicMonitor}"
        Height="560" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 6 Section D — restructured: header / Surface.Card body, no
         footer needed because actions are per-row.  Listen toggle button
         label switches between "🎙 Toggle" and "🔊 Listening" via code-behind
         on click — those literals stay inline (set in C#) so the redesign
         doesn't need to know about the toggled state at XAML level. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🎙" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Btn_MicMonitor}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_MicMonitor}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Margin="20,16"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="8">
            <ListView x:Name="StudentList"
                      Background="Transparent"
                      Foreground="{DynamicResource Text.Primary}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource Lbl_StudentName}"
                                        Width="240"
                                        DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="{DynamicResource Lbl_RosterCol_Machine}"
                                        Width="200"
                                        DisplayMemberBinding="{Binding MachineName}"/>
                        <GridViewColumn Header="{DynamicResource Lbl_MicListen}"
                                        Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🎙 Toggle" Click="ToggleListen_Click" Tag="{Binding}"
                                            Style="{DynamicResource Button.Secondary}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
