<Window x:Class="ClassroomCtrl.Teacher.MicMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_MicMonitor}"
        Height="540" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Btn_MicMonitor}"
                   Style="{DynamicResource Text.H1}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top"
                   Style="{DynamicResource Text.Caption}"
                   Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Toggle Listen on each student to hear their microphone. Audio mixes in real time."/>

        <Border Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Surface.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.MD}">
            <ListView x:Name="StudentList"
                      Background="Transparent"
                      Foreground="{DynamicResource Text.Primary}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Student" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="Machine" Width="200" DisplayMemberBinding="{Binding MachineName}"/>
                        <GridViewColumn Header="Listen" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🎙 Toggle" Click="ToggleListen_Click" Tag="{Binding}"
                                            Style="{DynamicResource Button.Primary}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
