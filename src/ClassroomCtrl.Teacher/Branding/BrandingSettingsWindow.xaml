<Window x:Class="ClassroomCtrl.Teacher.Branding.BrandingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_BrandingSettings}"
        Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_ResetBranding}" Click="Reset_Click"
                    Style="{DynamicResource Button.Secondary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_Apply}" Click="Apply_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_Cancel}" Click="Cancel_Click"
                    Style="{DynamicResource Button.Secondary}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">

                    <!-- Phase 8 (Bug E) — Theme Mode toggle removed. Customer feedback:
                         the user-Primary brand color now drives the surface theme via
                         BrandingService (Bug B reversal), so a separate Light/Dark toggle
                         is redundant and was producing near-white "broken" UI on Light.
                         Dark is the single shipping theme; the ThemeMode property and
                         ApplyTheme infrastructure remain in place for back-compat with
                         existing branding.json files and for any future reactivation. -->

                    <TextBlock Text="{DynamicResource Lbl_AppName_Branding}"
                               Style="{DynamicResource Text.H3}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AppNameBox"
                             Style="{DynamicResource TextBox.Default}" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Lbl_OrgName}"
                               Style="{DynamicResource Text.H3}" Margin="0,0,0,4"/>
                    <TextBox x:Name="OrgNameBox"
                             Style="{DynamicResource TextBox.Default}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowOrgInTitleBox"
                              Style="{DynamicResource CheckBox.Default}"
                              Content="{DynamicResource Lbl_ShowOrgInTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Lbl_PrimaryColor}"
                               Style="{DynamicResource Text.H3}" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="PrimaryHexBox"
                                 Style="{DynamicResource TextBox.Default}"
                                 TextChanged="PrimaryHexBox_TextChanged"/>
                        <WrapPanel Grid.Column="1" Margin="8,0,0,0" x:Name="PrimarySwatches"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Lbl_AccentColor}"
                               Style="{DynamicResource Text.H3}" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="AccentHexBox"
                                 Style="{DynamicResource TextBox.Default}"
                                 TextChanged="AccentHexBox_TextChanged"/>
                        <WrapPanel Grid.Column="1" Margin="8,0,0,0" x:Name="AccentSwatches"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Lbl_Logo}"
                               Style="{DynamicResource Text.H3}" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="LogoPathBox"
                                 Style="{DynamicResource TextBox.Default}"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="{DynamicResource Btn_BrowseImage}"
                                Style="{DynamicResource Button.Secondary}"
                                Click="BrowseLogo_Click" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="✕"
                                Style="{DynamicResource Button.Icon}"
                                Click="ClearLogo_Click" Margin="4,0,0,0"
                                ToolTip="{DynamicResource Btn_ClearImage}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Lbl_Wallpaper}"
                               Style="{DynamicResource Text.H3}" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="WallpaperPathBox"
                                 Style="{DynamicResource TextBox.Default}"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="{DynamicResource Btn_BrowseImage}"
                                Style="{DynamicResource Button.Secondary}"
                                Click="BrowseWallpaper_Click" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="✕"
                                Style="{DynamicResource Button.Icon}"
                                Click="ClearWallpaper_Click" Margin="4,0,0,0"
                                ToolTip="{DynamicResource Btn_ClearImage}"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Live preview — Background colors here are set by code-behind to demo brand choices,
                 so we leave them as-is. Only the wrapping Border BorderBrush is themed. -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadius.MD}"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="PreviewBanner" Background="#1E40AF" Padding="10,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image x:Name="PreviewLogo" Height="24" Margin="0,0,8,0" Stretch="Uniform"/>
                            <TextBlock x:Name="PreviewBannerText" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PreviewSidebar" Background="#1E3A8A" Width="120" DockPanel.Dock="Left">
                        <StackPanel Margin="8,12">
                            <TextBlock x:Name="PreviewSideText" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border x:Name="PreviewBtn" Background="#3B82F6" Padding="6,4" CornerRadius="4">
                                <TextBlock x:Name="PreviewBtnText" Foreground="White" FontSize="11" Text="Sample Button"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PreviewWallpaper" Background="#1A1A1A">
                        <TextBlock Text="🔒" FontSize="48" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
