<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Hdr_MarkAttendance}"
        Height="640" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 7 Section D — Mark Attendance dialog.  Header (📋 + class name) /
         Surface.Card DataGrid with per-row Present/Absent/Late/Excused radios /
         pinned footer with live stats + Export Excel + Cancel + Save. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="📋" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Hdr_MarkAttendance}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock x:Name="ClassNameText"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Margin="20,16"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="StudentsGrid"
                      Style="{DynamicResource DataGrid.Default}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Lbl_FullName}"
                                        Binding="{Binding FullName}"
                                        Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource Lbl_StudentNumber}"
                                        Binding="{Binding StudentNumber}"
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource Lbl_RosterCol_Machine}"
                                        Binding="{Binding MachineName}"
                                        Width="140" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="{DynamicResource Lbl_AttendanceStatus}"
                                            Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Phase 7.3 hotfix: pin UpdateSourceTrigger=PropertyChanged on each
                                     IsChecked binding so the click→property write is synchronous.  The
                                     RadioButton.IsChecked default trigger is generally PropertyChanged,
                                     but we make it explicit here to rule out the rare case where a
                                     parent style changes it to Default/LostFocus and Save_Click runs
                                     before the radio's binding has flushed. -->
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <RadioButton Content="{DynamicResource Lbl_Present}"
                                                 GroupName="{Binding RowId}"
                                                 IsChecked="{Binding IsPresent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="{DynamicResource Lbl_Absent}"
                                                 GroupName="{Binding RowId}"
                                                 IsChecked="{Binding IsAbsent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"
                                                 Margin="10,0,0,0"/>
                                    <RadioButton Content="{DynamicResource Lbl_Late}"
                                                 GroupName="{Binding RowId}"
                                                 IsChecked="{Binding IsLate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"
                                                 Margin="10,0,0,0"/>
                                    <RadioButton Content="{DynamicResource Lbl_Excused}"
                                                 GroupName="{Binding RowId}"
                                                 IsChecked="{Binding IsExcused, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"
                                                 Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           x:Name="StatsText"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="12" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Save}"
                        Click="Save_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_ExportExcel}"
                        Click="ExportExcel_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
