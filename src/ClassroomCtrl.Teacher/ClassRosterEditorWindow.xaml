<Window x:Class="ClassroomCtrl.Teacher.ClassRosterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_ClassRosterEditor}"
        Height="640" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource Lbl_ClassNameField}"
                       Style="{DynamicResource Text.Body}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="ClassNameBox"
                     Style="{DynamicResource TextBox.Default}"
                     Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource Lbl_Description}"
                       Style="{DynamicResource Text.Body}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox"
                     Style="{DynamicResource TextBox.Default}"
                     Margin="0,0,0,16"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_AddFromConnected}" Click="AddFromConnected_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_AddRow}" Click="AddRow_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_DeleteRow}" Click="DeleteRow_Click"
                    Style="{DynamicResource Button.Danger}" Margin="0,0,16,0"/>
            <Button Content="{DynamicResource Btn_Save}" Click="Save_Click"
                    Style="{DynamicResource Button.Success}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_Cancel}" Click="Cancel_Click"
                    Style="{DynamicResource Button.Secondary}"/>
        </StackPanel>

        <DataGrid x:Name="StudentsGrid"
                  Style="{DynamicResource DataGrid.Default}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassNameTh}" Width="100"/>
                <DataGridTextColumn Header="No." Binding="{Binding StudentNumber}" Width="80"/>
                <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
