<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.ClassRosterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_ClassRosterEditor}"
        Height="680" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 5 Section A — same 3-row layout as the Manager window: header /
         body (form fields + students grid) / pinned footer. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="📋" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_ClassRosterEditor}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_RosterEditor}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Form fields -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Lbl_ClassNameField}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ClassNameBox"
                         Style="{DynamicResource TextBox.Default}" Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Lbl_Description}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionBox"
                         Style="{DynamicResource TextBox.Default}"/>
            </StackPanel>

            <!-- Students section header + add buttons -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="{DynamicResource Btn_AddFromConnected}"
                            Click="AddFromConnected_Click" Margin="0,0,8,0"/>
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="{DynamicResource Btn_AddRow}"
                            Click="AddRow_Click"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Lbl_RosterStudents}"
                           Style="{DynamicResource Text.H3}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Students grid -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="StudentsGrid"
                          Style="{DynamicResource DataGrid.Default}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Lbl_FullName}"
                                            Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_RosterCol_Class}"
                                            Binding="{Binding ClassNameTh}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_StudentNumber}"
                                            Binding="{Binding StudentNumber}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Lbl_RosterCol_Machine}"
                                            Binding="{Binding MachineName}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Danger}"
                        Content="{DynamicResource Btn_DeleteRow}"
                        Click="DeleteRow_Click"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Save}"
                        Click="Save_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
