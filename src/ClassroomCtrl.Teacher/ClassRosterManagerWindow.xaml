<Window x:Class="ClassroomCtrl.Teacher.ClassRosterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_ClassRosterManager}"
        Height="540" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Lbl_ClassRosterManager}"
                   Style="{DynamicResource Text.H1}" Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_NewRoster}" Click="New_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OpenRoster}" Click="Open_Click"
                    Style="{DynamicResource Button.Secondary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_DeleteRoster}" Click="Delete_Click"
                    Style="{DynamicResource Button.Danger}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_ImportRoster}" Click="Import_Click"
                    Style="{DynamicResource Button.Secondary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_ExportRoster}" Click="Export_Click"
                    Style="{DynamicResource Button.Secondary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_ActivateRoster}" Click="Activate_Click"
                    Style="{DynamicResource Button.Success}"/>
        </StackPanel>

        <Border Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Surface.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.MD}">
            <ListView x:Name="RosterList"
                      Background="Transparent"
                      Foreground="{DynamicResource Text.Primary}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Class" Width="160" DisplayMemberBinding="{Binding ClassName}"/>
                        <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}"/>
                        <GridViewColumn Header="Students" Width="100" DisplayMemberBinding="{Binding Students.Count}"/>
                        <GridViewColumn Header="Last used" Width="180" DisplayMemberBinding="{Binding LastUsedAt}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
