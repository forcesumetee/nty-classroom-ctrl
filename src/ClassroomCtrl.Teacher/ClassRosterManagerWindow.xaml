<Window x:Class="ClassroomCtrl.Teacher.ClassRosterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_ClassRosterManager}"
        Height="600" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 5 Section A — restructured to match Phase 4 dialog design language:
         pinned header (icon bubble + title + hint) / body (Surface.Card list) /
         pinned footer (Danger + I/O on left, proceed actions on right). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="📋" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_ClassRosterManager}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_RosterManager}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Margin="20,16"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="8">
            <ListView x:Name="RosterList"
                      Background="Transparent"
                      Foreground="{DynamicResource Text.Primary}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource Lbl_RosterCol_Class}" Width="160"
                                        DisplayMemberBinding="{Binding ClassName}"/>
                        <GridViewColumn Header="{DynamicResource Lbl_Description}" Width="280"
                                        DisplayMemberBinding="{Binding Description}"/>
                        <GridViewColumn Header="{DynamicResource Lbl_RosterCol_Students}" Width="100"
                                        DisplayMemberBinding="{Binding Students.Count}"/>
                        <GridViewColumn Header="{DynamicResource Lbl_RosterCol_LastUsed}" Width="180"
                                        DisplayMemberBinding="{Binding LastUsedAt}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <!-- Left: destructive + I/O actions -->
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Danger}"
                        Content="{DynamicResource Btn_DeleteRoster}"
                        Click="Delete_Click"/>
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_ImportRoster}"
                        Click="Import_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_ExportRoster}"
                        Click="Export_Click" Margin="8,0,0,0"/>
                <!-- Right: proceed actions (XAML right-to-left visually = New, Edit, Activate) -->
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_ActivateRoster}"
                        Click="Activate_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_OpenRoster}"
                        Click="Open_Click" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_NewRoster}"
                        Click="New_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
