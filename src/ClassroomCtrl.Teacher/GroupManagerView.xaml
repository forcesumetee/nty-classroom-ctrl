<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.GroupManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClassroomCtrl.Teacher.Converters"
        Title="{DynamicResource Btn_BreakoutRooms}"
        Height="640" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:EndpointToDisplayNameConverter x:Key="EndpointToDisplayNameConverter"/>
    </Window.Resources>
    <DockPanel Margin="14">

        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{DynamicResource Btn_BreakoutRooms}"
                   Style="{DynamicResource Text.H1}"
                   Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top"
                   Style="{DynamicResource Text.Caption}"
                   Margin="0,0,0,12"
                   Text="{DynamicResource GroupMgr_Caption}"/>

        <!-- Top action row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnCreateRandom" Click="CreateRandom_Click"
                    Style="{DynamicResource Button.Primary}"
                    Content="{DynamicResource GroupMgr_CreateRandom}"
                    Margin="0,0,8,0"/>
            <Button x:Name="BtnNewEmpty" Click="NewEmpty_Click"
                    Style="{DynamicResource Button.Secondary}"
                    Content="{DynamicResource GroupMgr_NewEmpty}"
                    Margin="0,0,8,0"/>
            <Button x:Name="BtnAutoBalance" Click="AutoBalance_Click"
                    Style="{DynamicResource Button.Secondary}"
                    Content="{DynamicResource GroupMgr_AutoBalance}"
                    Margin="0,0,8,0"/>
            <Button x:Name="BtnDissolveAll" Click="DissolveAll_Click"
                    Style="{DynamicResource Button.Danger}"
                    Content="{DynamicResource GroupMgr_DissolveAll}"/>
        </StackPanel>

        <!-- Bottom template row -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnSaveTemplate" Click="SaveTemplate_Click"
                    Style="{DynamicResource Button.Secondary}"
                    Content="{DynamicResource GroupMgr_SaveTemplate}"
                    Margin="0,0,8,0"/>
            <Button x:Name="BtnLoadTemplate" Click="LoadTemplate_Click"
                    Style="{DynamicResource Button.Secondary}"
                    Content="{DynamicResource GroupMgr_LoadTemplate}"/>
        </StackPanel>

        <!-- Scrollable body: groups + unassigned -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Groups -->
                <ItemsControl x:Name="RoomsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface.Elevated}"
                                    Padding="12" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource Surface.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadius.MD}">
                                <DockPanel>
                                    <!-- Right action stack -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="Join_Click" Tag="{Binding}"
                                                Style="{DynamicResource Button.Primary}"
                                                Content="{DynamicResource GroupMgr_Join}"
                                                Margin="0,0,4,0"/>
                                        <Button Click="ShareToggle_Click" Tag="{Binding}"
                                                Style="{DynamicResource Button.Secondary}"
                                                Margin="0,0,4,0">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource GroupMgr_Share}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsShareActive}" Value="True">
                                                                <Setter Property="Text" Value="{DynamicResource GroupMgr_StopShare}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Click="GroupMenu_Click" Tag="{Binding}"
                                                Content="⋮"
                                                Style="{DynamicResource Button.Secondary}"
                                                MinWidth="32"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <!-- Header row: name + member count + host indicator + joined badge -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Style="{DynamicResource Text.H3}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                                <Run Text="{Binding RoomName}"/>
                                                <Run Text="  ("/>
                                                <Run Text="{Binding MemberIds.Count}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                            <TextBlock VerticalAlignment="Center"
                                                       Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTeacherJoined}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="• "/>
                                                <Run Text="{DynamicResource GroupMgr_JoinedBadge}"/>
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- Member chips -->
                                        <ItemsControl x:Name="MembersList" Tag="{Binding RoomId}"
                                                      ItemsSource="{Binding MemberIds}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Surface.Background}"
                                                            Padding="8,4" Margin="0,0,4,4"
                                                            BorderBrush="{DynamicResource Surface.Border}" BorderThickness="1"
                                                            CornerRadius="{DynamicResource CornerRadius.SM}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Click="MemberChipName_Click" Tag="{Binding}"
                                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                                    Cursor="Hand">
                                                                <TextBlock Text="{Binding Converter={StaticResource EndpointToDisplayNameConverter}}"
                                                                           VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Click="MemberChipRemove_Click" Tag="{Binding}"
                                                                    Content="✕" Background="Transparent" BorderThickness="0"
                                                                    Padding="6,0,0,0" Cursor="Hand"
                                                                    Foreground="{DynamicResource Text.Secondary}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Unassigned section -->
                <Border Background="{DynamicResource Surface.Elevated}"
                        Padding="12" Margin="0,8,0,0"
                        BorderBrush="{DynamicResource Surface.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.MD}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.H3}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6">
                            <Run Text="{DynamicResource GroupMgr_Unassigned}"/>
                            <Run Text="  ("/>
                            <Run x:Name="UnassignedCountText" Text="0"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <ItemsControl x:Name="UnassignedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface.Background}"
                                            Padding="8,4" Margin="0,0,4,4"
                                            BorderBrush="{DynamicResource Surface.Border}" BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadius.SM}">
                                        <Button Click="UnassignedChip_Click" Tag="{Binding EndpointId}"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
