<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ClassroomCtrl.Teacher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Phase 10.13 — switched primary .ico to multi-resolution classroom_icon.ico
         (added in commit 2e321bb). The old logo.ico stays on disk for legacy refs. -->
    <ApplicationIcon>Assets\classroom_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- Phase 10.13 — embed classroom_icon.ico as a WPF Resource for window-chrome use. -->
    <Resource Include="Assets\classroom_icon.ico" />
    <None Include="Assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\classroom_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClassroomCtrl.Shared\ClassroomCtrl.Shared.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Shared.Wpf\ClassroomCtrl.Shared.Wpf.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Networking\ClassroomCtrl.Networking.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Licensing\ClassroomCtrl.Licensing.csproj" />
    <ProjectReference Include="..\ClassroomCtrl.Exam.Shared\ClassroomCtrl.Exam.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Phase 10.14 (Item 9) — same H.NotifyIcon.Wpf used in Student.Agent for its
         tray icon.  Teacher now uses it solely as a notification surface for chat
         arriving while the window is hidden/minimized/unfocused; not in solution
         lock files as a new top-level dep — Agent already references this version. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.131" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NReco.VideoConverter" Version="1.2.1" />
  </ItemGroup>
</Project>
