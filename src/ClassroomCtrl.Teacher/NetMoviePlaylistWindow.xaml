<Window x:Class="ClassroomCtrl.Teacher.NetMoviePlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_NetMovie}"
        Height="540" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{DynamicResource Btn_AddFile}" Click="AddFile_Click"
                    Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_RemoveFile}" Click="RemoveFile_Click"
                    Style="{DynamicResource Button.Danger}" Margin="0,0,8,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="▶ Play" Click="Play_Click"
                    Style="{DynamicResource Button.Success}" Margin="0,0,8,0"/>
            <Button Content="⏸ Pause" Click="Pause_Click"
                    Style="{DynamicResource Button.Secondary}" Margin="0,0,8,0"/>
            <Button Content="⏹ Stop" Click="Stop_Click"
                    Style="{DynamicResource Button.Danger}" Margin="0,0,8,0"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Style="{DynamicResource Text.Caption}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <Border Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Surface.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.MD}">
            <ListBox x:Name="PlaylistBox"
                     Style="{DynamicResource ListBox.Default}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Style="{DynamicResource Text.Body}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
