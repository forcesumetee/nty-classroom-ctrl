<Window x:Class="ClassroomCtrl.Teacher.NetMoviePlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_NetMovie}"
        Height="600" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 6 Section C — restructured: header / body (toolbar + Surface.Card
         playlist + status) / pinned footer with playback transport.  No video
         viewport here; this window is a *broadcast playlist*: the selected file
         is uploaded to every connected student via the FileTransfer protocol,
         then a synchronised MoviePlay message starts playback on each student. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🎬" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Btn_NetMovie}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_NetMovie}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Playlist toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_AddFile}"
                        Click="AddFile_Click" Margin="0,0,8,0"/>
                <Button Style="{DynamicResource Button.Danger}"
                        Content="{DynamicResource Btn_RemoveFile}"
                        Click="RemoveFile_Click"/>
            </StackPanel>

            <!-- Playlist -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="8">
                <ListBox x:Name="PlaylistBox"
                         Style="{DynamicResource ListBox.Default}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{DynamicResource Text.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,6"
                                       ToolTip="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Status -->
            <TextBlock Grid.Row="2" x:Name="StatusText"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </Grid>

        <!-- Footer — playback transport -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Danger}"
                        Content="{DynamicResource Btn_Stop}"
                        Click="Stop_Click"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Play}"
                        Click="Play_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_Pause}"
                        Click="Pause_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
