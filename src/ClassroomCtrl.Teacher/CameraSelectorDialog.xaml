<Window x:Class="ClassroomCtrl.Teacher.CameraSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_CameraSelector}"
        Height="380" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 6 Section B — restructured: header / body / pinned footer to match
         the Phase 4-5 dialog design language.  Camera SELECTOR (single-device
         picker) — there is no multi-student camera-monitor window in this build,
         so this is the only camera-related dialog. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="📷" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_CameraSelector}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Hint_CameraSelector}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <TextBlock Text="{DynamicResource Lbl_CameraDevice}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="DeviceCombo"
                      Style="{DynamicResource ComboBox.Default}"
                      Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Lbl_Resolution}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ResolutionCombo"
                              Style="{DynamicResource ComboBox.Default}">
                        <ComboBoxItem Content="320 × 240"/>
                        <ComboBoxItem Content="640 × 480" IsSelected="True"/>
                        <ComboBoxItem Content="1280 × 720"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource Lbl_FrameRate}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FpsCombo"
                              Style="{DynamicResource ComboBox.Default}">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10" IsSelected="True"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="30"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Surface.Elevated}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_StartCamera}"
                        Click="Start_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
