<Window x:Class="ClassroomCtrl.Teacher.Settings.AdminPasswordSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_AdminPasswordSettings_Title}"
        Height="540" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface.Elevated}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 4 Section G — restructured: header / body / footer with the same idiom
         as Apply Policy (Section E) and Branding (Section F).  Body has an info banner
         calling out HKCU vs deployment .reg before the password fields. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🔒" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lbl_AdminPasswordSettings_Title}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Lbl_AdminPasswordSettings_HintShort}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <!-- Info banner — full deployment caveat (HKCU + Export .reg) -->
            <Border Background="{DynamicResource Accent.PrimarySubtle}"
                    BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="ℹ️" FontSize="14"
                               VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock Text="{DynamicResource Lbl_AdminPasswordSettings_Hint}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <TextBlock Text="{DynamicResource Lbl_NewPassword}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Style="{DynamicResource PasswordBox.Default}"
                         Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Lbl_ConfirmPassword}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Style="{DynamicResource PasswordBox.Default}"
                         Margin="0,0,0,0"/>

            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer — Reset (danger left) | Export .reg (secondary left) | Cancel | Save -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Danger}"
                        Content="{DynamicResource Btn_ResetToDefault}"
                        Click="Reset_Click"/>
                <!-- Phase 8 (Bug F): multi-machine .reg deployment side-channel. -->
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Secondary}"
                        Content="{DynamicResource Btn_ExportRegFile}"
                        Click="ExportReg_Click"
                        ToolTip="{DynamicResource Tooltip_ExportReg}"
                        Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Save}"
                        Click="Save_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
