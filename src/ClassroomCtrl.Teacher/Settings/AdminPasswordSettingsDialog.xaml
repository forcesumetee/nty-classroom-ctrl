<Window x:Class="ClassroomCtrl.Teacher.Settings.AdminPasswordSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_AdminPasswordSettings_Title}"
        Height="420" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Run.Text does NOT honour DynamicResource (Run is a Freezable that doesn't
             join the resource lookup chain) so the markup leaked through as literal text.
             Split into two TextBlocks: emoji literal + bind on the localised title. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="🔒  " Style="{DynamicResource Text.H2}"/>
            <TextBlock Text="{DynamicResource Lbl_AdminPasswordSettings_Title}"
                       Style="{DynamicResource Text.H2}"/>
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Style="{DynamicResource Text.Caption}"
                   Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="{DynamicResource Lbl_AdminPasswordSettings_Hint}"/>

        <TextBlock Grid.Row="2" Text="{DynamicResource Lbl_NewPassword}"
                   Style="{DynamicResource Text.Body}"
                   Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="3" x:Name="NewPasswordBox"
                     Style="{DynamicResource PasswordBox.Default}"
                     Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource Lbl_ConfirmPassword}"
                   Style="{DynamicResource Text.Body}"
                   Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="5" x:Name="ConfirmPasswordBox"
                     Style="{DynamicResource PasswordBox.Default}"/>

        <TextBlock Grid.Row="6" x:Name="StatusText"
                   Style="{DynamicResource Text.Body}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn_ResetToDefault}"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="0,0,8,0" Click="Reset_Click"/>
            <!-- Phase 8 (Bug F) — multi-machine deployment: Teacher's HKCU hash doesn't
                 reach Student PCs without GPO. Export .reg lets the customer side-channel
                 the same hash via USB / network share until a real distribution path exists. -->
            <Button Content="{DynamicResource Btn_ExportRegFile}"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="0,0,8,0" Click="ExportReg_Click"
                    ToolTip="{DynamicResource Tooltip_ExportReg}"/>
            <Button Content="{DynamicResource Btn_Cancel}"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource Btn_Save}"
                    Style="{DynamicResource Button.Primary}"
                    Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
