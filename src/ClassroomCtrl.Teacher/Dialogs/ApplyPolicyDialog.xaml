<Window Icon="/Assets/logo.png" x:Class="ClassroomCtrl.Teacher.Dialogs.ApplyPolicyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Dlg_ApplyPolicyTitle}"
        Height="640" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface.Elevated}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Phase 4 Section E — restructure: header / scrollable body / pinned footer.
         Layout matches the target mockup (icon bubble + title + helper text on top;
         action buttons split between Revert (left, danger) and Cancel/Apply (right). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36"
                        Background="{DynamicResource Accent.PrimarySubtle}"
                        CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🛡" FontSize="18"
                               Foreground="{DynamicResource Accent.Primary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Dlg_ClassroomPolicy}"
                               Style="{DynamicResource Text.H2}"/>
                    <TextBlock Text="{DynamicResource Dlg_PolicyHint}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body — Phase 7 Section B: spacing breathe.  ScrollViewer Padding 20,16
             → 24,20; per-block bottom margin 12 → 18 (16 for the last description
             before a TextBox); description top-margin tightened (no change) but
             TextBox top-gap from caption 0 → 6 so the input has its own space. -->
        <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Block USB -->
                <CheckBox x:Name="UsbCheck" Style="{DynamicResource CheckBox.Default}"
                          Content="{DynamicResource Dlg_BlockUSB}" FontSize="13"
                          FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Dlg_BlockUSBDesc}"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,18"/>

                <!-- Block CD/DVD -->
                <CheckBox x:Name="OpticalCheck" Style="{DynamicResource CheckBox.Default}"
                          Content="{DynamicResource Dlg_BlockCD}" FontSize="13"
                          FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Dlg_BlockCDDesc}"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,18"/>

                <!-- Block Print -->
                <CheckBox x:Name="PrintCheck" Style="{DynamicResource CheckBox.Default}"
                          Content="{DynamicResource Dlg_BlockPrint}" FontSize="13"
                          FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Dlg_BlockPrintDesc}"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,18"/>

                <!-- Block Apps -->
                <CheckBox x:Name="AppsCheck" Style="{DynamicResource CheckBox.Default}"
                          Content="{DynamicResource Dlg_BlockApps}" FontSize="13"
                          FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Dlg_BlockAppsDesc}"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,6"/>
                <TextBox x:Name="AppsList"
                         Style="{DynamicResource TextBox.Default}"
                         Margin="22,0,0,20"
                         FontSize="12"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="chrome.exe, notepad.exe, game.exe"/>

                <!-- Block Sites -->
                <CheckBox x:Name="HostsCheck" Style="{DynamicResource CheckBox.Default}"
                          Content="{DynamicResource Dlg_BlockSites}" FontSize="13"
                          FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Dlg_BlockSitesDesc}"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,6"/>
                <TextBox x:Name="HostsList"
                         Style="{DynamicResource TextBox.Default}"
                         Margin="22,0,0,20"
                         FontSize="12"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="facebook.com, youtube.com, tiktok.com"/>

                <!-- Auto-revert duration card -->
                <Border Background="{DynamicResource Surface.Background}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{DynamicResource Dlg_PolicyDuration}"
                                   FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox x:Name="DurationCombo"
                                  Style="{DynamicResource ComboBox.Default}"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Right" Width="200">
                            <ComboBoxItem Content="{DynamicResource Dlg_DurationNoLimit}" Tag="0"/>
                            <ComboBoxItem Content="{DynamicResource Dlg_Duration15min}" Tag="900"/>
                            <ComboBoxItem Content="{DynamicResource Dlg_Duration30min}" Tag="1800"/>
                            <ComboBoxItem Content="{DynamicResource Dlg_Duration1hr}" Tag="3600"/>
                            <ComboBoxItem Content="{DynamicResource Dlg_Duration2hr}" Tag="7200"/>
                        </ComboBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource Button.Danger}"
                        Content="{DynamicResource Btn_RevertAll}"
                        Click="Revert_Click"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Primary}"
                        Content="{DynamicResource Btn_Apply}"
                        Click="Apply_Click" IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Ghost}"
                        Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
