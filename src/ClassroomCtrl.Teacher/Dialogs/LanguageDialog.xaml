<Window x:Class="ClassroomCtrl.Teacher.Dialogs.LanguageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Btn_Language}"
        Height="420" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface.Background}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Btn_Language}"
                   Style="{DynamicResource Text.H2}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{DynamicResource Surface.Elevated}"
                BorderBrush="{DynamicResource Surface.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.MD}">
            <ListBox x:Name="LanguageList"
                     Style="{DynamicResource ListBox.Default}"
                     SelectionMode="Single"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Style="{DynamicResource Button.Secondary}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK"
                    Style="{DynamicResource Button.Primary}"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>