<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassroomCtrl.Student.Mac.Agent.ViewModels"
        x:Class="ClassroomCtrl.Student.Mac.Agent.Views.ChatWindow"
        x:DataType="vm:ChatViewModel"
        Title="Class Chat"
        Width="420" Height="520" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <!-- Modern-government chat: one clean column, high-contrast bubbles, restrained navy accent,
         clear speaker/time hierarchy, no chrome beyond the standard resizable/minimizable frame. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1" Padding="18,13">
            <TextBlock Text="Class Chat" FontSize="15" FontWeight="SemiBold" Foreground="#16181D"/>
        </Border>

        <!-- Message history -->
        <ScrollViewer Grid.Row="1" Name="Scroll" Padding="8,10"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatEntry">
                        <Border Margin="8,4" Padding="11,8" CornerRadius="10" MaxWidth="300"
                                Background="{Binding BubbleBrush}"
                                HorizontalAlignment="{Binding Alignment}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding SubtleBrush}"/>
                                <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap"
                                           Foreground="{Binding TextBrush}"/>
                                <TextBlock Text="{Binding Time}" FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{Binding SubtleBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Composer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding Draft}" PlaceholderText="Type a message…"
                         VerticalContentAlignment="Center" CornerRadius="8" MaxLength="2000">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}"
                        Background="#1B3A6B" Foreground="White" FontWeight="SemiBold"
                        Padding="18,0" CornerRadius="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
