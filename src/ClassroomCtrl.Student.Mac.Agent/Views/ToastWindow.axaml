<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassroomCtrl.Student.Mac.Agent.Views.ToastWindow"
        Width="360" SizeToContent="Height"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- Modern-government toast: a single high-contrast card, restrained palette, clear
         two-line hierarchy (title + detail), a status accent bar, no chrome or clutter.
         The 14px margin leaves room for the soft drop shadow on the transparent window. -->
    <Border Margin="14"
            CornerRadius="10"
            Background="#FFFFFF"
            BorderBrush="#DADCE0"
            BorderThickness="1"
            BoxShadow="0 8 28 0 #2E000000">
        <Grid ColumnDefinitions="5,*">
            <!-- Status accent bar -->
            <Border Grid.Column="0"
                    x:Name="Accent"
                    Background="#1B3A6B"
                    CornerRadius="10,0,0,10"/>

            <StackPanel Grid.Column="1" Margin="18,15" Spacing="5">
                <TextBlock x:Name="TitleText"
                           Text="Notification"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="#16181D"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MessageText"
                           Text=""
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="#4A4E57"
                           TextWrapping="Wrap"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
