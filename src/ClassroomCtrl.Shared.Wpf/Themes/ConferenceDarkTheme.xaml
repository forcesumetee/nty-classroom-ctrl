<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
    Phase 22 — centralized Conference Mode dark-theme design tokens.

    Every Conference XAML surface (Tile, Toolbar, Sidebar, ShareView, the
    student ConferenceGalleryWindow chrome, the teacher ConferenceView
    chrome, and the Phase 21 sharing pill) draws colors / spacing / radii
    from THIS file.  No hardcoded hex outside this dictionary — touching
    the palette is a one-file edit.

    Naming convention: Conf*Brush / Conf*Color / Conf*Radius / Conf*Padding
    so a future second theme (e.g. light) can sit in parallel without
    colliding on bare names.
    -->

    <!-- ============ BACKGROUNDS ============ -->
    <SolidColorBrush x:Key="ConfWindowBgBrush"     Color="#1F1F23"/>
    <SolidColorBrush x:Key="ConfTitleBarBgBrush"   Color="#17171A"/>
    <SolidColorBrush x:Key="ConfTileBgBrush"       Color="#2D2D33"/>
    <SolidColorBrush x:Key="ConfTileLiveBgBrush"   Color="#1A1A1E"/>
    <SolidColorBrush x:Key="ConfToolbarBgBrush"    Color="#28282E"/>
    <SolidColorBrush x:Key="ConfSidebarBgBrush"    Color="#1A1A1E"/>
    <SolidColorBrush x:Key="ConfChatOwnBubbleBrush"   Color="#2D2D33"/>
    <SolidColorBrush x:Key="ConfChatOtherBubbleBrush" Color="#1F1F23"/>
    <SolidColorBrush x:Key="ConfChatInputBgBrush"     Color="#2D2D33"/>

    <!-- Overlays -->
    <SolidColorBrush x:Key="ConfStatusBarBgBrush"  Color="#000000" Opacity="0.6"/>
    <SolidColorBrush x:Key="ConfHoverOverlayBrush" Color="#FFFFFF" Opacity="0.08"/>

    <!-- ============ TEXT ============ -->
    <SolidColorBrush x:Key="ConfTextPrimaryBrush"   Color="#E8EAED"/>
    <SolidColorBrush x:Key="ConfTextSecondaryBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="ConfTextDisabledBrush"  Color="#5F6368"/>

    <!-- ============ ACCENTS ============ -->
    <SolidColorBrush x:Key="ConfAccentYellowBrush" Color="#FBBC04"/>  <!-- Speaking ring, hand raise -->
    <SolidColorBrush x:Key="ConfAccentGreenBrush"  Color="#34A853"/>  <!-- Active mic, share-on toolbar -->
    <SolidColorBrush x:Key="ConfAccentBlueBrush"   Color="#4285F4"/>  <!-- Host badge stroke + sidebar tab -->
    <SolidColorBrush x:Key="ConfAccentBluePale"    Color="#8AB4F8"/>  <!-- Host badge text -->
    <SolidColorBrush x:Key="ConfAccentRedBrush"    Color="#EA4335"/>  <!-- Cam off, End/Leave, sharing pulse -->

    <!-- Semi-transparent accent backgrounds -->
    <SolidColorBrush x:Key="ConfHostBadgeBgBrush"  Color="#4285F4" Opacity="0.2"/>

    <!-- ============ BORDERS ============ -->
    <SolidColorBrush x:Key="ConfBorderSubtleBrush" Color="#3C3C44"/>
    <SolidColorBrush x:Key="ConfBorderHoverBrush"  Color="#5F6368"/>
    <SolidColorBrush x:Key="ConfBorderActiveBrush" Color="#FBBC04"/>  <!-- Speaking ring on tile -->

    <!-- ============ TYPOGRAPHY ============ -->
    <FontFamily x:Key="ConfFontFamily">Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>

    <sys:Double x:Key="ConfFontSizeTileName">36</sys:Double>
    <sys:Double x:Key="ConfFontSizeStatus">12</sys:Double>
    <sys:Double x:Key="ConfFontSizeBadge">11</sys:Double>

    <!-- ============ LAYOUT ============ -->
    <CornerRadius x:Key="ConfTileCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ConfStatusBarRadius">13</CornerRadius>
    <CornerRadius x:Key="ConfToolbarCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="ConfBadgeCornerRadius">11</CornerRadius>
    <CornerRadius x:Key="ConfButtonCornerRadius">20</CornerRadius>

    <Thickness x:Key="ConfTilePadding">16</Thickness>
    <Thickness x:Key="ConfStatusBarPadding">12,5</Thickness>

    <!-- ============ TOOLBAR BUTTON STYLE ============
         Compact circular pill button used by every ConferenceToolbar entry
         (mic, cam, share, chat, hand raise, more).  Active state (mic-on,
         share-on) gets a filled green via the per-button DataTrigger so
         the user can tell at a glance which controls are live.  Hover
         uses a translucent white overlay; matches Meet / Zoom feel.
    -->
    <Style x:Key="ConfToolbarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource ConfBorderHoverBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource ConfTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Bg"
                            CornerRadius="{StaticResource ConfButtonCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background"
                                    Value="{StaticResource ConfHoverOverlayBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled End/Leave button: red phone glyph, no border.
         Used as the rightmost toolbar item via BasedOn so width/height/
         radius stay consistent with the rest of the pill row. -->
    <Style x:Key="ConfToolbarEndButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ConfToolbarButtonStyle}">
        <Setter Property="Width" Value="72"/>
        <Setter Property="Background" Value="{StaticResource ConfAccentRedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

</ResourceDictionary>
