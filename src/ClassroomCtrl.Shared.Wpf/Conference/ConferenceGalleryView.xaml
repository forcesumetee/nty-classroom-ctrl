<UserControl x:Class="ClassroomCtrl.Shared.Wpf.Conference.ConferenceGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters"
             xmlns:local="clr-namespace:ClassroomCtrl.Shared.Wpf.Conference"
             xmlns:vm="clr-namespace:ClassroomCtrl.Shared.Wpf.ViewModels"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Background}"
             FontFamily="Segoe UI"
             d:DesignWidth="1280" d:DesignHeight="640">
    <!-- Phase 15-C — shared gallery surface used by:
           - Teacher's ConferenceView (data = MainViewModel.ConferenceGallery)
           - Student's ConferenceGalleryWindow (data = own thin gallery VM)

         Phase 16-B step 4 — moved from Teacher/Views/Conference/ to
         Shared.Wpf so both Teacher and Student.Agent host the same
         control. -->
    <UserControl.Resources>
        <conv:ParticipantCountToColumnsConverter x:Key="CountToColumns"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate x:Key="ConferenceTileTemplate"
                      DataType="{x:Type vm:ConferenceTileViewModel}">
            <!-- Click anywhere on the tile to pin/unpin.  Forwarded via
                 PinCommand on the gallery VM; CommandParameter is the tile VM
                 itself.  Cursor=Hand so the affordance is discoverable.

                 Phase 22.2-C — defensive stretch + MinHeight on the Button
                 itself.  The 22.1-A fix put MinHeight=160 on the inner
                 ConferenceTile's OuterBorder + Grid, but the DataTemplate's
                 Button wrapper had no explicit alignment / min-size of its
                 own.  When WPF realizes the Button at small UniformGrid
                 cell sizes the Button's own measure can resolve to the
                 ContentPresenter's natural rect (which doesn't pick up
                 the inner UserControl's MinHeight reliably in every
                 layout pass — a layered top-level Grid in the template
                 chain occasionally measures content with infinity-
                 constrained calls that defeat the inner MinHeight).
                 Setting HCA/VCA + MinHeight here forces the Button to
                 claim 160 px even before the inner tile's own MinHeight
                 chain kicks in. -->
            <Button Background="Transparent" BorderThickness="0"
                    Padding="0" Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    MinHeight="160" MinWidth="200"
                    Focusable="False" FocusVisualStyle="{x:Null}"
                    Command="{Binding DataContext.PinCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <local:ConferenceTile/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Two mutually-exclusive layouts swapped by IsPinnedView:
           (a) Gallery: UniformGrid auto-layout (step 2 default).
           (b) Filmstrip: large primary tile (left ~75%) + scrolling column
               of small tiles on the right (~25%).
         Filmstrip uses CollectionViewSource sorting via a converter that
         filters by IsPinned isn't reliable in pure XAML, so we keep it
         simple: bind both layouts to the same Tiles collection; the small
         filmstrip ItemTemplate is the same ConferenceTile UserControl. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Bottom page-nav strip; only takes layout when there's > 1 page. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
        <!-- Phase 16-B+ step 9 — top-level layout switch.  Three mutually-
             exclusive modes; share-mode wins when active:
               IsShareActive  → ConferenceShareView (large frame + filmstrip)
               IsPinnedView   → existing pinned filmstrip layout
               otherwise      → tile UniformGrid
             Each layout's Style.Trigger collapses it when share-mode is
             active, so the new ShareView slots in cleanly without nesting. -->
        <local:ConferenceShareView>
            <local:ConferenceShareView.Style>
                <Style TargetType="local:ConferenceShareView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShareActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:ConferenceShareView.Style>
        </local:ConferenceShareView>

        <!-- (a) Gallery (auto-layout) — visible iff IsPinnedView == false
             AND IsShareActive == false.
             Binds to PageTiles (paged subset of Tiles) so > TilesPerPage
             participants paginate via the bar below. -->
        <ItemsControl ItemsSource="{Binding PageTiles}"
                      ItemTemplate="{StaticResource ConferenceTileTemplate}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinnedView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- Phase 16-B+ step 9 — also hide in share-mode. -->
                        <DataTrigger Binding="{Binding IsShareActive}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Phase 16-B step 5 — UI bug fix.  The old binding
                         (PageTiles.Count via CountToColumns inside the
                         ItemsPanelTemplate) stalled at realize-time: the
                         UniformGrid's Columns property evaluated against
                         a value of 0 before PageTiles was populated and
                         did not always re-evaluate when the collection
                         later grew.  When the binding got stuck at 0,
                         UniformGrid fell back to its square-root rule,
                         producing a vertical-stack layout that pushed
                         tiles below the viewport (per Phase 16-A
                         architecture doc § "UI Bug Diagnosis", H1).
                         Replacement: a plain int property
                         (ColumnsForPage) on the gallery VM, re-raised
                         via OnPropertyChanged in RebuildPageTiles.
                         RelativeSource walks to the outer ItemsControl
                         whose DataContext IS the gallery VM, sidestepping
                         the ItemsPanelTemplate DataContext gotcha
                         entirely. -->
                    <UniformGrid
                        Columns="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl},
                                          Path=DataContext.ColumnsForPage}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- (b) Filmstrip — visible iff IsPinnedView == true AND
             IsShareActive == false. -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinnedView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- Phase 16-B+ step 9 — share-mode wins.  This
                             trigger appears AFTER the IsPinnedView trigger
                             so its later-precedence Setter overrides the
                             pinned-mode Visible when share-mode is also on. -->
                        <DataTrigger Binding="{Binding IsShareActive}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Primary (pinned) tile.  ItemsControl bound to the same Tiles
                 list but filtered by IsPinned through a Style trigger
                 hiding non-pinned items. -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConferenceTileViewModel}">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Focusable="False" FocusVisualStyle="{x:Null}"
                                Cursor="Hand"
                                Command="{Binding DataContext.PinCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <local:ConferenceTile/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Filmstrip column.  All non-pinned tiles, scrollable. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConferenceTileViewModel}">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    Cursor="Hand"
                                    Height="120"
                                    Command="{Binding DataContext.PinCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <local:ConferenceTile/>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Grid><!-- Grid.Row=0 -->

        <!-- Page navigation strip — only takes layout space when HasMultiplePages
             AND share-mode is NOT active.  Share-mode's filmstrip has its
             own horizontal scroll; surfacing a separate page-nav strip
             below it would double up on participants-paging UX.  Phase
             16-B+ step 11 polish. -->
        <Border Grid.Row="1" Padding="0,10,0,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMultiplePages}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsShareActive}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PrevPageCommand}"
                        Padding="14,4" Margin="0,0,8,0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Border.Soft}"
                        Background="{DynamicResource Surface.Card}"
                        Focusable="False" FocusVisualStyle="{x:Null}"
                        Cursor="Hand">
                    <TextBlock Text="◀" FontSize="13"/>
                </Button>
                <Border Background="{DynamicResource Surface.Elevated}"
                        CornerRadius="999" Padding="14,4"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding PageLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"/>
                </Border>
                <Button Command="{Binding NextPageCommand}"
                        Padding="14,4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Border.Soft}"
                        Background="{DynamicResource Surface.Card}"
                        Focusable="False" FocusVisualStyle="{x:Null}"
                        Cursor="Hand">
                    <TextBlock Text="▶" FontSize="13"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
