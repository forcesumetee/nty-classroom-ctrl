<UserControl x:Class="ClassroomCtrl.Shared.Wpf.Conference.ConferenceTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI"
             d:DesignWidth="340" d:DesignHeight="190">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>
    <!-- Phase 15-C — single conference tile.
         Outer Border carries the accent ring (active speaker / pinned).
         Inner Border is the 16:9 surface; webcam frame OR placeholder fills it.
         Bottom overlay: name + mic/cam state.
         Top-right slot: hand-raise badge placeholder (Phase 15-E wires).
         Click anywhere → PinCommand (forwarded by parent gallery DataTemplate).

         Phase 16-B step 4 — moved from Teacher/Views/Conference/ to Shared.Wpf
         so Student.Agent renders the same tile via its
         StudentConferenceShellViewModel. -->
    <!-- Phase 16-B+ step 3 — MinHeight prevents the tile from collapsing to
         a thin label strip when the * row's measured height shrinks under
         certain UniformGrid pages.  120 px keeps the avatar + "Camera off"
         legible at the smallest packed layout (4-wide page). -->
    <Border x:Name="OuterBorder"
            CornerRadius="8" BorderThickness="2"
            BorderBrush="Transparent"
            Background="{DynamicResource Surface.Card}"
            Padding="0" Margin="8" MinHeight="120">
        <!-- Three style triggers in priority order:
             1. IsPinned=true        → purple accent (visual lock indicator)
             2. IsSpeaking=true      → green accent (active speaker)
             3. otherwise            → transparent (no accent) -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                        <Setter Property="BorderBrush" Value="#10B981"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Webcam frame area.  Cam-off placeholder is a Zoom-style
                 avatar circle (initial of display name) + "Camera off" label.
                 Phase 16-B+ step 3 — replaced the 🚫 emoji + duplicate name
                 placeholder (which collapsed visually with the bottom name
                 strip) with a proper avatar surface so the tile reads as a
                 real participant slot even when no cam frame is arriving. -->
            <Border Grid.Row="0" Background="#1F2937" CornerRadius="6,6,0,0">
                <Grid>
                    <!-- Frame, visible whenever we have a BitmapSource. -->
                    <Image Source="{Binding JpegFrame}" Stretch="Uniform"
                           Visibility="{Binding JpegFrame, Converter={StaticResource NullToVisibility}}"/>
                    <!-- Cam-off placeholder: avatar circle (initial) +
                         camera-off indicator.  Visible when
                         JpegFrame == null OR IsCamLive == false (the bound
                         JpegFrame stays after a frame arrives even if the
                         participant stops their cam, so we bind to the
                         null-converter on JpegFrame for the simple cam-off
                         signal that today's pipeline already exposes
                         — JpegFrame is cleared when CamLive flips off in
                         ConferenceGalleryViewModel routing). -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding JpegFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}">
                        <StackPanel>
                            <!-- Avatar circle with first letter of name.  Sized
                                 to read as a tile-anchor even at smallest
                                 page layout; matches Meet / Zoom proportions. -->
                            <Grid Width="72" Height="72"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8">
                                <Ellipse Fill="#4F46E5"/>
                                <TextBlock Text="{Binding Initial}"
                                           FontSize="32" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Camera-off label below the avatar.  Small,
                                 muted; "📷 Camera off" form to mirror the
                                 conventional Zoom / Meet language. -->
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="#94A3B8" FontSize="12">
                                <Run Text="📷"/>
                                <Run Text=" "/>
                                <Run Text="{DynamicResource Conf_CameraOff}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <!-- Top-right: hand-raise badge slot.  15-E binds IsHandRaised. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6" Padding="6,2"
                            Background="#FBBF24" CornerRadius="999"
                            Visibility="{Binding IsHandRaised, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✋" FontSize="12"/>
                    </Border>

                    <!-- Phase 15-E step 5 — floating reaction emoji.  Set by
                         MainViewModel.ShowReactionOnTile via a DispatcherTimer.
                         Float-up + fade-out Storyboard is started by the
                         tile's code-behind on PropertyChanged when the
                         emoji becomes non-empty.  RenderTransformOrigin
                         keeps the translate centered so the float lifts
                         straight up from the tile center. -->
                    <TextBlock x:Name="ReactionFloater"
                               Text="{Binding CurrentReactionEmoji}"
                               FontSize="56"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ReactionFloaterTransform" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Name + indicators strip. -->
            <Border Grid.Row="1" Background="{DynamicResource Surface.Elevated}"
                    Padding="10,5" CornerRadius="0,0,6,6">
                <DockPanel>
                    <!-- Right cluster: mic + cam indicators. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Mic icon: green if live, grey otherwise. -->
                        <TextBlock Text="🎙" FontSize="13" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicLive}" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Cam icon: full opacity if cam live, dim otherwise. -->
                        <TextBlock Text="📷" FontSize="13" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCamLive}" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Name (with "(You)" suffix for self-tile). -->
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelfSuffix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
