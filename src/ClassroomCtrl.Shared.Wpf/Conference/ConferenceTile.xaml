<UserControl x:Class="ClassroomCtrl.Shared.Wpf.Conference.ConferenceTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="{StaticResource ConfFontFamily}"
             d:DesignWidth="340" d:DesignHeight="190">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <!-- Phase 22.3-C — map the wire-payload emoji string into a
             color PNG so the float-up reaction is rendered as an
             image (consistent with the picker, bypasses the Win11
             Thai-locale font shaping issue). -->
        <conv:EmojiToReactionImageConverter x:Key="EmojiToReactionImage"/>
    </UserControl.Resources>
    <!-- Phase 22 — Zoom-style dark tile.
         Outer Border: dark slate background, rounded.  IsSpeaking flips
         to the yellow active-speaker ring (replacing 15-C's green
         accent — yellow reads as "speaking" in the Meet / Zoom
         convention and contrasts the green mic-active dot in the
         status bar).  IsPinned keeps the purple ring (lower priority
         than active-speaker by trigger order).
         When a video frame is present, background dims further
         (ConfTileLiveBgBrush) so transparent pixels around odd-shaped
         frames don't read as panel breaks.
         Layering (bottom-up):
           1. Video frame Image                  (full-bleed)
           2. Centered name placeholder          (when no frame)
           3. Top-right badges                   (Host + Hand-raise)
           4. Bottom-left status bar pill        (mic dot + name + icons)
           5. Floating reaction emoji            (driven by code-behind)
         Padding/Margin: 12 px breathing room on overlays so they don't
         touch the tile edge at the smallest UniformGrid packing.
         15-C ClickToPin handler removed for v1.1; tile is non-interactive
         (host pins via sidebar in v1.2). -->
    <Border x:Name="OuterBorder"
            CornerRadius="{StaticResource ConfTileCornerRadius}"
            ClipToBounds="True"
            Margin="8"
            SizeChanged="OuterBorder_SizeChanged">
        <!-- Phase 22.5-A:
             Aspect-ratio sizing is now handled via code-behind SizeChanged 
             to break the circular layout loop caused by ActualWidth binding.
             The OuterBorder fills its UniformGrid slot horizontally and computes
             its own Height = ActualWidth × 0.5625 = 16:9. -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ConfTileBgBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <!-- Live video → dimmer plate so the frame pops. -->
                    <DataTrigger Binding="{Binding JpegFrame, Converter={StaticResource NullToVisibility}}"
                                 Value="Visible">
                        <Setter Property="Background" Value="{StaticResource ConfTileLiveBgBrush}"/>
                    </DataTrigger>
                    <!-- IsSpeaking flips on the active-speaker yellow ring. -->
                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource ConfBorderActiveBrush}"/>
                        <Setter Property="BorderThickness" Value="3"/>
                    </DataTrigger>
                    <!-- Pinned (sidebar v1.2 wiring) keeps the prior purple
                         accent so the affordance still has a unique color
                         when both Pinned + Speaking land at once. -->
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                        <Setter Property="BorderThickness" Value="3"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <!-- Phase 22.1-A / 22.5-A:
             Removed explicit MinHeight=160 so the Grid can proportionally 
             scale down without clipping when the window is very small. -->
        <Grid>
            <!-- Layer 1: video frame. -->
            <Image Source="{Binding JpegFrame}" Stretch="Uniform"
                   Visibility="{Binding JpegFrame, Converter={StaticResource NullToVisibility}}"/>

            <!-- Layer 2: name placeholder when no frame.  Large display
                 name centered (Zoom-style "minimal" tile per the
                 mockup).  No avatar circle, no Camera-off label
                 — the cam-off state surfaces via the cam icon color
                 in the bottom status bar instead. -->
            <TextBlock Text="{Binding DisplayName}"
                       Visibility="{Binding JpegFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}"
                       Foreground="{StaticResource ConfTextPrimaryBrush}"
                       FontFamily="{StaticResource ConfFontFamily}"
                       FontSize="{StaticResource ConfFontSizeTileName}"
                       FontWeight="Medium"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="20,0"/>

            <!-- Layer 3: top-right badges (Host + Hand raise).  Stacked
                 horizontally so multi-badge teacher tiles stay tidy. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,12,0">

                <!-- Host badge — semi-transparent blue background + bright
                     blue stroke + pale-blue text.  Visibility binds to
                     IsHost (added as ObservableProperty stub in this
                     phase; populator lands in v1.2). -->
                <Border Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}"
                        CornerRadius="{StaticResource ConfBadgeCornerRadius}"
                        Background="{StaticResource ConfHostBadgeBgBrush}"
                        BorderBrush="{StaticResource ConfAccentBlueBrush}"
                        BorderThickness="1"
                        Padding="10,3"
                        Margin="0,0,6,0">
                    <TextBlock Text="HOST"
                               Foreground="{StaticResource ConfAccentBluePale}"
                               FontFamily="{StaticResource ConfFontFamily}"
                               FontSize="{StaticResource ConfFontSizeBadge}"
                               FontWeight="Medium"/>
                </Border>

                <!-- Hand-raise badge: amber fill, dark-text emoji.
                     Single-glyph for v1.1 (the localized "Hand raised"
                     label is in the participants sidebar already; the
                     tile badge just signals presence). -->
                <Border Visibility="{Binding IsHandRaised, Converter={StaticResource BoolToVisibility}}"
                        CornerRadius="14"
                        Background="{StaticResource ConfAccentYellowBrush}"
                        Padding="10,4">
                    <TextBlock Text="✋"
                               FontFamily="Segoe UI Emoji"
                               FontSize="13"
                               Foreground="#1F1F23"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Layer 4: bottom-left status pill.  Dark translucent
                 background so it floats over either video or the name
                 placeholder.  Order: mic-active green dot (visible
                 only when IsMicLive), display name, mic icon, cam icon. -->
            <Border CornerRadius="{StaticResource ConfStatusBarRadius}"
                    Background="{StaticResource ConfStatusBarBgBrush}"
                    Padding="{StaticResource ConfStatusBarPadding}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="12,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <!-- Speaking indicator: tiny green dot. -->
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource ConfAccentGreenBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Visibility="{Binding IsMicLive, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Name (+ "(You)" suffix from code-behind via
                         SelfSuffix DependencyProperty). -->
                    <TextBlock Foreground="{StaticResource ConfTextPrimaryBrush}"
                               FontFamily="{StaticResource ConfFontFamily}"
                               FontSize="{StaticResource ConfFontSizeStatus}"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="180">
                        <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelfSuffix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                             Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                    </TextBlock>

                    <!-- Mic icon: white when live, red when muted. -->
                    <TextBlock Text="🎙"
                               FontFamily="Segoe UI Emoji"
                               FontSize="13"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ConfAccentRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMicLive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ConfTextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Cam icon: white when on, red when off. -->
                    <TextBlock Text="📷"
                               FontFamily="Segoe UI Emoji"
                               FontSize="13"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ConfAccentRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCamLive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ConfTextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Layer 5: floating reaction emoji.  Code-behind starts
                 the float-up Storyboard when CurrentReactionEmoji
                 becomes non-empty (Phase 15-E step 5).  RenderTransform
                 + Opacity 0 default match the existing animation
                 expectations — DO NOT rename ReactionFloater /
                 ReactionFloaterTransform; they're driven by the
                 code-behind StartReactionFloat() method.
                 Phase 22.3-C — TextBlock swapped for Image so the
                 floating reaction uses the same color PNG as the
                 picker.  CurrentReactionEmoji (the wire-payload
                 emoji string) flows through EmojiToReactionImage
                 converter; unknown / empty input → Image.Source =
                 null → renders nothing, matching idle state. -->
            <Image x:Name="ReactionFloater"
                   Source="{Binding CurrentReactionEmoji, Converter={StaticResource EmojiToReactionImage}}"
                   Width="64" Height="64"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Opacity="0">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="ReactionFloaterTransform" Y="0"/>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Border>
</UserControl>
