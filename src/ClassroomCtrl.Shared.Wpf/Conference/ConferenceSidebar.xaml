<UserControl x:Class="ClassroomCtrl.Shared.Wpf.Conference.ConferenceSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters"
             xmlns:models="clr-namespace:ClassroomCtrl.Shared.Models;assembly=ClassroomCtrl.Shared"
             mc:Ignorable="d"
             Background="{StaticResource ConfSidebarBgBrush}"
             TextElement.Foreground="{StaticResource ConfTextPrimaryBrush}"
             FontFamily="{StaticResource ConfFontFamily}"
             d:DesignWidth="340" d:DesignHeight="640">
    <!-- Phase 22 — dark sidebar.  Background flipped from Classroom
         Surface.Elevated to ConfSidebarBgBrush; TextElement.Foreground
         set so every descendant TextBlock that doesn't override
         Foreground inherits a light-on-dark color.  All bindings
         identical to the 15-D / 16-D / 19 baseline; only colors and
         borders changed. -->
    <!-- Phase 15-D step 2 — slide-in sidebar overlay for the Conference shell.
         Hosts two tabs (Chat | Participants).  Chat reuses EveryoneConversation
         (the same conversation backing the Classroom right-rail), giving a
         single source of truth for whole-class chat across modes — messages
         sent in Conference appear in the Classroom rail after End, and vice
         versa.  Step 3 fills the Participants tab.

         Phase 16-B step 4 — moved from Teacher/Views/Conference/ to Shared.Wpf.
         Close X uses the new IConferenceSidebarHost interface so the
         sidebar works against either Teacher.MainViewModel OR
         Student.StudentConferenceShellViewModel without a hard ref. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Tab pill — used twice in the header for Chat / Participants tab
             selection.  Active state set via DataTrigger on the parent's
             IsConferenceChatTabSelected / IsConferenceParticipantsTabSelected
             flags so the pill highlight stays in sync no matter how the tab
             is switched (toolbar click, sidebar click, ✋ shortcut). -->
        <Style x:Key="SidebarTabPill" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource ConfTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="999"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{StaticResource ConfHoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource ConfBorderSubtleBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header (title + tabs + close). -->
                <RowDefinition Height="Auto"/>
                <!-- Tab content. -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar: tabs on the left, close X on the right. -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <DockPanel>
                    <!-- Close X — pulls IsConferenceSidebarVisible to false via
                         the IConferenceSidebarHost interface (works against
                         both Teacher and Student shell VMs). -->
                    <Button DockPanel.Dock="Right"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False" FocusVisualStyle="{x:Null}"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="{DynamicResource Conf_SidebarClose}">
                        <TextBlock Text="✕" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                    </Button>
                    <!-- Tab cluster.  Active tab fills with the accent
                         blue (matches the Zoom / Meet tab convention)
                         + light text; inactive stays secondary. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SelectConferenceChatTabCommand}"
                                Content="{DynamicResource Conf_SidebarChatTab}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarTabPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConferenceChatTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ConfAccentBlueBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SelectConferenceParticipantsTabCommand}"
                                Content="{DynamicResource Conf_SidebarParticipantsTab}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarTabPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConferenceParticipantsTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ConfAccentBlueBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tab body. -->
            <Grid Grid.Row="1">
                <!-- Chat tab.  Reuses ActiveConversation.Messages (mirrors the
                     pattern at Teacher/MainWindow.xaml:1016) so the rail and
                     the sidebar share a single chat history. -->
                <DockPanel
                    Visibility="{Binding IsConferenceChatTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <!-- Bottom input row. -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Phase 16-X (Bug G fix) — chat tab binds to
                                 ConferenceConversation.  Phase 19 — 📎 attach
                                 button + draft preview strip preserved.
                                 Phase 22 — TextBox.Default style dropped in
                                 favor of an inline dark style so the input
                                 reads as dark-on-dark (the Classroom
                                 TextBox.Default has a near-white background
                                 that becomes a glaring white box on the
                                 dark surface).  Send button background
                                 swapped to ConfAccentBlueBrush. -->
                            <Button Grid.Column="0"
                                    Click="AttachFileButton_Click"
                                    Width="36" Height="36" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    ToolTip="{DynamicResource Chat_AttachFile_Tooltip}">
                                <TextBlock Text="📎" FontSize="16"
                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"/>
                            </Button>
                            <TextBox Grid.Column="0"
                                     Margin="40,0,0,0"
                                     Padding="8,6"
                                     Background="{StaticResource ConfChatInputBgBrush}"
                                     Foreground="{StaticResource ConfTextPrimaryBrush}"
                                     CaretBrush="{StaticResource ConfTextPrimaryBrush}"
                                     BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                     BorderThickness="1"
                                     FontFamily="{StaticResource ConfFontFamily}"
                                     Text="{Binding ConferenceConversation.DraftInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1"
                                    Background="{StaticResource ConfAccentBlueBrush}"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Command="{Binding SendConferenceChatCommand}"
                                    Margin="8,0,0,0" Width="40" Height="40" Padding="0"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource Btn_Send}">
                                <TextBlock Text="➤" FontSize="14" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Phase 19 (v1.1) — draft attachment preview strip.
                         Visible iff HasConferenceDraftAttachment (Teacher) or
                         HasDraftAttachment (Student); the binding fallback
                         is "Collapsed" (the converter outputs Collapsed for
                         missing properties) which is the correct default
                         when neither host VM has draft state. -->
                    <Border DockPanel.Dock="Bottom"
                            Margin="10,0,10,0" Padding="8,6"
                            Background="{StaticResource ConfChatInputBgBrush}"
                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConferenceDraftAttachment}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDraftAttachment}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Click="ClearDraftAttachment_Click"
                                    Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource Chat_AttachFile_Clear}">
                                <TextBlock Text="✕" FontSize="12"
                                           Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource ConfTextPrimaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="📎"/>
                                <Run Text=" "/>
                                <!-- One Run for Teacher VM (ConferenceDraftAttachmentLabel),
                                     one for Student VM (DraftAttachmentLabel) — only the
                                     populated one renders since the other binds to a
                                     missing property and resolves to empty string. -->
                                <Run Text="{Binding ConferenceDraftAttachmentLabel, Mode=OneWay, FallbackValue=''}"/>
                                <Run Text="{Binding DraftAttachmentLabel, Mode=OneWay, FallbackValue=''}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Bubble list. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ConferenceConversation.Messages}"
                                      Margin="10,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ChatMessage}">
                                    <!-- Phase 22 — dark bubble.  v1.2 carry-over:
                                         distinguish own / other via an IsOwn
                                         property on the ChatMessage VM; today
                                         every bubble uses ConfChatOtherBubbleBrush
                                         since the model doesn't expose ownership. -->
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                                            Background="{StaticResource ConfChatOtherBubbleBrush}"
                                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                                            <!-- Phase 19 file-attachment card — dark-themed.
                                                 Surface flipped to ConfChatOwnBubbleBrush
                                                 so the card reads as a panel-on-panel
                                                 inset.  Download / Open buttons recolored
                                                 (Download neutral, Open accent blue).
                                                 All Click handlers + Tag bindings preserved. -->
                                            <Border Margin="0,4,0,4" Padding="8,6"
                                                    CornerRadius="6"
                                                    Background="{StaticResource ConfChatOwnBubbleBrush}"
                                                    BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Click="DownloadAttachment_Click"
                                                                Tag="{Binding}"
                                                                Content="{DynamicResource Chat_AttachFile_Download}"
                                                                FontSize="11"
                                                                Padding="6,2" Margin="0,0,4,0"
                                                                Background="Transparent"
                                                                Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                                BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                                                BorderThickness="1"
                                                                Cursor="Hand"/>
                                                        <Button Click="OpenAttachment_Click"
                                                                Tag="{Binding}"
                                                                Content="{DynamicResource Chat_AttachFile_Open}"
                                                                FontSize="11"
                                                                Padding="6,2"
                                                                Background="{StaticResource ConfAccentBlueBrush}"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AttachmentIcon}"
                                                                   FontSize="18"
                                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AttachmentFileName}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="160"/>
                                                            <TextBlock Text="{Binding AttachmentSizeFormatted}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Text="{Binding MessageText}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Phase 15-D step 3 — Participants tab.  Lists every connected
                     student; per-row indicators show mic-live (🎙), cam-live
                     (📷), hand-raised (✋, repurposes the existing
                     HandRaisedVisibility wired by 0x0110 dispatch — see the
                     foundation-discovery in MainViewModel.OnHandRaiseReceived).
                     Empty state (no students connected) is intentionally a
                     blank list in step 3; step 6 polish adds a placeholder
                     once a CountToVisibility converter exists. -->
                <Grid
                    Visibility="{Binding IsConferenceParticipantsTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <!-- Participants list, scroll-wrapped together with the
                         Raised Hands header so both pieces share one scrollbar. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,8">

                            <!-- Phase 15-E step 3 — Raised Hands queue.  Header
                                 + per-row Recognize button on top of the regular
                                 participants list.  Bound to
                                 ConferenceGallery.RaisedHandQueue (first-raised
                                 at top).  The whole section is collapsed when
                                 no hands are raised — driven by a Style
                                 trigger on RaisedHandQueue.Count via the
                                 existing ItemsControl HasItems pattern. -->
                            <StackPanel x:Name="RaisedHandsSection">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConferenceGallery.RaisedHandQueue.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource Conf_RaisedHandsHeader}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConfTextSecondaryBrush}"
                                           Margin="2,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ConferenceGallery.RaisedHandQueue}"
                                              Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Amber raised-hand row.  Dark text on amber
                                                 reads as "alert" without being aggressive;
                                                 matches the hand-raise badge on the tile. -->
                                            <Border Background="{StaticResource ConfAccentYellowBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,8" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="{DynamicResource Conf_Recognize}"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            Background="#1F1F23" Foreground="White"
                                                            BorderThickness="0" Padding="10,4"
                                                            Cursor="Hand"
                                                            Focusable="False" FocusVisualStyle="{x:Null}"
                                                            Visibility="{Binding DataContext.Role.CanRecognizeHand,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.RecognizeHandCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✋" FontSize="14" Margin="0,0,8,0"
                                                                   Foreground="#1F1F23"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#1F1F23"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{StaticResource ConfBorderSubtleBrush}"
                                        Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Regular participants list (all connected students). -->
                            <ItemsControl ItemsSource="{Binding Students}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Dark participant row.  ConfTileBgBrush matches the
                                         gallery tile so the surfaces feel like the same
                                         family.  All bindings (DisplayName, MachineName,
                                         MicLive, CamLive, HandRaisedVisibility, Role.*
                                         walks, MuteParticipantCommand) preserved exactly. -->
                                    <Border Background="{StaticResource ConfTileBgBrush}"
                                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <DockPanel>
                                            <!-- Avatar placeholder.  Semi-transparent blue
                                                 host-badge brush so it reads as a calm
                                                 chip on the dark row. -->
                                            <Border DockPanel.Dock="Left"
                                                    Width="36" Height="36"
                                                    CornerRadius="999"
                                                    Background="{StaticResource ConfHostBadgeBgBrush}"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="👤" FontSize="18"
                                                           Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Right cluster: state indicators. -->
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Padding="6,2"
                                                        Background="{StaticResource ConfAccentYellowBrush}"
                                                        CornerRadius="999"
                                                        Margin="0,0,4,0"
                                                        Visibility="{Binding HandRaisedVisibility}">
                                                    <TextBlock Text="✋" FontSize="11"
                                                               Foreground="#1F1F23"/>
                                                </Border>
                                                <!-- Mic indicator: ConfTextSecondaryBrush
                                                     when muted, ConfTextPrimaryBrush when
                                                     live.  Replaces the Opacity-based
                                                     dim used in 15-C — explicit color
                                                     reads better on the dark surface. -->
                                                <TextBlock Text="🎙" FontSize="14" Margin="4,0"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource ConfTextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MicLive}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource ConfTextPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="📷" FontSize="14" Margin="4,0,0,0"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource ConfTextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CamLive}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource ConfTextPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Host-only Mute admin button.  ConfAccentRed
                                                 keeps the destructive-action color cue. -->
                                            <Button DockPanel.Dock="Right"
                                                    Content="{DynamicResource Conf_Mute}"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Background="{StaticResource ConfAccentRedBrush}"
                                                    Foreground="White"
                                                    BorderThickness="0" Padding="8,3"
                                                    Margin="6,0,0,0"
                                                    Cursor="Hand"
                                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.Role.CanMuteOthers,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                                 Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.MuteParticipantCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Name + machine. -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MachineName}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource ConfTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
