<UserControl x:Class="ClassroomCtrl.Shared.Wpf.Conference.ConferenceToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="{StaticResource ConfFontFamily}"
             d:DesignWidth="900" d:DesignHeight="68">
    <!-- Phase 22 — dark compact pill dock.
         Visual rewrite of the 15-D toolbar.  Container Border collapsed
         from a full-width row with a top border to a centered floating
         pill (ConfToolbarBgBrush, ConfToolbarCornerRadius).  Buttons
         picked up from the shared ConfToolbarButtonStyle defined in
         ConferenceDarkTheme.xaml so layout is identical across Teacher
         + Student.  Active-state colors use ConfAccentGreen (mic /
         cam / share on) and ConfAccentYellow (hand raise + share
         request pending).  End/Leave keeps a filled red pill via
         ConfToolbarEndButtonStyle.
         All command bindings preserved (ToggleMic / ToggleCamera /
         ShareScreen / ToggleConferenceSidebar / RaiseHand / EndConference
         and the reaction popup + its named click handlers).
         The Phase 16-X (Bug D Part 1 retry) emoji popup is preserved
         verbatim — surrogate-pair char refs + multi-font fallback +
         implicit TextBlock style still required for Win11 Thai-locale
         22H2+ glyph rendering. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Border Background="{StaticResource ConfToolbarBgBrush}"
            CornerRadius="{StaticResource ConfToolbarCornerRadius}"
            Padding="8"
            HorizontalAlignment="Center"
            Margin="0,12,0,12">
        <StackPanel Orientation="Horizontal">

            <!-- 🎙 Mic toggle.  Active style when mic is live. -->
            <Button Command="{Binding ToggleMicCommand}"
                    ToolTip="{Binding MicTooltipText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfToolbarButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMicOn}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfAccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="🎙" FontSize="18"
                           FontFamily="Segoe UI Emoji"/>
            </Button>

            <!-- 📷 Camera toggle.  Active style when teacher cam is live. -->
            <Button Command="{Binding ToggleCameraCommand}"
                    ToolTip="{Binding CameraButtonText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfToolbarButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBroadcastingCamera}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfAccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="📷" FontSize="18"
                           FontFamily="Segoe UI Emoji"/>
            </Button>

            <!-- 🖥 Screen share toggle.
                 Visibility gated by Role.CanShareScreen (16-D); behavior
                 differs by host VM.  Teacher: ShareScreenCommand drives
                 the 16-B+ in-frame share directly.  Student: drives the
                 Phase 20 request state machine — Idle → Requesting →
                 Approved → Sharing.  Active-state DataTriggers map to
                 amber (Requesting — pending teacher approval) or green
                 (Approved / Sharing — student has the floor).  All
                 bindings preserved from 15-D + 20 + 21. -->
            <Button Command="{Binding ShareScreenCommand}"
                    ToolTip="{Binding ShareScreenButtonText, FallbackValue={x:Null}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfToolbarButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role.CanShareScreen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScreenSharing}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfAccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentGreenBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShareState}" Value="Requesting">
                                <Setter Property="Background" Value="{StaticResource ConfAccentYellowBrush}"/>
                                <Setter Property="Foreground" Value="#1F1F23"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentYellowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShareState}" Value="Approved">
                                <Setter Property="Background" Value="{StaticResource ConfAccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentGreenBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShareState}" Value="Sharing">
                                <Setter Property="Background" Value="{StaticResource ConfAccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="🖥" FontSize="18"
                           FontFamily="Segoe UI Emoji"/>
            </Button>

            <!-- 💬 Chat sidebar toggle. -->
            <Button Command="{Binding ToggleConferenceSidebarCommand}"
                    ToolTip="{DynamicResource Conf_Tooltip_Chat}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfToolbarButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConferenceSidebarVisible}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfAccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="💬" FontSize="18"
                           FontFamily="Segoe UI Emoji"/>
            </Button>

            <!-- ✋ Hand raise.  Teacher: opens queue sidebar.  Student:
                 toggles own hand raise + emits 0x0110 / 0x0111 envelope.
                 Active-state amber pill fires for either teacher
                 HasNotifications (pending raised hands) OR student
                 IsHandRaised (own hand up). -->
            <Button Command="{Binding RaiseHandCommand}"
                    ToolTip="{DynamicResource Conf_Tooltip_Hand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfToolbarButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotifications}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfAccentYellowBrush}"/>
                                <Setter Property="Foreground" Value="#1F1F23"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentYellowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHandRaised}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfAccentYellowBrush}"/>
                                <Setter Property="Foreground" Value="#1F1F23"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ConfAccentYellowBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="✋" FontSize="18"
                           FontFamily="Segoe UI Emoji"/>
            </Button>

            <!-- ⋮ More — opens the reaction picker popup.
                 16-X (Bug D Part 1 retry) emoji fix is preserved verbatim:
                   (a) Border.Resources implicit TextBlock style — fills
                       FontFamily even if a deeper TextBlock forgets to
                       set it.  Belt against an inheritance break across
                       PopupRoot.
                   (b) Per-Run FontFamily with a multi-font fallback chain
                       — Segoe UI Emoji is the primary, Segoe UI Symbol
                       is a Windows-7+ secondary, Segoe UI is the system
                       default that at least has SOME emoji glyphs.
                   (c) UTF-16 surrogate-pair char refs (&#xD83D; &#xDC4D;
                       etc.) instead of literal emoji bytes — sidesteps
                       any XAML-parse path that might mis-shape the
                       original UTF-8 emoji bytes into single high-
                       surrogate code units (which the Win11 Thai locale
                       text shaper renders as random Latin glyphs).
                 Popup background swapped to ConfTitleBarBgBrush so the
                 picker reads as a darker overlay rather than the light
                 Classroom Surface.Card it pulled before.
            -->
            <Grid>
                <Button x:Name="MoreButton"
                        ToolTip="{DynamicResource Conf_Tooltip_More}"
                        Click="MoreButton_Click"
                        Style="{StaticResource ConfToolbarButtonStyle}">
                    <TextBlock Text="⋮" FontSize="20" FontWeight="Bold"/>
                </Button>
                <Popup x:Name="MorePopup"
                       PlacementTarget="{Binding ElementName=MoreButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <!-- Phase 22.1-C — emoji clipping defenses on top of
                         the existing 16-X Bug D 3-layer pattern.
                         Layer (d) MinWidth=260 on the Border so the
                             popup can't shrink narrower than 5×(40+4)+16
                             padding = ~236 px; the extra 24 px gives the
                             rightmost emoji breathing room when the
                             popup's measure rounds down (PopupRoot uses
                             a layered window whose layout is sometimes
                             pixel-rounded one px shy of content).
                         Layer (e) TextOptions hints forcing the WPF Ideal
                             text-formatting + ClearType rendering modes
                             so emojis don't fall back to GDI glyph
                             rendering on the layered Popup window.  GDI
                             fallback on Win11 Thai-locale shapes the
                             U+1F44D high-surrogate alone (the low
                             surrogate is dropped), producing the cropped
                             "(" the user observed. -->
                    <Border Background="{StaticResource ConfTitleBarBgBrush}"
                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8"
                            MinWidth="260"
                            TextOptions.TextFormattingMode="Ideal"
                            TextOptions.TextRenderingMode="ClearType">
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily"
                                        Value="Segoe UI Emoji"/>
                                <Setter Property="Foreground" Value="{StaticResource ConfTextPrimaryBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                            </Style>
                        </Border.Resources>
                        <StackPanel x:Name="ReactionRow" Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    TextElement.FontFamily="Segoe UI Emoji">
                            <Button Width="44" Height="44" Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="👍"
                                    Click="ReactionButton_Click"
                                    Tag="👍">
                                <TextBlock FontSize="22"
                                           FontFamily="Segoe UI Emoji">
                                    <Run FontFamily="Segoe UI Emoji"
                                         Text="&#x1F44D;"/>
                                </TextBlock>
                            </Button>
                            <Button Width="44" Height="44" Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="❤️"
                                    Click="ReactionButton_Click"
                                    Tag="❤️">
                                <TextBlock FontSize="22"
                                           FontFamily="Segoe UI Emoji">
                                    <Run FontFamily="Segoe UI Emoji"
                                         Text="&#x2764;&#xFE0F;"/>
                                </TextBlock>
                            </Button>
                            <Button Width="44" Height="44" Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="😂"
                                    Click="ReactionButton_Click"
                                    Tag="😂">
                                <TextBlock FontSize="22"
                                           FontFamily="Segoe UI Emoji">
                                    <Run FontFamily="Segoe UI Emoji"
                                         Text="&#x1F602;"/>
                                </TextBlock>
                            </Button>
                            <Button Width="44" Height="44" Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="😮"
                                    Click="ReactionButton_Click"
                                    Tag="😮">
                                <TextBlock FontSize="22"
                                           FontFamily="Segoe UI Emoji">
                                    <Run FontFamily="Segoe UI Emoji"
                                         Text="&#x1F62E;"/>
                                </TextBlock>
                            </Button>
                            <Button Width="44" Height="44" Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="😢"
                                    Click="ReactionButton_Click"
                                    Tag="😢">
                                <TextBlock FontSize="22"
                                           FontFamily="Segoe UI Emoji">
                                    <Run FontFamily="Segoe UI Emoji"
                                         Text="&#x1F622;"/>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 📞 End Conference / Leave — filled red pill via
                 ConfToolbarEndButtonStyle.  Tooltip flips on
                 Role.CanEndForAll (host vs participant). -->
            <Button Command="{Binding EndConferenceCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfToolbarEndButtonStyle}">
                        <Setter Property="ToolTip" Value="{DynamicResource Conf_Leave}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role.CanEndForAll}" Value="True">
                                <Setter Property="ToolTip" Value="{DynamicResource Conf_EndConference}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="📞" FontSize="18"
                           FontFamily="Segoe UI Emoji"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
