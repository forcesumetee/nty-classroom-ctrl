<UserControl x:Class="ClassroomCtrl.Shared.Wpf.Conference.ConferenceShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ClassroomCtrl.Shared.Wpf.Converters"
             xmlns:local="clr-namespace:ClassroomCtrl.Shared.Wpf.Conference"
             xmlns:vm="clr-namespace:ClassroomCtrl.Shared.Wpf.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource ConfWindowBgBrush}"
             FontFamily="{StaticResource ConfFontFamily}"
             d:DesignWidth="1280" d:DesignHeight="640">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>
    <!-- Phase 22 — dark Zoom-style ConferenceShareView.
         Primary frame surface flipped from #1F2937 (Classroom blue-slate)
         to pure black so the share frame reads with maximum contrast;
         CornerRadius pulled from ConfTileCornerRadius for consistency
         with the gallery tile family.  The "X is sharing" pill changed
         from a bright green chip to the dark translucent ConfStatusBarBg
         pattern + a 🖥 glyph so it doesn't compete with the share itself.
         All bindings unchanged (ActiveShareFrame, ActiveShareSourceName,
         Tiles, Conf_WaitingForShare / Conf_IsSharing locale). -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Primary share container — black canvas for max contrast. -->
        <Border Grid.Row="0" Background="#000000"
                CornerRadius="{StaticResource ConfTileCornerRadius}"
                ClipToBounds="True">
            <Grid>
                <Image Source="{Binding ActiveShareFrame}" Stretch="Uniform"/>

                <!-- Waiting placeholder, visible until the first frame
                     decodes.  Glyph + label use ConfText* so they read
                     as muted dark-mode text rather than the prior
                     Slate-400 / Slate-300 hex. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ActiveShareFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}">
                    <TextBlock Text="🖥" FontSize="56"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Emoji"
                               Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{StaticResource ConfTextPrimaryBrush}">
                        <Run Text="{DynamicResource Conf_WaitingForShare}"/>
                    </TextBlock>
                </StackPanel>

                <!-- "🖥 X is sharing" source-label pill — dark translucent
                     plate so it floats over the frame without obscuring
                     the share itself.  ConfStatusBarRadius matches the
                     tile's bottom-left status bar so the radii feel
                     coordinated across surfaces. -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12" Padding="12,5"
                        Background="{StaticResource ConfStatusBarBgBrush}"
                        CornerRadius="{StaticResource ConfStatusBarRadius}">
                    <TextBlock FontSize="12" FontWeight="Medium">
                        <Run Text="🖥"
                             FontFamily="Segoe UI Emoji"
                             Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding ActiveShareSourceName, Mode=OneWay}"
                             Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                        <Run Text=" "/>
                        <Run Text="{DynamicResource Conf_IsSharing}"
                             Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Filmstrip.  Same ConferenceTile control reused at a smaller
             fixed cell size; the tile's own dark theme + dropped avatar
             means the compact form already reads as a name-only chip
             without needing a separate compact template. -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Auto"
                      PanningMode="HorizontalOnly"
                      Background="Transparent">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConferenceTileViewModel}">
                        <Border Width="160" Margin="0,0,8,0">
                            <local:ConferenceTile/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
