<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassroomCtrl.Avalonia.Teacher.ViewModels"
        xmlns:views="using:ClassroomCtrl.Avalonia.Teacher.Views"
        xmlns:ac="using:Avalonia.Data.Converters"
        x:Class="ClassroomCtrl.Avalonia.Teacher.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="960" Height="720"
        Background="{StaticResource ConfWindowBgBrush}"
        Title="NTY ClassroomCtrl — Teacher (macOS)">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
        <!-- Header / status bar: title + listen address (what IP to point a student at) + count. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource ConfTitleBarBgBrush}" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="NTY ClassroomCtrl — Teacher" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ListenAddress}" FontSize="11"
                               Foreground="{StaticResource ConfTextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource ConfTextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- Student grid (WrapPanel 234×220 = the shipped Windows layout) + empty state. -->
        <Panel Grid.Row="1" Grid.Column="0">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Grid.Students}" Margin="14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="234" ItemHeight="220"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:StudentTileViewModel">
                            <!-- TT-3-B: double-tap a tile → open its live screen view.
                                 TT-5-B: right-click → per-student command menu (lock/unlock;
                                 power in TT-5-C). -->
                            <views:StudentCard Margin="0,0,14,14" DoubleTapped="Card_DoubleTapped"
                                               CommandRequested="Card_CommandRequested"
                                               SelectionRequested="Card_SelectionRequested"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyState" Text="Waiting for students…"
                       IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="{StaticResource ConfTextSecondaryBrush}"/>

            <!-- TT-6-C — floating bulk-action toolbar. Visible only with a selection; slides in
                 from the top (Transitions + the .shown class both bound to HasSelection). Shows
                 the count + live "Sending i of N" / result summary, the in-scope actions
                 (lock/unlock/power), and Clear. Power buttons are enabled only while at least one
                 selected student can execute power (decision A); the op skips the rest. Only the
                 actions that WORK are here — policy/mic/file arrive with their features. -->
            <Border x:Name="BulkToolbar" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    IsVisible="{Binding Grid.HasSelection}"
                    Classes.shown="{Binding Grid.HasSelection}"
                    Background="{StaticResource ConfTitleBarBgBrush}"
                    BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                    BorderThickness="0,0,0,1" Padding="16,8">
                <Border.Styles>
                    <Style Selector="Border#BulkToolbar">
                        <Setter Property="RenderTransform" Value="translateY(-48px)"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border#BulkToolbar.shown">
                        <Setter Property="RenderTransform" Value="translateY(0)"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="Button.bulk">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{StaticResource ConfBorderSubtleBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="{StaticResource ConfTextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource ConfTextPrimaryBrush}">
                            <Run Text="{Binding Grid.SelectedCount, Mode=OneWay}"/><Run Text=" selected"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"
                                   Text="{Binding Grid.BulkStatus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                        <Button Classes="bulk" Content="Lock" Command="{Binding Grid.BulkLockCommand}"/>
                        <Button Classes="bulk" Content="Unlock" Command="{Binding Grid.BulkUnlockCommand}"/>
                        <Border Width="1" Background="{StaticResource ConfBorderSubtleBrush}" Margin="4,2,10,2"/>
                        <Button Classes="bulk" Content="Log off" Command="{Binding Grid.BulkLogoffCommand}"
                                IsEnabled="{Binding Grid.CanBulkPower}"/>
                        <Button Classes="bulk" Content="Restart" Command="{Binding Grid.BulkRestartCommand}"
                                IsEnabled="{Binding Grid.CanBulkPower}"/>
                        <Button Classes="bulk" Content="Shut down" Foreground="#EA4335"
                                Command="{Binding Grid.BulkShutdownCommand}"
                                IsEnabled="{Binding Grid.CanBulkPower}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Width="28" Height="28" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip.Tip="Clear selection (Esc)"
                            Command="{Binding Grid.ClearSelectionCommand}">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- TT-7-C: transient notification banner (hand-raise / incoming chat). Bottom-center so
                 it doesn't collide with the top bulk toolbar. Auto-clears via the VM timer. -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                    IsVisible="{Binding Toast, Converter={x:Static ac:ObjectConverters.IsNotNull}}"
                    Background="{StaticResource ConfTitleBarBgBrush}"
                    BorderBrush="{StaticResource ConfBorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="16,8">
                <TextBlock Text="{Binding Toast}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource ConfTextPrimaryBrush}"/>
            </Border>
        </Panel>

        <!-- TT-7-C: chat rail — raised-hand queue + class chat (broadcast / DM). Inner DataContext
             is the ChatViewModel (set by App once the messaging seam exists); null-safe until then. -->
        <Border Grid.Row="1" Grid.Column="1" Width="300"
                Background="{StaticResource ConfTitleBarBgBrush}"
                BorderBrush="{StaticResource ConfBorderSubtleBrush}" BorderThickness="1,0,0,0">
            <Grid DataContext="{Binding Chat}" x:DataType="vm:ChatViewModel" RowDefinitions="Auto,Auto,*,Auto">
                <!-- Raised-hand queue (own DataContext = the grid, for RaisedHands + per-tile Recognize). -->
                <Border Grid.Row="0" DataContext="{Binding Grid}" x:DataType="vm:TeacherGridViewModel"
                        Padding="12,10" IsVisible="{Binding HasRaisedHands}"
                        BorderBrush="{StaticResource ConfBorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="✋ Raised hands" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding RaisedHands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:StudentTileViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding HandRaiseOrder}" FontWeight="Bold"
                                                   Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                   VerticalAlignment="Center" Width="18"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="Recognize" FontSize="11" Padding="8,2"
                                                Cursor="Hand" Command="{Binding RecognizeCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="Class chat" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ConfTextSecondaryBrush}" Margin="12,10,12,4"/>

                <!-- Message log. -->
                <ScrollViewer Grid.Row="2" Padding="12,0">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChatLineViewModel">
                                <StackPanel Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Scope}" FontSize="10"
                                                   Foreground="{StaticResource ConfTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input: DM target selector + textbox + send. -->
                <StackPanel Grid.Row="3" Margin="12,8,12,12" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="To:" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding Grid.Students}" SelectedItem="{Binding DmTarget}"
                                  PlaceholderText="Everyone" MinWidth="130" FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:StudentTileViewModel">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Everyone" FontSize="11" Padding="8,2" Cursor="Hand"
                                Command="{Binding ClearDmTargetCommand}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding Draft}" PlaceholderText="Type a message…"
                                 FontSize="12" AcceptsReturn="False"/>
                        <Button Grid.Column="1" Content="Send" Margin="6,0,0,0" Cursor="Hand"
                                Command="{Binding SendCommand}" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
