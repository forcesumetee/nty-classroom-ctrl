<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClassroomCtrl.Student.Mac</RootNamespace>
    <AssemblyName>ClassroomCtrl.Student.Mac</AssemblyName>
    <!-- Allow loading native libNtyCapture.dylib from the app bundle -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClassroomCtrl.Shared.Wire/ClassroomCtrl.Shared.Wire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <!-- Copy native dylib next to output so LibraryImport("NtyCapture") resolves at runtime -->
  <ItemGroup>
    <None Include="../../native/NtyCapture/libNtyCapture.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Link="libNtyCapture.dylib"
          Condition="Exists('../../native/NtyCapture/libNtyCapture.dylib')" />
  </ItemGroup>
</Project>
