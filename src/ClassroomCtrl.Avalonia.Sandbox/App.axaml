<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.App"
             RequestedThemeVariant="Dark">

    <!-- Merge both ported theme token sets app-wide. They coexist without collision:
         Conf* (Conference dark) vs Surface.*/Text.*/Accent.*/Status.* (Classroom light).
         Mirrors how the shipped Teacher app merges both dictionaries. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ClassroomCtrl.Avalonia.Sandbox/Themes/ConferenceDarkTheme.axaml"/>
                <ResourceInclude Source="avares://ClassroomCtrl.Avalonia.Sandbox/Themes/ClassroomLightTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>