<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ClassroomCtrl.Avalonia.Sandbox.Views"
        xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
        x:Class="ClassroomCtrl.Avalonia.Sandbox.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="760" Height="520"
        Background="#1F1F23"
        Title="ClassroomCtrl.Avalonia.Sandbox — ConferenceTile port (Phase 24.3)">

    <ScrollViewer Padding="12">
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ConferenceTileViewModel">
                    <!-- Explicit size stands in for the gallery UniformGrid slot;
                         the ported tile drops the WPF SizeChanged 16:9 auto-fit. -->
                    <views:ConferenceTile Width="340" Height="191"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
