<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ClassroomCtrl.Avalonia.Sandbox.Views"
        xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
        x:Class="ClassroomCtrl.Avalonia.Sandbox.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="940" Height="1000"
        Background="#1F1F23"
        Title="ClassroomCtrl.Avalonia.Sandbox — Phase 25.0-B ConferenceDarkTheme">

    <TabControl Background="Transparent">
        <!-- Tab 0 (default/captured): full 36-key theme baseline. -->
        <TabItem Header="Theme tokens (36 keys)">
            <ScrollViewer>
                <views:ThemeShowcaseView/>
            </ScrollViewer>
        </TabItem>
        <!-- Tab 1: the Phase 24.3 ported tile in its varied states. -->
        <TabItem Header="ConferenceTile">
            <ScrollViewer Padding="12">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ConferenceTileViewModel">
                            <views:ConferenceTile Width="340" Height="191"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>
        <!-- Tab 2 (Phase 25.1-D): full Conference bottom bar — tiles above, the
             ported toolbar docked below. Picking a reaction in the ⋮ Flyout floats
             the emoji up over the first tile (fulfils the 24.3 float design). -->
        <TabItem Header="Bottom bar">
            <Grid Background="{StaticResource ConfWindowBgBrush}" RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" Padding="16">
                    <WrapPanel>
                        <views:ConferenceTile DataContext="{Binding DemoTileA}" Width="340" Height="191"/>
                        <views:ConferenceTile DataContext="{Binding DemoTileB}" Width="340" Height="191"/>
                    </WrapPanel>
                </ScrollViewer>
                <views:ConferenceToolbar Grid.Row="1" DataContext="{Binding Toolbar}"/>
            </Grid>
        </TabItem>
        <!-- Tab 3 (Phase 25.3): ConferenceSidebar in isolation (fixed width). -->
        <TabItem Header="Sidebar">
            <Grid Background="{StaticResource ConfWindowBgBrush}">
                <views:ConferenceSidebar DataContext="{Binding Sidebar}"
                                         Width="360" HorizontalAlignment="Right"/>
            </Grid>
        </TabItem>
        <!-- Tab 4 (Phase 25.3-C): full Conference composition — sidebar docked right
             (full height), toolbar docked bottom of the main area, tile grid fills. -->
        <TabItem Header="Conference Full">
            <DockPanel Background="{StaticResource ConfWindowBgBrush}">
                <views:ConferenceSidebar DockPanel.Dock="Right" Width="340"
                                         DataContext="{Binding Sidebar}"/>
                <DockPanel>
                    <views:ConferenceToolbar DockPanel.Dock="Bottom"
                                             DataContext="{Binding Toolbar}"/>
                    <ScrollViewer Padding="12">
                        <ItemsControl ItemsSource="{Binding Tiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ConferenceTileViewModel">
                                    <views:ConferenceTile Width="300" Height="169"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </TabItem>
        <!-- Tab 5 (Phase 25.4): StudentCard grid + ContextMenu. The LastAction line
             shows which menu/button command fired (routing evidence). -->
        <TabItem Header="Student Grid">
            <Grid Background="{StaticResource ConfWindowBgBrush}" RowDefinitions="Auto,*"
                  DataContext="{Binding StudentGrid}">
                <Border Grid.Row="0" Background="{StaticResource ConfTitleBarBgBrush}" Padding="12,8">
                    <TextBlock Foreground="{StaticResource ConfTextPrimaryBrush}" FontSize="13">
                        <Run Text="Right-click a card for its menu · Last action:"/>
                        <Run Text="{Binding LastAction}" FontWeight="Bold"
                             Foreground="{StaticResource ConfAccentBluePale}"/>
                    </TextBlock>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="12">
                    <ItemsControl ItemsSource="{Binding Students}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentCardDemoViewModel">
                                <views:StudentCard Margin="6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- Tab 6 (Phase 25.5): Classroom light theme tokens + icon showcase. -->
        <TabItem Header="Classroom">
            <views:ClassroomShowcaseView/>
        </TabItem>
    </TabControl>
</Window>
