<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

    <UserControl.Styles>
        <!-- Status pill: grey default (disconnected), amber connecting, green connected. -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource Border.Default}"/>
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Border.pill.connecting">
            <Setter Property="Background" Value="#FDE68A"/>
        </Style>
        <Style Selector="Border.pill.connecting > TextBlock">
            <Setter Property="Foreground" Value="#92400E"/>
        </Style>
        <Style Selector="Border.pill.connected">
            <Setter Property="Background" Value="#D1FAE5"/>
        </Style>
        <Style Selector="Border.pill.connected > TextBlock">
            <Setter Property="Foreground" Value="#065F46"/>
        </Style>
    </UserControl.Styles>

    <!-- Phase 26.0-A — Connection panel: connect the Mac Sandbox to a real (or
         mock) Teacher over the wire protocol. Reuses ClassroomLightTheme + the
         design system (Button.*) + ThemeVariantScope=Light. Top card = connection
         form + status pill; below = live wire-traffic log (enriched in 26.0-C). -->

    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Background="{StaticResource Surface.Background}">
            <Grid RowDefinitions="Auto,Auto,*" Width="720">

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16"
                        Background="{StaticResource Surface.Elevated}"
                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36"
                                Background="{StaticResource Accent.PrimarySubtle}"
                                CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🔌" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Status pill (right) -->
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                Classes="pill"
                                Classes.connected="{Binding IsFullyConnected}"
                                Classes.connecting="{Binding IsConnectingState}">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="Wire Connection"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Connect to a Teacher over the T1–T26 wire protocol."
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Connection form -->
                <Border Grid.Row="1" Margin="20,16,20,8"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" >
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Teacher IP address" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TeacherIp}" FontSize="14" Padding="10,8"
                                         IsEnabled="{Binding IsDisconnected}" Watermark="172.20.10.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="90">
                                <TextBlock Text="Port" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PortText}" FontSize="14" Padding="10,8"
                                         IsEnabled="{Binding IsDisconnected}" Watermark="7777"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Display name (shown on the Teacher tile)"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource Text.Primary}" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding DisplayName}" FontSize="14" Padding="10,8"
                                 IsEnabled="{Binding IsDisconnected}"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource Accent.Danger}" FontSize="12"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Theme="{StaticResource Button.Ghost}" Content="Disconnect"
                                    Command="{Binding DisconnectCommand}" Margin="0,0,8,0"/>
                            <Button Theme="{StaticResource Button.Primary}" Content="Connect"
                                    Command="{Binding ConnectCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Wire-traffic log -->
                <Border Grid.Row="2" Margin="20,8,20,16"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="12,8"
                                Background="{StaticResource Surface.Elevated}"
                                BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Theme="{StaticResource Button.Ghost}"
                                        Content="Clear" Command="{Binding ClearLogCommand}"
                                        Padding="10,4" MinHeight="0"/>
                                <TextBlock Text="Wire traffic" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Log}" FontFamily="Menlo, Consolas, monospace">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="12,3"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:WireLogRow">
                                    <Grid ColumnDefinitions="96,20,150,70,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontSize="12"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="12"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>
