<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.AudioCaptureView"
             x:DataType="vm:AudioCaptureViewModel">

    <!-- Phase 29-D — Microphone permission + live RMS level meter (AVAudioEngine via
         the native libNtyCapture.dylib). NO loopback playback (avoids acoustic
         feedback); the meter is the proof that capture works. -->

    <UserControl.Styles>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource Border.Default}"/>
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Border.pill.granted"><Setter Property="Background" Value="#D1FAE5"/></Style>
        <Style Selector="Border.pill.granted > TextBlock"><Setter Property="Foreground" Value="#065F46"/></Style>
        <Style Selector="Border.pill.denied"><Setter Property="Background" Value="#FEE2E2"/></Style>
        <Style Selector="Border.pill.denied > TextBlock"><Setter Property="Foreground" Value="#991B1B"/></Style>
    </UserControl.Styles>

    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Background="{StaticResource Surface.Background}">
            <Grid RowDefinitions="Auto,*" Width="720">

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16"
                        Background="{StaticResource Surface.Elevated}"
                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36"
                                Background="{StaticResource Accent.PrimarySubtle}"
                                CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🎙" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                Classes="pill"
                                Classes.granted="{Binding IsGranted}"
                                Classes.denied="{Binding !IsGranted}">
                            <TextBlock Text="{Binding PermissionStatus}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="Audio (Microphone)"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="AVAudioEngine via the native helper — Phase 29-D."
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Body: controls + level meter -->
                <StackPanel Grid.Row="1" Margin="24,20">
                    <Border Background="{StaticResource Surface.Card}"
                            BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding Hint}" FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>

                            <!-- stats + buttons -->
                            <DockPanel Margin="0,14,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="level" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding RmsLevel}" FontSize="15" FontWeight="Bold" Margin="4,0,16,0"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                    <TextBlock Text="fmt" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding FormatText}" FontSize="15" FontWeight="SemiBold" Margin="4,0,16,0"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="frames" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding FramesCounter}" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,0"
                                               Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Theme="{StaticResource Button.Secondary}" Content="Check"
                                            Command="{Binding CheckPermissionCommand}" Margin="0,0,8,0"/>
                                    <Button Theme="{StaticResource Button.Secondary}" Content="Request permission"
                                            Command="{Binding RequestPermissionCommand}" Margin="0,0,8,0"
                                            IsVisible="{Binding !IsGranted}"/>
                                    <Button Theme="{StaticResource Button.Primary}" Content="Start capture"
                                            Command="{Binding StartCaptureCommand}" Margin="0,0,8,0"/>
                                    <Button Theme="{StaticResource Button.Danger}" Content="Stop"
                                            Command="{Binding StopCaptureCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live level meter -->
                    <Border Margin="0,16,0,0" Padding="20"
                            Background="#0B1220"
                            BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Microphone level (RMS)" FontSize="12" Foreground="#93C5FD"/>
                            <ProgressBar Margin="0,12,0,0" Height="22"
                                         Minimum="0" Maximum="100" Value="{Binding RmsLevel}"
                                         Foreground="#22C55E" Background="#1F2937"
                                         CornerRadius="6"/>
                            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Text="Speak into the mic — the bar should rise on speech and sit near 0 in silence. No loopback playback (avoids feedback)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>
