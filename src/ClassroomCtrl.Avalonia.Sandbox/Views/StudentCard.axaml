<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
             xmlns:conv="using:ClassroomCtrl.Avalonia.Sandbox.Converters"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.StudentCard"
             x:DataType="vm:StudentCardDemoViewModel"
             Width="220">

    <!-- PORTED from Teacher/Controls/StudentCard.xaml (Phase 25.4-A).
         Classroom Material theme keys mapped to Conference dark-theme keys
         (Surface.Card→ConfTileBgBrush etc.) since the Classroom theme isn't ported.
         Dynamic badge colors via HexToBrushConverter. WPF *Visibility members →
         bool + IsVisible. ContextMenu added in 25.4-B. -->

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Base values in a style so the .selected class can override (§6 rule). -->
        <Style Selector="Border#CardRoot">
            <Setter Property="Background" Value="{StaticResource ConfTileBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ConfBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border#CardRoot.selected">
            <Setter Property="BorderBrush" Value="#4285F4"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="CardRoot" CornerRadius="12" ClipToBounds="True" Cursor="Hand"
            Classes.selected="{Binding IsSelected}"
            PointerPressed="Card_Pressed">
        <!-- WPF ContextMenu → Avalonia ContextMenu (opens on right-click automatically).
             The WPF version stashed the Window DataContext on Border.Tag and walked
             PlacementTarget.Tag.XCommand; here every item routes to the host VM via
             $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).XCommand
             — the popup-scope routing verified in 25.4-C. CommandParameter={Binding}
             is the card's item (the ContextMenu inherits the target's DataContext). -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="View screen"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).ViewStudentScreenCommand}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="Lock screen"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).LockOneCommand}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="Unlock screen"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).UnlockOneCommand}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="Apply policy"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).ApplyPolicyToStudentCommand}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="Revert policy"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).RevertPolicyForStudentCommand}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="Chat"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).OpenDMConversationCommand}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="Set as host"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).SetAsHostCommand}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="Remove host"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).RemoveHostCommand}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="Start demo"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).StartDemoCommand}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="Stop demo"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).StopDemoCommand}"/>
                <Separator/>
                <!-- Static nested submenu (Phase 25.4 scope: 2 hardcoded rooms;
                     dynamic ItemsSource=Rooms deferred). Proves MenuFlyout nesting. -->
                <MenuItem Header="Assign to room">
                    <MenuItem Header="Group A"
                              Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).AssignToRoomACommand}"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="Group B"
                              Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).AssignToRoomBCommand}"
                              CommandParameter="{Binding}"/>
                </MenuItem>
                <MenuItem Header="Remove from room"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).RemoveFromRoomCommand}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="Logoff"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).LogoffOneCommand}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="Restart"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).RestartOneCommand}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="Shutdown"
                          Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).ShutdownOneCommand}"
                          CommandParameter="{Binding}"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid RowDefinitions="*,Auto">
            <!-- Screen preview area (dark plate; thumbnail omitted in the demo). -->
            <Border Grid.Row="0" Background="#0D1224" CornerRadius="11,11,0,0"
                    ClipToBounds="True" MinHeight="124">
                <Grid>
                    <!-- Top-left: room + policy badges + quality dot. -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                        <Border IsVisible="{Binding RoomBadgeVisible}"
                                Background="{Binding RoomBadgeColorHex, Converter={StaticResource HexToBrush}}"
                                CornerRadius="3" Padding="6,2" Margin="0,0,0,2">
                            <TextBlock Text="{Binding RoomName}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <Border IsVisible="{Binding PolicyBadgeVisible}"
                                Background="#7C3AED" CornerRadius="3" Padding="6,2" Margin="0,0,0,2">
                            <TextBlock Text="POLICY" Foreground="White" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,2,0,0"
                                Background="{Binding QualityDotColorHex, Converter={StaticResource HexToBrush}}"/>
                    </StackPanel>

                    <!-- Top-center: hand-raised banner. -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                            Padding="8,2" Background="#F59E0B" CornerRadius="3"
                            IsVisible="{Binding HandRaised}">
                        <TextBlock Text="HAND" Foreground="White" FontWeight="Bold" FontSize="10"/>
                    </Border>

                    <!-- Top-right: host + talking + selection check. -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Orientation="Horizontal">
                        <Border Background="#F59E0B" CornerRadius="3" Padding="6,2" Margin="2,0,0,0"
                                IsVisible="{Binding HostBadge}">
                            <TextBlock Text="👑 HOST" Foreground="White" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <Border Background="#10B981" CornerRadius="3" Padding="4,2" Margin="2,0,0,0"
                                IsVisible="{Binding Talking}">
                            <TextBlock Text="🎤" Foreground="White" FontSize="11"/>
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" Background="#4285F4" Margin="2,0,0,0"
                                IsVisible="{Binding IsSelected}">
                            <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Bottom-right: REC button (host-routed via $parent[ItemsControl]). -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                            Width="48" Height="22" FontSize="9" FontWeight="Bold" Padding="0"
                            Foreground="White" BorderBrush="White" BorderThickness="1" Cursor="Hand"
                            Content="{Binding RecButtonText}"
                            Background="{Binding RecButtonColorHex, Converter={StaticResource HexToBrush}}"
                            Opacity="{Binding RecOpacity}"
                            IsEnabled="{Binding CanRecord}"
                            Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).ToggleStudentRecordingCommand}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>

            <!-- Info bar: name/machine + 👁 view button (host-routed). -->
            <Border Grid.Row="1" Background="{StaticResource ConfTileBgBrush}" Padding="10,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource ConfTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MachineName}" FontSize="11"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="28" Height="28" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding $parent[ItemsControl].((vm:StudentGridDemoViewModel)DataContext).ViewStudentScreenCommand}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="👁" FontSize="14"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
