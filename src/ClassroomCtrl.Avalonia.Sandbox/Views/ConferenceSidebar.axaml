<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
             xmlns:models="using:ClassroomCtrl.Shared.Models"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.ConferenceSidebar"
             x:DataType="vm:ConferenceSidebarDemoViewModel"
             Background="{StaticResource ConfSidebarBgBrush}"
             Foreground="{StaticResource ConfTextPrimaryBrush}"
             FontFamily="{StaticResource ConfFontFamily}">

    <!-- PORTED from Shared.Wpf/Conference/ConferenceSidebar.xaml (Phase 25.3-A).
         The shipped sidebar hand-rolls its tabs (buttons + Visibility-gated bodies),
         NOT a WPF TabControl — this port preserves that (see FINDINGS). Tabs use the
         SidebarTabPill ControlTheme; active state is the .active class below. -->

    <UserControl.Styles>
        <!-- Active tab: blue underline accent + blue text (WPF per-tab DataTrigger). -->
        <Style Selector="Button.tab.active">
            <Setter Property="BorderBrush" Value="{StaticResource ConfAccentBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ConfAccentBlueBrush}"/>
        </Style>
        <!-- Row status icons (mic/cam): secondary when off, primary when live. -->
        <Style Selector="TextBlock.rowIcon">
            <Setter Property="Foreground" Value="{StaticResource ConfTextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.rowIcon.on">
            <Setter Property="Foreground" Value="{StaticResource ConfTextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{StaticResource ConfBorderSubtleBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">

            <!-- Header: tabs (left) + close ✕ (right). -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                    BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="CloseButton_Click" ToolTip.Tip="Close">
                        <TextBlock Text="✕" FontSize="14"
                                   Foreground="{StaticResource ConfTextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="tab" Theme="{StaticResource SidebarTabPill}"
                                Content="Chat"
                                Command="{Binding SelectConferenceChatTabCommand}"
                                Classes.active="{Binding IsConferenceChatTabSelected}"/>
                        <Button Classes="tab" Theme="{StaticResource SidebarTabPill}"
                                Content="Participants"
                                Command="{Binding SelectConferenceParticipantsTabCommand}"
                                Classes.active="{Binding IsConferenceParticipantsTabSelected}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tab body. -->
            <Grid Grid.Row="1">

                <!-- ══ Chat tab ══ -->
                <DockPanel IsVisible="{Binding IsConferenceChatTabSelected}">
                    <!-- Input row (docked bottom). Attach 📎 inert (picker deferred);
                         TextBox two-way to DraftInput; Send → SendConferenceChatCommand. -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                            BorderThickness="0,1,0,0" Padding="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0" Width="36" Height="36" Padding="0"
                                    HorizontalAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{StaticResource ConfTextSecondaryBrush}"
                                    ToolTip.Tip="Attach file (deferred)">
                                <TextBlock Text="📎" FontSize="16"/>
                            </Button>
                            <TextBox Grid.Column="0" Margin="40,0,0,0" Padding="8,6"
                                     Background="{StaticResource ConfChatInputBgBrush}"
                                     Foreground="{StaticResource ConfTextPrimaryBrush}"
                                     CaretBrush="{StaticResource ConfTextPrimaryBrush}"
                                     BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                     BorderThickness="1"
                                     PlaceholderText="Message…"
                                     Text="{Binding ConferenceConversation.DraftInput}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Width="40" Height="40" Padding="0"
                                    Background="{StaticResource ConfAccentBlueBrush}"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding SendConferenceChatCommand}"
                                    ToolTip.Tip="Send">
                                <TextBlock Text="➤" FontSize="14" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Draft attachment preview strip (hidden in the demo — no draft). -->
                    <Border DockPanel.Dock="Bottom" Margin="10,0" Padding="8,6"
                            Background="{StaticResource ConfChatInputBgBrush}"
                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            IsVisible="{Binding HasConferenceDraftAttachment}">
                        <TextBlock Text="📎 (draft attachment)" FontSize="12"
                                   Foreground="{StaticResource ConfTextPrimaryBrush}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ConferenceConversation.Messages}" Margin="10,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessage">
                                    <!-- Dark bubble. v1.2 carry-over: no IsOwn on the model yet,
                                         so every bubble uses ConfChatOtherBubbleBrush (faithful). -->
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                                            Background="{StaticResource ConfChatOtherBubbleBrush}"
                                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ConfTextSecondaryBrush}"/>

                                            <!-- Attachment card (Phase 25.3: rendered; buttons inert — picker deferred). -->
                                            <Border Margin="0,4" Padding="8,6" CornerRadius="6"
                                                    Background="{StaticResource ConfChatOwnBubbleBrush}"
                                                    BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding HasAttachment}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Content="Download" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                                                Background="Transparent"
                                                                Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                                BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                                                BorderThickness="1" Cursor="Hand"/>
                                                        <Button Content="Open" FontSize="11" Padding="6,2"
                                                                Background="{StaticResource ConfAccentBlueBrush}"
                                                                Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AttachmentIcon}" FontSize="18"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AttachmentFileName}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                            <TextBlock Text="{Binding AttachmentSizeFormatted}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource ConfTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <TextBlock Text="{Binding MessageText}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ══ Participants tab ══ -->
                <Grid IsVisible="{Binding IsConferenceParticipantsTabSelected}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Margin="8">

                        <!-- Raised-hands section (collapsed when none). WPF used a
                             DataTrigger on RaisedHandQueue.Count==0 → HasRaisedHands bool. -->
                        <StackPanel IsVisible="{Binding ConferenceGallery.HasRaisedHands}" Margin="0,0,0,4">
                            <TextBlock Text="Raised hands" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource ConfTextSecondaryBrush}"
                                       Margin="2,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ConferenceGallery.RaisedHandQueue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParticipantDemo">
                                        <Border Background="{StaticResource ConfAccentYellowBrush}"
                                                CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                            <DockPanel>
                                                <!-- Recognize: role-gated via $parent[UserControl]
                                                     (= WPF RelativeSource AncestorType=UserControl). -->
                                                <Button DockPanel.Dock="Right" Content="Recognize"
                                                        FontSize="11" FontWeight="SemiBold"
                                                        Background="#1F1F23" Foreground="White"
                                                        BorderThickness="0" Padding="10,4" Cursor="Hand"
                                                        IsVisible="{Binding $parent[UserControl].((vm:ConferenceSidebarDemoViewModel)DataContext).Role.CanRecognizeHand}"
                                                        Command="{Binding $parent[UserControl].((vm:ConferenceSidebarDemoViewModel)DataContext).RecognizeHandCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✋" FontSize="14" Margin="0,0,8,0" Foreground="#1F1F23"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#1F1F23" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{StaticResource ConfBorderSubtleBrush}" Margin="0,4,0,8"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Students}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ParticipantDemo">
                                    <Border Background="{StaticResource ConfTileBgBrush}"
                                            BorderBrush="{StaticResource ConfBorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <!-- Avatar chip. -->
                                            <Border DockPanel.Dock="Left" Width="36" Height="36"
                                                    CornerRadius="999"
                                                    Background="{StaticResource ConfHostBadgeBgBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="👤" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Right: state indicators. -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Padding="6,2" CornerRadius="999" Margin="0,0,4,0"
                                                        Background="{StaticResource ConfAccentYellowBrush}"
                                                        IsVisible="{Binding HandRaised}">
                                                    <TextBlock Text="✋" FontSize="11" Foreground="#1F1F23"/>
                                                </Border>
                                                <TextBlock Text="🎙" Classes="rowIcon" Classes.on="{Binding MicLive}"
                                                           FontSize="14" Margin="4,0"/>
                                                <TextBlock Text="📷" Classes="rowIcon" Classes.on="{Binding CamLive}"
                                                           FontSize="14" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <!-- Host-only Mute button. Role-gated via $parent[UserControl]
                                                 (= WPF RelativeSource AncestorType=UserControl). -->
                                            <Button DockPanel.Dock="Right" Content="Mute"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Background="{StaticResource ConfAccentRedBrush}"
                                                    Foreground="White" BorderThickness="0"
                                                    Padding="8,3" Margin="6,0,0,0" Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ConferenceSidebarDemoViewModel)DataContext).Role.CanMuteOthers}"
                                                    Command="{Binding $parent[UserControl].((vm:ConferenceSidebarDemoViewModel)DataContext).MuteParticipantCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <!-- Name + machine. -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ConfTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MachineName}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource ConfTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
