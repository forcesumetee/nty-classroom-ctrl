<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.ClassRosterManagerView"
             x:DataType="vm:RosterManagerDemoViewModel">

    <!-- PORTED from Teacher/ClassRosterManagerWindow.xaml (Phase 25.7-A).
         Header/body/footer dialog on ClassroomLightTheme + the design system
         (Button.* ControlThemes). The one new pattern is the LIST: the shipped
         window used ListView + GridView + GridViewColumn (DisplayMemberBinding);
         Avalonia has none of those, so this uses a ListBox + a Grid ItemTemplate,
         with a header row whose ColumnDefinitions MATCH the item Grid so the
         columns line up (see cheat sheet §17). Display-only 4-column roster →
         a templated ListBox is the honest match; DataGrid is reserved for when a
         list needs built-in sort/inline-edit. Wrapped in ThemeVariantScope=Light
         so Fluent's variant-aware controls render on the light surface. -->

    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Background="{StaticResource Surface.Background}">
            <Grid RowDefinitions="Auto,*,Auto" Width="820">

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16"
                        Background="{StaticResource Surface.Elevated}"
                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36"
                                Background="{StaticResource Accent.PrimarySubtle}"
                                CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="📋" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="Class Roster Manager"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Open, activate, or manage your saved class rosters."
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Body: Surface.Card holding the header row + the ListBox -->
                <Border Grid.Row="1" Margin="20,16"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">

                        <!-- Column header row — ColumnDefinitions MATCH the ItemTemplate below. -->
                        <Border Grid.Row="0" Padding="12,8"
                                Background="{StaticResource Surface.Elevated}"
                                BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="160,*,90,150">
                                <TextBlock Grid.Column="0" Text="Class"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Grid.Column="1" Text="Description"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Grid.Column="2" Text="Students"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Grid.Column="3" Text="Last used"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Padding="0" ItemsSource="{Binding Rooms}"
                                 SelectedItem="{Binding SelectedRoom}">
                            <ListBox.Styles>
                                <!-- Full-width rows so the * column aligns with the header. -->
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClassRoomRowDemoViewModel">
                                    <Grid ColumnDefinitions="160,*,90,150">
                                        <TextBlock Grid.Column="0" Text="{Binding ClassName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   FontSize="13" Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StudentCount}"
                                                   FontSize="13" Foreground="{StaticResource Text.Primary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LastUsedAt}"
                                                   FontSize="12" Foreground="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Footer: Danger + I/O on the left, proceed actions on the right. -->
                <Border Grid.Row="2" Padding="20,12"
                        Background="{StaticResource Surface.Elevated}"
                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Theme="{StaticResource Button.Danger}"
                                Content="Delete" Command="{Binding DeleteCommand}"/>
                        <Button DockPanel.Dock="Left" Theme="{StaticResource Button.Secondary}"
                                Content="Import" Command="{Binding ImportCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Left" Theme="{StaticResource Button.Secondary}"
                                Content="Export" Command="{Binding ExportCommand}" Margin="8,0,0,0"/>

                        <Button DockPanel.Dock="Right" Theme="{StaticResource Button.Primary}"
                                Content="Activate" Command="{Binding ActivateCommand}"/>
                        <Button DockPanel.Dock="Right" Theme="{StaticResource Button.Secondary}"
                                Content="Open" Command="{Binding OpenCommand}" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Theme="{StaticResource Button.Secondary}"
                                Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>
