<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
             xmlns:svc="using:ClassroomCtrl.Avalonia.Sandbox.Services"
             x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.CameraCaptureView"
             x:DataType="vm:CameraCaptureViewModel">

    <!-- Phase 28-C — Camera permission + device selection + live JPEG self-preview
         (AVCaptureSession via the native libNtyCapture.dylib). Mirrors the Screen
         Capture tab; camera frames are JPEG (decoded to a Bitmap for preview). -->

    <UserControl.Styles>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource Border.Default}"/>
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Border.pill.granted"><Setter Property="Background" Value="#D1FAE5"/></Style>
        <Style Selector="Border.pill.granted > TextBlock"><Setter Property="Foreground" Value="#065F46"/></Style>
        <Style Selector="Border.pill.denied"><Setter Property="Background" Value="#FEE2E2"/></Style>
        <Style Selector="Border.pill.denied > TextBlock"><Setter Property="Foreground" Value="#991B1B"/></Style>
    </UserControl.Styles>

    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Background="{StaticResource Surface.Background}">
            <Grid RowDefinitions="Auto,*" Width="720">

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16"
                        Background="{StaticResource Surface.Elevated}"
                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36"
                                Background="{StaticResource Accent.PrimarySubtle}"
                                CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="📷" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                Classes="pill"
                                Classes.granted="{Binding IsGranted}"
                                Classes.denied="{Binding !IsGranted}">
                            <TextBlock Text="{Binding PermissionStatus}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="Camera"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="AVCaptureSession via the native helper — Phase 28-C."
                                       FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Body: controls + live preview -->
                <StackPanel Grid.Row="1" Margin="24,20">
                    <Border Background="{StaticResource Surface.Card}"
                            BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding Hint}" FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>

                            <!-- Device selection row -->
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Device" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{StaticResource Text.Muted}"/>
                                <Button DockPanel.Dock="Right" Theme="{StaticResource Button.Secondary}"
                                        Content="Refresh" Command="{Binding RefreshDevicesCommand}"
                                        Margin="8,0,0,0"/>
                                <ComboBox ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="svc:CameraDevice">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>

                            <!-- stats + buttons -->
                            <DockPanel Margin="0,14,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="fps" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding FpsText}" FontSize="15" FontWeight="Bold" Margin="4,0,16,0"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                    <TextBlock Text="res" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding ResolutionText}" FontSize="15" FontWeight="SemiBold" Margin="4,0,16,0"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="frames" FontSize="11" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding FramesText}" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,0"
                                               Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Theme="{StaticResource Button.Secondary}" Content="Check"
                                            Command="{Binding CheckPermissionCommand}" Margin="0,0,8,0"/>
                                    <Button Theme="{StaticResource Button.Secondary}" Content="Request permission"
                                            Command="{Binding RequestPermissionCommand}" Margin="0,0,8,0"
                                            IsVisible="{Binding !IsGranted}"/>
                                    <Button Theme="{StaticResource Button.Primary}" Content="Start capture"
                                            Command="{Binding StartCaptureCommand}" Margin="0,0,8,0"/>
                                    <Button Theme="{StaticResource Button.Danger}" Content="Stop"
                                            Command="{Binding StopCaptureCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live preview -->
                    <Border Margin="0,16,0,0" Height="380"
                            Background="#0B1220"
                            BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="Press Start capture to preview the camera."
                                       FontSize="12" Foreground="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Frame, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding Frame}" Stretch="Uniform" Margin="8"/>
                        </Panel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>
