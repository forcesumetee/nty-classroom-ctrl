<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassroomCtrl.Avalonia.Sandbox.ViewModels"
        x:Class="ClassroomCtrl.Avalonia.Sandbox.Views.PermissionsWindow"
        x:DataType="vm:PermissionsViewModel"
        Title="Permissions — NTY ClassroomCtrl"
        Width="580" Height="560" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Text="Permissions" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ReadyText}" TextWrapping="Wrap" Opacity="0.8"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="12" Margin="0,16,0,0">
      <Button Content="Recheck All" Command="{Binding RecheckAllCommand}"/>
      <Button Content="Continue" Click="OnContinue"/>
    </StackPanel>

    <ScrollViewer Margin="0,16,0,0">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PermissionRowViewModel">
            <Border BorderBrush="#33888888" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                  <Border Background="#22888888" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TierLabel}" FontSize="11" Opacity="0.85"/>
                  </Border>
                </StackPanel>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding Purpose}" TextWrapping="Wrap"
                           Opacity="0.7" Margin="0,4,12,0"/>

                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" FontSize="14"/>
                  <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" MinWidth="96"/>
                  <Button Content="Grant" Command="{Binding GrantCommand}"/>
                  <Button Content="Recheck" Command="{Binding RecheckCommand}"/>
                </StackPanel>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Text="{Binding Hint}"
                           TextWrapping="Wrap" Foreground="#E0A030" FontSize="12" Margin="0,8,0,0"
                           IsVisible="{Binding HasHint}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
